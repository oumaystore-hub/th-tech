---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "TypeScript Playground - تشغيل TypeScript أونلاين | Th.Tech";

const description =
  "TypeScript Playground مجاني لتجربة وتشغيل أكواد TypeScript مباشرة من المتصفح مع Console لعرض النتائج والأخطاء.";

const canonical =
  `https://oumaystore-hub.github.io/Th-tech/tools/typescript-playground/`;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>

    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
  </head>

  <body>
    <Header />

    <main class="playground-page">

      <!-- HERO -->
      <section class="hero">
        <div class="hero-orb orb-one"></div>
        <div class="hero-orb orb-two"></div>

        <div class="hero-inner">

          <div class="tool-icon">
            <span>TS</span>
            <i class="fa-solid fa-terminal"></i>
          </div>

          <div class="badge">
            <i class="fa-solid fa-bolt"></i>
            TypeScript Playground
          </div>

          <h1>
            TypeScript
            <span>Playground</span>
          </h1>

          <p>
            اكتب وجرب وشغّل أكواد TypeScript مباشرة من المتصفح
            مع Console احترافي لعرض النتائج والأخطاء.
          </p>

          <div class="hero-features">
            <span>
              <i class="fa-solid fa-play"></i>
              تشغيل مباشر
            </span>

            <span>
              <i class="fa-solid fa-terminal"></i>
              Console
            </span>

            <span>
              <i class="fa-solid fa-shield-halved"></i>
              آمن
            </span>

            <span>
              <i class="fa-solid fa-mobile-screen"></i>
              متجاوب
            </span>
          </div>

        </div>
      </section>


      <!-- TOOL -->
      <section class="tool-section">

        <div class="tool-container">

          <!-- TOOL HEADER -->
          <div class="workspace-header">

            <div class="workspace-title">

              <div class="workspace-logo">
                <span>TS</span>
              </div>

              <div>
                <h2>TypeScript Playground</h2>
                <p>بيئة تجريبية لتشغيل TypeScript</p>
              </div>

            </div>

            <div class="workspace-status" id="runtimeStatus">
              <span class="status-dot"></span>
              جاهز
            </div>

          </div>


          <!-- ACTION BAR -->
          <div class="action-bar">

            <button class="run-btn" id="runBtn">
              <i class="fa-solid fa-play"></i>
              تشغيل الكود
            </button>

            <button class="secondary-btn" id="copyBtn">
              <i class="fa-regular fa-copy"></i>
              نسخ
            </button>

            <button class="secondary-btn" id="formatBtn">
              <i class="fa-solid fa-wand-magic-sparkles"></i>
              تنسيق
            </button>

            <button class="danger-btn" id="clearBtn">
              <i class="fa-solid fa-trash"></i>
              مسح
            </button>

          </div>


          <!-- EDITOR GRID -->
          <div class="editor-grid">

            <!-- CODE EDITOR -->
            <div class="editor-card">

              <div class="panel-header">

                <div class="panel-left">

                  <div class="panel-icon ts-icon">
                    TS
                  </div>

                  <div>
                    <strong>TypeScript</strong>
                    <small>source.ts</small>
                  </div>

                </div>

                <div class="panel-tools">
                  <span id="lineCount">1 سطر</span>
                </div>

              </div>


              <div class="editor-wrapper">

                <div class="line-numbers" id="lineNumbers">1</div>

                <textarea
                  id="codeEditor"
                  spellcheck="false"
                  autocomplete="off"
                  autocorrect="off"
                  autocapitalize="off"
                >interface User {
  name: string;
  age: number;
}

const user: User = {
  name: "Th.Tech",
  age: 5
};

console.log("مرحباً بك في " + user.name);
console.log("العمر:", user.age);

const numbers: number[] = [10, 20, 30, 40, 50];

const total: number = numbers.reduce(
  (sum: number, number: number) => sum + number,
  0
);

console.log("المجموع:", total);</textarea>

              </div>


              <div class="editor-footer">

                <span>
                  <i class="fa-solid fa-code"></i>
                  TypeScript
                </span>

                <span id="charCount">
                  0 حرف
                </span>

              </div>

            </div>


            <!-- CONSOLE -->
            <div class="console-card">

              <div class="panel-header console-header">

                <div class="panel-left">

                  <div class="panel-icon terminal-icon">
                    <i class="fa-solid fa-terminal"></i>
                  </div>

                  <div>
                    <strong>Console</strong>
                    <small>output</small>
                  </div>

                </div>

                <button id="clearConsole" class="console-clear">
                  <i class="fa-solid fa-broom"></i>
                  مسح
                </button>

              </div>


              <div class="console-output" id="consoleOutput">

                <div class="console-welcome">
                  <div class="welcome-icon">
                    <i class="fa-solid fa-terminal"></i>
                  </div>

                  <h3>Console جاهز</h3>

                  <p>
                    اضغط على «تشغيل الكود» لرؤية النتائج هنا.
                  </p>
                </div>

              </div>

              <div class="console-footer">

                <span id="executionStatus">
                  <i class="fa-solid fa-circle"></i>
                  لم يتم التنفيذ
                </span>

                <span id="executionTime">
                  0 ms
                </span>

              </div>

            </div>

          </div>


          <!-- STATS -->
          <div class="stats-grid">

            <div class="stat-card">
              <div class="stat-icon">
                <i class="fa-solid fa-file-code"></i>
              </div>

              <div>
                <span>الأسطر</span>
                <strong id="statLines">1</strong>
              </div>
            </div>


            <div class="stat-card">
              <div class="stat-icon">
                <i class="fa-solid fa-font"></i>
              </div>

              <div>
                <span>الأحرف</span>
                <strong id="statChars">0</strong>
              </div>
            </div>


            <div class="stat-card">
              <div class="stat-icon">
                <i class="fa-solid fa-code"></i>
              </div>

              <div>
                <span>الكلمات</span>
                <strong id="statWords">0</strong>
              </div>
            </div>


            <div class="stat-card">
              <div class="stat-icon">
                <i class="fa-solid fa-clock"></i>
              </div>

              <div>
                <span>وقت التنفيذ</span>
                <strong id="statTime">0 ms</strong>
              </div>
            </div>

          </div>

        </div>

      </section>


      <!-- INFO -->
      <section class="content-section">

        <div class="content-container">

          <div class="info-card">

            <div class="info-icon">
              <i class="fa-brands fa-js"></i>
            </div>

            <div>

              <h2>ما هو TypeScript Playground؟</h2>

              <p>
                TypeScript Playground هو محرر تفاعلي يسمح لك بكتابة
                وتجربة أكواد TypeScript بسرعة من المتصفح دون الحاجة
                إلى تثبيت بيئة تطوير كاملة على جهازك.
              </p>

              <p>
                يمكنك استخدامه لتجربة الأنواع Interfaces وGenerics
                والدوال والمصفوفات وغيرها من ميزات TypeScript.
              </p>

            </div>

          </div>


          <!-- FEATURES -->
          <div class="section-heading">
            <span class="heading-icon">
              <i class="fa-solid fa-star"></i>
            </span>

            <div>
              <h2>مميزات الأداة</h2>
              <p>كل ما تحتاجه لتجربة TypeScript بسرعة</p>
            </div>
          </div>


          <div class="features-grid">

            <article class="feature-card">
              <div class="feature-icon">
                <i class="fa-solid fa-play"></i>
              </div>

              <h3>تشغيل مباشر</h3>

              <p>
                شغّل الكود مباشرة من المتصفح واحصل على النتائج فوراً.
              </p>
            </article>


            <article class="feature-card">
              <div class="feature-icon">
                <i class="fa-solid fa-terminal"></i>
              </div>

              <h3>Console احترافي</h3>

              <p>
                شاهد المخرجات والأخطاء ورسائل التنفيذ داخل Console مخصص.
              </p>
            </article>


            <article class="feature-card">
              <div class="feature-icon">
                <i class="fa-solid fa-wand-magic-sparkles"></i>
              </div>

              <h3>تنسيق الكود</h3>

              <p>
                استخدم أداة التنسيق للحصول على كود أكثر وضوحاً وتنظيماً.
              </p>
            </article>


            <article class="feature-card">
              <div class="feature-icon">
                <i class="fa-solid fa-lock"></i>
              </div>

              <h3>معالجة محلية</h3>

              <p>
                تتم معالجة الكود داخل المتصفح دون الحاجة إلى رفع ملفاتك.
              </p>
            </article>

          </div>


          <!-- HOW TO -->
          <div class="section-heading">

            <span class="heading-icon">
              <i class="fa-solid fa-list-check"></i>
            </span>

            <div>
              <h2>طريقة الاستخدام</h2>
              <p>ابدأ خلال ثوانٍ</p>
            </div>

          </div>


          <div class="steps">

            <div class="step">
              <div class="step-number">1</div>

              <div>
                <h3>اكتب الكود</h3>
                <p>
                  أدخل كود TypeScript داخل المحرر.
                </p>
              </div>
            </div>


            <div class="step">
              <div class="step-number">2</div>

              <div>
                <h3>اضغط تشغيل</h3>
                <p>
                  اضغط على زر تشغيل الكود لبدء التنفيذ.
                </p>
              </div>
            </div>


            <div class="step">
              <div class="step-number">3</div>

              <div>
                <h3>شاهد النتائج</h3>
                <p>
                  ستظهر نتائج console والأخطاء في القسم المقابل.
                </p>
              </div>
            </div>

          </div>


          <!-- FAQ -->
          <div class="section-heading">

            <span class="heading-icon">
              <i class="fa-solid fa-circle-question"></i>
            </span>

            <div>
              <h2>الأسئلة الشائعة</h2>
              <p>أهم الأسئلة حول الأداة</p>
            </div>

          </div>


          <div class="faq">

            <details>
              <summary>
                هل TypeScript Playground مجاني؟
                <i class="fa-solid fa-chevron-down"></i>
              </summary>

              <p>
                نعم، يمكنك استخدام الأداة مجاناً من المتصفح.
              </p>
            </details>


            <details>
              <summary>
                هل أحتاج إلى تثبيت TypeScript؟
                <i class="fa-solid fa-chevron-down"></i>
              </summary>

              <p>
                لا. الأداة مصممة للعمل من المتصفح دون الحاجة
                إلى تثبيت TypeScript محلياً.
              </p>
            </details>


            <details>
              <summary>
                هل يمكنني تجربة Interfaces وTypes؟
                <i class="fa-solid fa-chevron-down"></i>
              </summary>

              <p>
                نعم، يمكنك كتابة وتجربة مختلف ميزات TypeScript
                داخل المحرر.
              </p>
            </details>


            <details>
              <summary>
                هل يتم إرسال الكود إلى الخادم؟
                <i class="fa-solid fa-chevron-down"></i>
              </summary>

              <p>
                التنفيذ يتم داخل المتصفح، ولا تحتاج إلى رفع ملفات
                TypeScript إلى خادم خارجي.
              </p>
            </details>

          </div>

        </div>

      </section>

    </main>

    <Footer />


    <style>
      :root {
        --ts-primary: #06b6d4;
        --ts-primary-dark: #0891b2;
        --ts-secondary: #14b8a6;
        --ts-soft: rgba(6, 182, 212, 0.1);

        --bg: #f5f8fc;
        --card: #ffffff;
        --text: #0f172a;
        --muted: #64748b;
        --border: #e2e8f0;

        --editor: #0b1120;
        --editor-two: #111827;
        --editor-text: #dbeafe;

        --console: #071019;
        --success: #22c55e;
        --danger: #ef4444;

        --shadow:
          0 20px 60px rgba(15, 23, 42, 0.08);
      }


      * {
        box-sizing: border-box;
      }


      body {
        margin: 0;
        font-family: "Cairo", sans-serif;
        background: var(--bg);
        color: var(--text);
      }


      button,
      textarea {
        font-family: inherit;
      }


      button {
        cursor: pointer;
      }


      .playground-page {
        overflow: hidden;
      }


      /* HERO */

      .hero {
        position: relative;
        padding: 80px 20px 90px;
        background:
          radial-gradient(
            circle at 20% 20%,
            rgba(6, 182, 212, 0.18),
            transparent 35%
          ),
          radial-gradient(
            circle at 80% 80%,
            rgba(20, 184, 166, 0.14),
            transparent 35%
          ),
          linear-gradient(
            135deg,
            #06131b,
            #0b1720 50%,
            #061820
          );
        color: white;
      }


      .hero-inner {
        position: relative;
        z-index: 2;
        max-width: 1000px;
        margin: auto;
        text-align: center;
      }


      .hero-orb {
        position: absolute;
        width: 260px;
        height: 260px;
        border-radius: 50%;
        filter: blur(80px);
        opacity: 0.18;
      }


      .orb-one {
        top: -100px;
        left: 10%;
        background: var(--ts-primary);
      }


      .orb-two {
        bottom: -120px;
        right: 10%;
        background: var(--ts-secondary);
      }


      .tool-icon {
        width: 86px;
        height: 86px;
        margin: 0 auto 25px;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 24px;
        background: linear-gradient(
          145deg,
          #06b6d4,
          #0f766e
        );
        box-shadow:
          0 15px 45px rgba(6, 182, 212, 0.35);
      }


      .tool-icon span {
        font-family: Arial, sans-serif;
        font-weight: 900;
        font-size: 31px;
        letter-spacing: -3px;
      }


      .tool-icon i {
        position: absolute;
        bottom: -8px;
        left: -8px;
        width: 31px;
        height: 31px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #0f172a;
        color: #67e8f9;
        font-size: 13px;
        border: 2px solid rgba(103, 232, 249, 0.3);
      }


      .badge {
        width: fit-content;
        margin: 0 auto 18px;
        padding: 7px 15px;
        border: 1px solid rgba(103, 232, 249, 0.25);
        border-radius: 999px;
        background: rgba(6, 182, 212, 0.08);
        color: #67e8f9;
        font-size: 13px;
        font-weight: 700;
      }


      .badge i {
        margin-left: 6px;
      }


      .hero h1 {
        margin: 0;
        font-size: clamp(35px, 6vw, 62px);
        line-height: 1.15;
        font-weight: 800;
        letter-spacing: -1px;
      }


      .hero h1 span {
        color: #67e8f9;
      }


      .hero p {
        max-width: 720px;
        margin: 22px auto 0;
        color: #a7b9c8;
        font-size: 16px;
        line-height: 2;
      }


      .hero-features {
        margin-top: 30px;
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 10px;
      }


      .hero-features span {
        padding: 8px 13px;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: #d7e5ed;
        font-size: 12px;
      }


      .hero-features i {
        color: #67e8f9;
        margin-left: 5px;
      }


      /* TOOL */

      .tool-section {
        margin-top: -40px;
        position: relative;
        z-index: 5;
        padding: 0 20px 70px;
      }


      .tool-container {
        max-width: 1250px;
        margin: auto;
      }


      .workspace-header {
        padding: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        background: var(--card);
        border: 1px solid var(--border);
        border-bottom: 0;
        border-radius: 20px 20px 0 0;
      }


      .workspace-title,
      .panel-left {
        display: flex;
        align-items: center;
        gap: 12px;
      }


      .workspace-logo {
        width: 46px;
        height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: var(--ts-soft);
        color: var(--ts-primary-dark);
        font-family: Arial, sans-serif;
        font-size: 18px;
        font-weight: 900;
      }


      .workspace-title h2 {
        margin: 0;
        font-size: 16px;
      }


      .workspace-title p {
        margin: 3px 0 0;
        color: var(--muted);
        font-size: 11px;
      }


      .workspace-status {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 6px 11px;
        border-radius: 999px;
        background: #f0fdf4;
        color: #15803d;
        font-size: 11px;
        font-weight: 700;
      }


      .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--success);
      }


      .action-bar {
        padding: 14px 18px;
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
        background: #f8fafc;
        border: 1px solid var(--border);
        border-bottom: 0;
      }


      .action-bar button {
        min-height: 40px;
        padding: 0 16px;
        border-radius: 10px;
        border: 1px solid var(--border);
        font-size: 12px;
        font-weight: 700;
        transition: 0.2s ease;
      }


      .run-btn {
        border-color: var(--ts-primary) !important;
        background: var(--ts-primary);
        color: white;
      }


      .run-btn:hover {
        background: var(--ts-primary-dark);
        transform: translateY(-1px);
      }


      .secondary-btn {
        background: white;
        color: #334155;
      }


      .secondary-btn:hover {
        border-color: var(--ts-primary);
        color: var(--ts-primary-dark);
      }


      .danger-btn {
        background: white;
        color: #dc2626;
      }


      .danger-btn:hover {
        border-color: #fecaca !important;
        background: #fff7f7;
      }


      .action-bar i {
        margin-left: 5px;
      }


      /* EDITORS */

      .editor-grid {
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        min-height: 580px;
      }


      .editor-card,
      .console-card {
        min-width: 0;
        overflow: hidden;
        border: 1px solid var(--border);
      }


      .editor-card {
        border-radius: 0 0 0 18px;
        background: var(--editor);
        border-color: #1e293b;
      }


      .console-card {
        border-radius: 0 0 18px 0;
        background: var(--console);
        border-color: #1e293b;
      }


      .panel-header {
        min-height: 62px;
        padding: 12px 15px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #1e293b;
        background: var(--editor-two);
        color: #e2e8f0;
      }


      .panel-left strong {
        display: block;
        font-size: 12px;
      }


      .panel-left small {
        display: block;
        margin-top: 2px;
        color: #64748b;
        font-size: 10px;
        direction: ltr;
        text-align: right;
      }


      .panel-icon {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
      }


      .ts-icon {
        background: #3178c6;
        color: white;
        font-family: Arial, sans-serif;
        font-weight: 900;
        font-size: 13px;
      }


      .terminal-icon {
        background: rgba(6, 182, 212, 0.12);
        color: #67e8f9;
      }


      .panel-tools {
        color: #64748b;
        font-size: 10px;
      }


      .editor-wrapper {
        position: relative;
        display: flex;
        height: 455px;
        direction: ltr;
        overflow: hidden;
      }


      .line-numbers {
        width: 48px;
        flex-shrink: 0;
        padding: 18px 9px;
        background: #080d18;
        border-right: 1px solid #1e293b;
        color: #475569;
        font-family: Consolas, Monaco, monospace;
        font-size: 13px;
        line-height: 1.8;
        text-align: right;
        overflow: hidden;
        user-select: none;
      }


      #codeEditor {
        flex: 1;
        width: 100%;
        height: 100%;
        resize: none;
        padding: 18px 18px;
        border: 0;
        outline: none;
        background: var(--editor);
        color: var(--editor-text);
        font-family: Consolas, Monaco, "Courier New", monospace;
        font-size: 13px;
        line-height: 1.8;
        tab-size: 2;
        direction: ltr;
