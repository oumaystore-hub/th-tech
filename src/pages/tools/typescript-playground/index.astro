          border-color: #253545;
        }

        .workspace-status {
          background: rgba(34, 197, 94, 0.08);
        }

      }

    </style>


    <script is:inline>
      (() => {

        const editor = document.getElementById("codeEditor");
        const lineNumbers = document.getElementById("lineNumbers");

        const runBtn = document.getElementById("runBtn");
        const copyBtn = document.getElementById("copyBtn");
        const formatBtn = document.getElementById("formatBtn");
        const clearBtn = document.getElementById("clearBtn");

        const clearConsole = document.getElementById("clearConsole");

        const consoleOutput =
          document.getElementById("consoleOutput");

        const runtimeStatus =
          document.getElementById("runtimeStatus");

        const executionStatus =
          document.getElementById("executionStatus");

        const executionTime =
          document.getElementById("executionTime");

        const lineCount =
          document.getElementById("lineCount");

        const charCount =
          document.getElementById("charCount");

        const statLines =
          document.getElementById("statLines");

        const statChars =
          document.getElementById("statChars");

        const statWords =
          document.getElementById("statWords");

        const statTime =
          document.getElementById("statTime");


        if (!editor) return;


        function updateStats() {

          const code = editor.value;

          const lines =
            code.length === 0
              ? 1
              : code.split("\n").length;

          const chars = code.length;

          const words =
            code.trim()
              ? code.trim().split(/\s+/).length
              : 0;

          lineCount.textContent =
            `${lines} ${lines === 1 ? "سطر" : "أسطر"}`;

          charCount.textContent =
            `${chars.toLocaleString("ar")} حرف`;

          statLines.textContent =
            lines.toLocaleString("ar");

          statChars.textContent =
            chars.toLocaleString("ar");

          statWords.textContent =
            words.toLocaleString("ar");

          lineNumbers.textContent =
            Array.from(
              { length: lines },
              (_, i) => i + 1
            ).join("\n");

        }


        function escapeHtml(value) {

          return String(value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");

        }


        function addConsole(type, value) {

          const line =
            document.createElement("div");

          line.className =
            `console-line ${type}`;

          line.innerHTML =
            escapeHtml(value);

          consoleOutput.appendChild(line);

          consoleOutput.scrollTop =
            consoleOutput.scrollHeight;

        }


        function resetConsole() {

          consoleOutput.innerHTML = "";

        }


        function setStatus(text, running = false) {

          runtimeStatus.innerHTML = `
            <span class="status-dot"></span>
            ${text}
          `;

          const dot =
            runtimeStatus.querySelector(".status-dot");

          if (dot) {

            dot.style.background =
              running
                ? "#f59e0b"
                : "#22c55e";

          }

        }


        /*
         * TypeScript transpiler.
         *
         * The playground intentionally supports
         * common TypeScript syntax so simple
         * TypeScript examples can be executed
         * directly in the browser.
         */

        function transpileTS(code) {

          let output = code;

          /*
           * Interfaces
           */
          output =
            output.replace(
              /interface\s+\w+(?:\s+extends\s+[^{]+)?\s*\{[\s\S]*?\}/g,
              ""
            );


          /*
           * Type aliases
           */
          output =
            output.replace(
              /type\s+\w+(?:<[^>]+>)?\s*=\s*[^;]+;/g,
              ""
            );


          /*
           * Access modifiers
           */
          output =
            output.replace(
              /\b(public|private|protected|readonly|abstract)\s+/g,
              ""
            );


          /*
           * Generic function declarations.
           */
          output =
            output.replace(
              /function\s+([A-Za-z_$][\w$]*)\s*<[^>]+>/g,
              "function $1"
            );


          /*
           * Generic calls:
           * identity<string>(...)
           */
          output =
            output.replace(
              /([A-Za-z_$][\w$]*)\s*<([A-Za-z_$][\w$]*(?:\[\])?(?:\s*,\s*[A-Za-z_$][\w$]*(?:\[\])?)*)>\s*\(/g,
              "$1("
            );


          /*
           * Variable type annotations.
           */
          output =
            output.replace(
              /(\b(?:const|let|var)\s+[A-Za-z_$][\w$]*)\s*\??\s*:\s*([A-Za-z_$][\w$]*(?:<[^;=]+>)?(?:\[\])?(?:\s*\|\s*[A-Za-z_$][\w$]*)*)\s*(?==)/g,
              "$1"
            );


          /*
           * Function parameter annotations.
           */
          output =
            output.replace(
              /([A-Za-z_$][\w$]*)\s*\??\s*:\s*[A-Za-z_$][\w$]*(?:<[^>]+>)?(?:\[\])?(?:\s*\|\s*[A-Za-z_$][\w$]*)*/g,
              "$1"
            );


          /*
           * Return types.
           */
          output =
            output.replace(
              /\)\s*:\s*[A-Za-z_$][\w$]*(?:<[^>]+>)?(?:\[\])?(?:\s*\|\s*[A-Za-z_$][\w$]*)*\s*\{/g,
              ") {"
            );


          /*
           * Type assertions:
           * value as string
           */
          output =
            output.replace(
              /\s+as\s+[A-Za-z_$][\w$]*(?:<[^>]+>)?(?:\[\])?/g,
              ""
            );


          /*
           * Non-null assertion.
           */
          output =
            output.replace(
              /([A-Za-z_$][\w$]*)!(?=[.;,\)\]])/g,
              "$1"
            );


          /*
           * Optional parameter marker.
           */
          output =
            output.replace(
              /([A-Za-z_$][\w$]*)\?(?=\s*[:,)=])/g,
              "$1"
            );


          /*
           * Enum - simple numeric/string enum support.
           */
          output =
            output.replace(
              /enum\s+([A-Za-z_$][\w$]*)\s*\{([\s\S]*?)\}/g,
              (_, name, body) => {

                const items =
                  body
                    .split(",")
                    .map(x => x.trim())
                    .filter(Boolean);

                let value = 0;

                const properties =
                  items.map(item => {

                    const parts =
                      item.split("=");

                    const key =
                      parts[0].trim();

                    let val;

                    if (parts[1]) {

                      val =
                        parts[1].trim();

                    } else {

                      val = String(value);

                    }

                    value++;

                    return `${name}[${JSON.stringify(key)}] = ${val};`;

                  }).join("\n");

                return `
                  const ${name} = {};
                  ${properties}
                `;

              }
            );


          return output;

        }


        async function runCode() {

          const code =
            editor.value;

          resetConsole();

          if (!code.trim()) {

            addConsole(
              "info",
              "لا يوجد كود للتنفيذ."
            );

            return;

          }


          setStatus(
            "جاري التنفيذ...",
            true
          );


          executionStatus.innerHTML = `
            <i class="fa-solid fa-circle"></i>
            جاري التنفيذ
          `;


          const start =
            performance.now();


          try {

            const jsCode =
              transpileTS(code);


            /*
             * Web Worker keeps the main UI
             * responsive and allows us to stop
             * endless loops.
             */

            const workerSource = `
              self.onmessage = function(event) {

                const code = event.data;

                const send = (type, value) => {

                  self.postMessage({
                    type,
                    value
                  });

                };

                const format = (value) => {

                  if (typeof value === "string")
                    return value;

                  if (
                    typeof value === "number" ||
                    typeof value === "boolean" ||
                    typeof value === "bigint"
                  )
                    return String(value);

                  if (value === null)
                    return "null";

                  if (value === undefined)
                    return "undefined";

                  try {
                    return JSON.stringify(
                      value,
                      null,
                      2
                    );
                  } catch {
                    return String(value);
                  }

                };

                console.log = (...args) => {
                  send(
                    "log",
                    args.map(format).join(" ")
                  );
                };

                console.info = (...args) => {
                  send(
                    "info",
                    args.map(format).join(" ")
                  );
                };

                console.warn = (...args) => {
                  send(
                    "info",
                    "⚠ " +
                    args.map(format).join(" ")
                  );
                };

                console.error = (...args) => {
                  send(
                    "error",
                    args.map(format).join(" ")
                  );
                };

                try {

                  const fn =
                    new Function(
                      '"use strict";\\n' +
                      code
                    );

                  fn();

                  send(
                    "done",
                    ""
                  );

                } catch(error) {

                  send(
                    "error",
                    error &&
                    error.stack
                      ? error.stack
                      : String(error)
                  );

                }

              };
            `;


            const blob =
              new Blob(
                [workerSource],
                {
                  type: "application/javascript"
                }
              );


            const worker =
              new Worker(
                URL.createObjectURL(blob)
              );


            let finished = false;


            const finish = () => {

              if (finished) return;

              finished = true;

              worker.terminate();

              URL.revokeObjectURL(
                worker.objectURL
              );

            };


            worker.onmessage = (event) => {

              const {
                type,
                value
              } = event.data;


              if (type === "log") {

                addConsole(
                  "log",
                  value
                );

              }


              if (type === "info") {

                addConsole(
                  "info",
                  value
                );

              }


              if (type === "error") {

                addConsole(
                  "error",
                  value
                );

              }


              if (type === "done") {

                const elapsed =
                  Math.round(
                    performance.now() - start
                  );


                executionTime.textContent =
                  `${elapsed} ms`;

                statTime.textContent =
                  `${elapsed} ms`;

                executionStatus.innerHTML = `
                  <i
                    class="fa-solid fa-circle"
                    style="color:#22c55e"
                  ></i>
                  تم التنفيذ
                `;

                setStatus("تم التنفيذ");

                worker.terminate();

              }

            };


            worker.onerror = (error) => {

              addConsole(
                "error",
                error.message ||
                "حدث خطأ أثناء التنفيذ."
              );

              setStatus("خطأ");

              worker.terminate();

            };


            worker.postMessage(
              jsCode
            );


            setTimeout(() => {

              if (!finished) {

                worker.terminate();

                addConsole(
                  "error",
                  "تم إيقاف التنفيذ لأنه تجاوز الحد الزمني المسموح."
                );

                setStatus("تم إيقاف التنفيذ");

                executionStatus.innerHTML = `
                  <i
                    class="fa-solid fa-circle"
                    style="color:#ef4444"
                  ></i>
                  توقف
                `;

              }

            }, 5000);

          } catch(error) {

            const elapsed =
              Math.round(
                performance.now() - start
              );

            executionTime.textContent =
              `${elapsed} ms`;

            statTime.textContent =
              `${elapsed} ms`;

            addConsole(
              "error",
              error.stack ||
              String(error)
            );

            setStatus("خطأ");

          }

        }


        function formatCode() {

          let code =
            editor.value;

          code =
            code
              .replace(/\r\n/g, "\n")
              .replace(/[ \t]+$/gm, "")
              .replace(/\n{3,}/g, "\n\n")
              .replace(
                /\{\s*\n/g,
                "{\n"
              );


          editor.value =
            code.trim();


          updateStats();

        }


        async function copyCode() {

          try {

            await navigator.clipboard.writeText(
              editor.value
            );

            copyBtn.innerHTML = `
              <i class="fa-solid fa-check"></i>
              تم النسخ
            `;

            setTimeout(() => {

              copyBtn.innerHTML = `
                <i class="fa-regular fa-copy"></i>
                نسخ
              `;

            }, 1500);

          } catch {

            editor.select();

            document.execCommand("copy");

          }

        }


        function clearCode() {

          editor.value = "";

          updateStats();

          resetConsole();

          setStatus("جاهز");

          executionStatus.innerHTML = `
            <i class="fa-solid fa-circle"></i>
            لم يتم التنفيذ
          `;

          executionTime.textContent =
            "0 ms";

          statTime.textContent =
            "0 ms";

        }


        function syncScroll() {

          lineNumbers.scrollTop =
            editor.scrollTop;

        }


        editor.addEventListener(
          "input",
          updateStats
        );


        editor.addEventListener(
          "scroll",
          syncScroll
        );


        editor.addEventListener(
          "keydown",
          (event) => {

            if (event.key === "Tab") {

              event.preventDefault();

              const start =
                editor.selectionStart;

              const end =
                editor.selectionEnd;

              editor.value =
                editor.value.substring(
                  0,
                  start
                ) +
                "  " +
                editor.value.substring(
                  end
                );

              editor.selectionStart =
                editor.selectionEnd =
                  start + 2;

              updateStats();

            }


            if (
              (event.ctrlKey || event.metaKey) &&
              event.key === "Enter"
            ) {

              event.preventDefault();

              runCode();

            }

          }
        );


        runBtn.addEventListener(
          "click",
          runCode
        );


        copyBtn.addEventListener(
          "click",
          copyCode
        );


        formatBtn.addEventListener(
          "click",
          formatCode
        );


        clearBtn.addEventListener(
          "click",
          clearCode
        );


        clearConsole.addEventListener(
          "click",
          resetConsole
        );


        updateStats();

      })();
    </script>

  </body>
</html>
