      /* DARK MODE */

      @media (prefers-color-scheme: dark) {

        :root {
          --bg: #070d14;
          --card: #0d1620;
          --text: #e2e8f0;
          --muted: #8da0b2;
          --border: #1e2b38;
        }

        .action-bar {
          background: #0a131d;
          border-color: #1e2b38;
        }

        .secondary-btn,
        .danger-btn {
          background: #0d1620;
