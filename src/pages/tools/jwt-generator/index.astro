      width:
        min(1180px, calc(100% - 32px));

      margin:
        auto;

    }


    .hero {

      padding:
        38px 0 55px;

      background:
        radial-gradient(
          circle at 10% 20%,
          rgba(22, 163, 74, .13),
          transparent 35%
        ),
        var(--bg);

    }


    .breadcrumb {

      display:
        flex;

      align-items:
        center;

      gap:
        10px;

      flex-wrap:
        wrap;

      margin-bottom:
        38px;

      color:
        var(--muted);

      font-size:
        13px;

    }


    .breadcrumb a {

      color:
        var(--muted);

      text-decoration:
        none;

    }


    .breadcrumb a:hover {

      color:
        var(--primary);

    }


    .breadcrumb i {

      font-size:
        9px;

    }


    .hero-content {

      display:
        flex;

      align-items:
        center;

      gap:
        28px;

    }


    .hero-icon {

      width:
        112px;

      height:
        112px;

      flex:
        0 0 112px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      flex-direction:
