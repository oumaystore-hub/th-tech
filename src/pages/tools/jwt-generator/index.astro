        gap:
          8px;

      }


      .stat {

        padding:
          10px 8px;

      }


      .stat > i {

        width:
          31px;

        height:
          31px;

        flex-basis:
          31px;

      }


      .stat strong {

        font-size:
          9px;

      }


      .info-section,
      .how-section,
      .faq-section {

        padding:
          50px 0;

      }

    }

