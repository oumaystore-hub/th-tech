---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "JWT Generator - إنشاء JWT أونلاين مجاناً | Th.Tech";

const description =
  "أداة JWT Generator مجانية لإنشاء JSON Web Token باستخدام HS256 وHS384 وHS512 مباشرة من المتصفح.";

const faqs = [
  {
    q: "ما هو JWT؟",
    a: "JWT هو JSON Web Token يستخدم لنقل معلومات بين الأطراف بطريقة موقعة."
  },
  {
    q: "ما الخوارزميات المدعومة؟",
    a: "تدعم الأداة HS256 وHS384 وHS512."
  },
  {
    q: "هل يتم إرسال البيانات إلى الخادم؟",
    a: "لا، تتم عملية إنشاء JWT داخل المتصفح."
  },
  {
    q: "هل Secret Key آمن؟",
    a: "المفتاح لا يتم إرساله إلى خادم Th.Tech، لكن تجنب استخدام مفاتيح حقيقية حساسة على أجهزة أو مواقع غير موثوقة."
  }
];
---

<html lang="ar" dir="rtl">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>{title}</title>

  <meta
    name="description"
    content={description}
  />

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem("theme");

        if (saved === "dark") {
          document.documentElement.classList.add("dark-mode");
        }
      } catch {}
    })();
  </script>

</head>


<body>

  <Header />


  <main>

    <section class="hero">

      <div class="container">

        <div class="breadcrumb">

          <a href={`${base}/`}>
            الرئيسية
          </a>

          <i class="fa-solid fa-chevron-left"></i>

          <a href={`${base}/tools/`}>
            الأدوات
          </a>

          <i class="fa-solid fa-chevron-left"></i>

          <span>
            JWT Generator
          </span>

        </div>


        <div class="hero-content">

          <div class="hero-icon">

            <i class="fa-solid fa-key"></i>

            <strong>
              JWT
            </strong>

          </div>


          <div class="hero-text">

            <div class="badge">

              <i class="fa-solid fa-code"></i>

              Developer Tools

            </div>


            <h1>
              JWT Generator
            </h1>


            <p>
              إنشاء JSON Web Token بسهولة باستخدام Header وPayload وSecret Key.
            </p>


            <div class="tags">

              <span>JWT</span>
              <span>HS256</span>
              <span>HS384</span>
              <span>HS512</span>
              <span>Local</span>

            </div>

          </div>

        </div>

      </div>

    </section>



    <section class="tool-section">

      <div class="container">

        <div class="generator-card">


          <div class="card-topbar">

            <div class="window-dots">

              <span></span>
              <span></span>
              <span></span>

            </div>


            <div class="tool-name">

              <i class="fa-solid fa-key"></i>

              JWT Generator

            </div>


            <div class="secure">

              <i class="fa-solid fa-shield-halved"></i>

              Local

            </div>

          </div>



          <div class="actionbar">

            <button
              id="exampleBtn"
              class="btn secondary"
              type="button"
            >

              <i class="fa-solid fa-flask"></i>

              مثال

            </button>


            <button
              id="clearBtn"
              class="btn secondary"
              type="button"
            >

              <i class="fa-solid fa-eraser"></i>

              مسح

            </button>


            <button
              id="copyBtn"
              class="btn secondary"
              type="button"
            >

              <i class="fa-regular fa-copy"></i>

              نسخ

            </button>


            <button
              id="generateBtn"
              class="btn primary"
              type="button"
            >

              <i class="fa-solid fa-wand-magic-sparkles"></i>

              إنشاء JWT

            </button>

          </div>



          <div class="settings">

            <div class="field">

              <label for="algorithm">

                <i class="fa-solid fa-code-branch"></i>

                الخوارزمية

              </label>


              <select id="algorithm">

                <option value="HS256">
                  HS256
                </option>

                <option value="HS384">
                  HS384
                </option>

                <option value="HS512">
                  HS512
                </option>

              </select>

            </div>



            <div class="field">

              <label for="secret">

                <i class="fa-solid fa-lock"></i>

                Secret Key

              </label>


              <div class="secret-box">

                <input
                  id="secret"
                  type="password"
                  placeholder="أدخل Secret Key..."
                  autocomplete="off"
                  dir="ltr"
                />


                <button
                  id="toggleSecret"
                  type="button"
                >

                  <i class="fa-solid fa-eye"></i>

                </button>

              </div>

            </div>

          </div>



          <div class="editors">


            <div class="editor">

              <div class="editor-head">

                <span>

                  <i class="fa-solid fa-code"></i>

                  Header

                </span>

                <small>
                  JSON
                </small>

              </div>


              <textarea
                id="headerInput"
                dir="ltr"
                spellcheck="false"
              >{
  "alg": "HS256",
  "typ": "JWT"
}</textarea>

            </div>



            <div class="editor">

              <div class="editor-head">

                <span>

                  <i class="fa-solid fa-database"></i>

                  Payload

                </span>

                <small>
                  JSON
                </small>

              </div>


              <textarea
                id="payloadInput"
                dir="ltr"
                spellcheck="false"
              >{
  "sub": "thtech",
  "name": "Th.Tech",
  "role": "developer"
}</textarea>

            </div>

          </div>



          <div class="output">

            <div class="output-head">

              <span>

                <i class="fa-solid fa-terminal"></i>

                Generated JWT

              </span>

              <small id="outputLength">
                0 حرف
              </small>

            </div>


            <textarea
              id="jwtOutput"
              readonly
              dir="ltr"
              spellcheck="false"
              placeholder="سيظهر JWT هنا..."
            ></textarea>

          </div>



          <div
            id="resultBox"
            class="result"
          >

            <div
              id="resultIcon"
              class="result-icon"
            >

              <i class="fa-solid fa-circle-info"></i>

            </div>


            <div>

              <strong id="resultTitle">
                جاهز
              </strong>

              <p id="resultMessage">
                أدخل البيانات ثم اضغط على إنشاء JWT.
              </p>

            </div>

          </div>



          <div class="stats">

            <div class="stat">

              <i class="fa-solid fa-text-width"></i>

              <div>

                <span>
                  JWT Length
                </span>

                <strong id="statLength">
                  0
                </strong>

              </div>

            </div>


            <div class="stat">

              <i class="fa-solid fa-code-branch"></i>

              <div>

                <span>
                  Algorithm
                </span>

                <strong id="statAlgorithm">
                  HS256
                </strong>

              </div>

            </div>


            <div class="stat">

              <i class="fa-solid fa-database"></i>

              <div>

                <span>
                  Payload
                </span>

                <strong id="statPayload">
                  0
                </strong>

              </div>

            </div>


            <div class="stat">

              <i class="fa-solid fa-circle-check"></i>

              <div>

                <span>
                  الحالة
                </span>

                <strong id="statStatus">
                  جاهز
                </strong>

              </div>

            </div>

          </div>

        </div>

      </div>

    </section>



    <section class="info-section">

      <div class="container">

        <div class="section-title">

          <span>
            JWT GENERATOR
          </span>

          <h2>
            إنشاء JWT بسهولة
          </h2>

          <p>
            أنشئ JSON Web Token مباشرة من المتصفح بدون إرسال بياناتك إلى الخادم.
          </p>

        </div>


        <div class="info-grid">


          <article class="info-card">

            <div class="info-icon">

              <i class="fa-solid fa-code"></i>

            </div>

            <h3>
              Header
            </h3>

            <p>
              يحتوي على نوع التوكن والخوارزمية المستخدمة.
            </p>

          </article>


          <article class="info-card">

            <div class="info-icon">

              <i class="fa-solid fa-database"></i>

            </div>

            <h3>
              Payload
            </h3>

            <p>
              يحتوي على البيانات والـClaims التي تريد تضمينها.
            </p>

          </article>


          <article class="info-card">

            <div class="info-icon">

              <i class="fa-solid fa-fingerprint"></i>

            </div>

            <h3>
              Signature
            </h3>

            <p>
              يتم إنشاء التوقيع باستخدام Secret Key والخوارزمية المختارة.
            </p>

          </article>


        </div>

      </div>

    </section>



    <section class="how-section">

      <div class="container">

        <div class="section-title">

          <span>
            HOW IT WORKS
          </span>

          <h2>
            كيفية إنشاء JWT
          </h2>

        </div>


        <div class="steps">


          <div class="step">

            <div class="number">
              1
            </div>

            <div>

              <h3>
                اختر الخوارزمية
              </h3>

              <p>
                اختر HS256 أو HS384 أو HS512.
              </p>

            </div>

          </div>


          <div class="step">

            <div class="number">
              2
            </div>

            <div>

              <h3>
                أدخل البيانات
              </h3>

              <p>
                أضف Header وPayload وSecret Key.
              </p>

            </div>

          </div>


          <div class="step">

            <div class="number">
              3
            </div>

            <div>

              <h3>
                إنشاء JWT
              </h3>

              <p>
                اضغط على إنشاء JWT ثم انسخ النتيجة.
              </p>

            </div>

          </div>


        </div>

      </div>

    </section>



    <section class="faq-section">

      <div class="container">

        <div class="section-title">

          <span>
            FAQ
          </span>

          <h2>
            الأسئلة الشائعة
          </h2>

        </div>


        <div class="faq-list">

          {faqs.map((faq) => (

            <details>

              <summary>

                <span>
                  {faq.q}
                </span>

                <i class="fa-solid fa-chevron-down"></i>

              </summary>

              <p>
                {faq.a}
              </p>

            </details>

          ))}

        </div>

      </div>

    </section>

  </main>


  <Footer />



  <script is:inline>
    (() => {

      const algorithm = document.getElementById("algorithm");
      const secret = document.getElementById("secret");

      const headerInput =
        document.getElementById("headerInput");

      const payloadInput =
        document.getElementById("payloadInput");

      const jwtOutput =
        document.getElementById("jwtOutput");

      const generateBtn =
        document.getElementById("generateBtn");

      const exampleBtn =
        document.getElementById("exampleBtn");

      const clearBtn =
        document.getElementById("clearBtn");

      const copyBtn =
        document.getElementById("copyBtn");

      const toggleSecret =
        document.getElementById("toggleSecret");

      const resultBox =
        document.getElementById("resultBox");

      const resultIcon =
        document.getElementById("resultIcon");

      const resultTitle =
        document.getElementById("resultTitle");

      const resultMessage =
        document.getElementById("resultMessage");

      const outputLength =
        document.getElementById("outputLength");

      const statLength =
        document.getElementById("statLength");

      const statAlgorithm =
        document.getElementById("statAlgorithm");

      const statPayload =
        document.getElementById("statPayload");

      const statStatus =
        document.getElementById("statStatus");


      let currentJWT = "";


      function encodeBase64Url(text) {

        const bytes =
          new TextEncoder().encode(text);

        let binary = "";

        for (let i = 0; i < bytes.length; i++) {

          binary += String.fromCharCode(
            bytes[i]
          );

        }

        return btoa(binary)
          .replace(/\+/g, "-")
          .replace(/\//g, "_")
          .replace(/=+$/g, "");

      }


      function hashName(name) {

        if (name === "HS384") {
          return "SHA-384";
        }

        if (name === "HS512") {
          return "SHA-512";
        }

        return "SHA-256";

      }


      async function makeSignature(
        text,
        key,
        algorithmName
      ) {

        const keyData =
          new TextEncoder().encode(key);

        const cryptoKey =
          await crypto.subtle.importKey(
            "raw",
            keyData,
            {
              name: "HMAC",
              hash: hashName(algorithmName)
            },
            false,
            ["sign"]
          );


        const signature =
          await crypto.subtle.sign(
            "HMAC",
            cryptoKey,
            new TextEncoder().encode(text)
          );


        const bytes =
          new Uint8Array(signature);

        let binary = "";

        for (let i = 0; i < bytes.length; i++) {

          binary += String.fromCharCode(
            bytes[i]
          );

        }


        return btoa(binary)
          .replace(/\+/g, "-")
          .replace(/\//g, "_")
          .replace(/=+$/g, "");

      }


      function showSuccess(message) {

        resultBox.classList.remove("error");

        resultBox.classList.add("success");

        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-check"></i>';

        resultTitle.textContent =
          "تم إنشاء JWT";

        resultMessage.textContent =
          message;

        statStatus.textContent =
          "نجاح";

      }


      function showError(message) {

        resultBox.classList.remove("success");

        resultBox.classList.add("error");

        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-xmark"></i>';

        resultTitle.textContent =
          "خطأ";

        resultMessage.textContent =
          message;

        statStatus.textContent =
          "خطأ";

      }


      function resetStatus() {

        resultBox.classList.remove("success");
        resultBox.classList.remove("error");

        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-info"></i>';

        resultTitle.textContent =
          "جاهز";

        resultMessage.textContent =
          "أدخل البيانات ثم اضغط على إنشاء JWT.";

        statStatus.textContent =
          "جاهز";

      }


      async function generateJWT() {

        const key =
          secret.value.trim();


        if (!key) {

          showError(
            "يرجى إدخال Secret Key."
          );

          secret.focus();

          return;

        }


        let header;
        let payload;


        try {

          header =
            JSON.parse(
              headerInput.value
            );

        } catch {

          showError(
            "Header غير صالح. أدخل JSON صحيح."
          );

          return;

        }


        try {

          payload =
            JSON.parse(
              payloadInput.value
            );

        } catch {

          showError(
            "Payload غير صالح. أدخل JSON صحيح."
          );

          return;

        }


        const selectedAlgorithm =
          algorithm.value;


        header.alg =
          selectedAlgorithm;


        header.typ =
          "JWT";


        const encodedHeader =
          encodeBase64Url(
            JSON.stringify(header)
          );


        const encodedPayload =
          encodeBase64Url(
            JSON.stringify(payload)
          );


        const content =
          encodedHeader +
          "." +
          encodedPayload;


        try {

          const signature =
            await makeSignature(
              content,
              key,
              selectedAlgorithm
            );


          currentJWT =
            content +
            "." +
            signature;


          jwtOutput.value =
            currentJWT;


          const length =
            currentJWT.length;


          outputLength.textContent =
            length.toLocaleString() +
            " حرف";


          statLength.textContent =
            length.toLocaleString();


          statAlgorithm.textContent =
            selectedAlgorithm;


          statPayload.textContent =
            payloadInput.value.length.toLocaleString();


          showSuccess(
            "تم إنشاء JWT محلياً داخل المتصفح."
          );

        } catch {

          showError(
            "تعذر إنشاء التوقيع. تأكد من أن المتصفح يدعم Web Crypto API."
          );

        }

      }


      function loadExample() {

        algorithm.value =
          "HS256";


        secret.value =
          "thtech-demo-secret";


        headerInput.value =
`{
  "alg": "HS256",
  "typ": "JWT"
}`;


        payloadInput.value =
`{
  "sub": "thtech",
  "name": "Th.Tech",
  "role": "developer"
}`;


        resetStatus();

        generateJWT();

      }


      function clearAll() {

        secret.value =
          "";


        jwtOutput.value =
          "";


        currentJWT =
          "";


        outputLength.textContent =
          "0 حرف";


        statLength.textContent =
          "0";


        statPayload.textContent =
          "0";


        resetStatus();


        secret.focus();

      }


      async function copyJWT() {

        if (!currentJWT) {

          showError(
            "أنشئ JWT أولاً قبل النسخ."
          );

          return;

        }


        try {

          await navigator.clipboard.writeText(
            currentJWT
          );

        } catch {

          jwtOutput.focus();

          jwtOutput.select();

          document.execCommand("copy");

        }


        const oldHTML =
          copyBtn.innerHTML;


        copyBtn.innerHTML =
          '<i class="fa-solid fa-check"></i> تم النسخ';


        setTimeout(() => {

          copyBtn.innerHTML =
            oldHTML;

        }, 1500);

      }


      toggleSecret.addEventListener(
        "click",
        () => {

          if (
            secret.type ===
            "password"
          ) {

            secret.type =
              "text";


            toggleSecret.innerHTML =
              '<i class="fa-solid fa-eye-slash"></i>';

          } else {

            secret.type =
              "password";


            toggleSecret.innerHTML =
              '<i class="fa-solid fa-eye"></i>';

          }

        }
      );


      algorithm.addEventListener(
        "change",
        () => {

          statAlgorithm.textContent =
            algorithm.value;

        }
      );


      generateBtn.addEventListener(
        "click",
        generateJWT
      );


      exampleBtn.addEventListener(
        "click",
        loadExample
      );


      clearBtn.addEventListener(
        "click",
        clearAll
      );


      copyBtn.addEventListener(
        "click",
        copyJWT
      );


      document.addEventListener(
        "keydown",
        (event) => {

          if (
            event.ctrlKey &&
            event.key === "Enter"
          ) {

            event.preventDefault();

            generateJWT();

          }

        }
      );


      headerInput.addEventListener(
        "keydown",
        (event) => {

          if (event.key === "Tab") {

            event.preventDefault();

            const start =
              headerInput.selectionStart;

            const end =
              headerInput.selectionEnd;


            headerInput.setRangeText(
              "  ",
              start,
              end,
              "end"
            );

          }

        }
      );


      payloadInput.addEventListener(
        "keydown",
        (event) => {

          if (event.key === "Tab") {

            event.preventDefault();

            const start =
              payloadInput.selectionStart;

            const end =
              payloadInput.selectionEnd;


            payloadInput.setRangeText(
              "  ",
              start,
              end,
              "end"
            );

          }

        }
      );


    })();
  </script>



  <style>

    :root {

      --bg: #f7fafc;
      --surface: #ffffff;
      --surface-2: #f8fafc;

      --text: #172033;
      --muted: #718096;

      --border: rgba(15, 23, 42, .09);

      --primary: #16a34a;
      --primary-dark: #15803d;

      --success: #16a34a;
      --danger: #dc2626;

      --shadow:
        0 25px 70px rgba(15, 23, 42, .10);

    }


    html.dark-mode {

      --bg: #070d09;
      --surface: #0d1510;
      --surface-2: #121c15;

      --text: #f8fafc;
      --muted: #94a3b8;

      --border:
        rgba(148, 163, 184, .13);

      --primary: #4ade80;
      --primary-dark: #22c55e;

      --success: #4ade80;
      --danger: #f87171;

      --shadow:
        0 30px 80px rgba(0, 0, 0, .45);

    }


