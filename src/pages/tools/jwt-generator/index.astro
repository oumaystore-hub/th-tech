---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "JWT Generator - إنشاء JWT أونلاين مجاناً | Th.Tech";

const description =
  "أداة JWT Generator مجانية لإنشاء JSON Web Token باستخدام خوارزميات HMAC مباشرة من المتصفح.";

const faqs = [
  {
    q: "ما هو JWT Generator؟",
    a: "هي أداة تساعدك على إنشاء JSON Web Token من Header وPayload وSecret Key مباشرة داخل المتصفح."
  },
  {
    q: "ما الخوارزميات المدعومة؟",
    a: "تدعم الأداة HS256 وHS384 وHS512 باستخدام Web Crypto API داخل المتصفح."
  },
  {
    q: "هل يتم إرسال Secret Key إلى الخادم؟",
    a: "لا. تتم عملية إنشاء التوقيع بالكامل داخل المتصفح ولا يتم إرسال المفتاح إلى خادم خارجي."
  },
  {
    q: "هل يمكن استخدام JWT الناتج في التطبيقات؟",
    a: "نعم، يمكن استخدام JWT الناتج للاختبار والتطوير، لكن يجب تطبيق إدارة المفاتيح والمصادقة المناسبة في بيئة الإنتاج."
  }
];
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem("theme");

        if (saved === "dark") {
          document.documentElement.classList.add("dark-mode");
        }
      } catch {}
    })();
  </script>
</head>

<body>

  <Header />

  <main>

    <!-- HERO -->
    <section class="hero">
      <div class="container">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fa-solid fa-chevron-left"></i>
          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fa-solid fa-chevron-left"></i>
          <span>JWT Generator</span>
        </div>

        <div class="hero-content">

          <div class="hero-icon">
            <i class="fa-solid fa-key"></i>
            <span>JWT</span>
          </div>

          <div class="hero-text">

            <div class="badge">
              <i class="fa-solid fa-code"></i>
              Developer Tools
            </div>

            <h1>JWT Generator</h1>

            <p>
              أنشئ JSON Web Token موقّع باستخدام
              Header وPayload وSecret Key بسهولة.
            </p>

            <div class="tags">
              <span>JWT</span>
              <span>HS256</span>
              <span>HS384</span>
              <span>HS512</span>
              <span>Local</span>
            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- TOOL -->
    <section class="tool-section">
      <div class="container">

        <div class="generator-card">

          <!-- TOP BAR -->
          <div class="card-topbar">

            <div class="window-dots">
              <span></span>
              <span></span>
              <span></span>
            </div>

            <div class="tool-name">
              <i class="fa-solid fa-key"></i>
              JWT Generator
            </div>

            <div class="secure">
              <i class="fa-solid fa-shield-halved"></i>
              Local
            </div>

          </div>


          <!-- ACTION BAR -->
          <div class="actionbar">

            <button id="exampleBtn" class="btn btn-secondary">
              <i class="fa-solid fa-flask"></i>
              مثال
            </button>

            <button id="clearBtn" class="btn btn-secondary">
              <i class="fa-solid fa-eraser"></i>
              مسح
            </button>

            <button id="copyBtn" class="btn btn-secondary">
              <i class="fa-regular fa-copy"></i>
              نسخ JWT
            </button>

            <button id="generateBtn" class="btn btn-primary">
              <i class="fa-solid fa-wand-magic-sparkles"></i>
              إنشاء JWT
            </button>

          </div>


          <!-- SETTINGS -->
          <div class="settings-grid">

            <div class="field">

              <label for="algorithm">
                <i class="fa-solid fa-code-branch"></i>
                Algorithm
              </label>

              <select id="algorithm">
                <option value="HS256">HS256</option>
                <option value="HS384">HS384</option>
                <option value="HS512">HS512</option>
              </select>

            </div>


            <div class="field">

              <label for="secret">
                <i class="fa-solid fa-lock"></i>
                Secret Key
              </label>

              <div class="secret-input">

                <input
                  id="secret"
                  type="password"
                  value=""
                  autocomplete="off"
                  placeholder="أدخل Secret Key..."
                  dir="ltr"
                />

                <button
                  id="toggleSecret"
                  type="button"
                  aria-label="إظهار المفتاح"
                >
                  <i class="fa-solid fa-eye"></i>
                </button>

              </div>

            </div>

          </div>


          <!-- EDITORS -->
          <div class="editors-grid">

            <!-- HEADER -->
            <div class="editor-panel">

              <div class="editor-header">

                <div>
                  <i class="fa-solid fa-code"></i>
                  Header
                </div>

                <span>JSON</span>

              </div>

              <textarea
                id="headerInput"
                spellcheck="false"
                dir="ltr"
              >{
  "alg": "HS256",
  "typ": "JWT"
}</textarea>

            </div>


            <!-- PAYLOAD -->
            <div class="editor-panel">

              <div class="editor-header">

                <div>
                  <i class="fa-solid fa-database"></i>
                  Payload
                </div>

                <span>JSON</span>

              </div>

              <textarea
                id="payloadInput"
                spellcheck="false"
                dir="ltr"
              >{
  "sub": "thtech",
  "name": "Th.Tech",
  "role": "developer"
}</textarea>

            </div>

          </div>


          <!-- RESULT -->
          <div class="result-section">

            <div class="result-header">

              <div>
                <i class="fa-solid fa-terminal"></i>
                Generated JWT
              </div>

              <span id="resultCount">
                0 حرف
              </span>

            </div>

            <div class="jwt-output" id="jwtOutput">
              لم يتم إنشاء JWT بعد.
            </div>

          </div>


          <!-- RESULT STATUS -->
          <div class="result-box" id="resultBox">

            <div class="result-icon" id="resultIcon">
              <i class="fa-solid fa-circle-question"></i>
            </div>

            <div class="result-content">

              <strong id="resultTitle">
                جاهز للإنشاء
              </strong>

              <p id="resultMessage">
                أدخل البيانات والمفتاح ثم اضغط على إنشاء JWT.
              </p>

            </div>

          </div>


          <!-- STATS -->
          <div class="stats-grid">

            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-text-width"></i>
              </div>

              <div>
                <span>JWT Length</span>
                <strong id="statLength">0</strong>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-code"></i>
              </div>

              <div>
                <span>Algorithm</span>
                <strong id="statAlgorithm">HS256</strong>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-database"></i>
              </div>

              <div>
                <span>Payload</span>
                <strong id="statPayload">0</strong>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-bolt"></i>
              </div>

              <div>
                <span>الحالة</span>
                <strong id="statStatus">جاهز</strong>
              </div>

            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- INFO -->
    <section class="info-section">
      <div class="container">

        <div class="section-heading">

          <span>JWT GENERATOR</span>

          <h2>
            إنشاء JWT بسهولة
          </h2>

          <p>
            أنشئ JSON Web Token موقّع باستخدام
            خوارزميات HMAC الشائعة مباشرة من المتصفح.
          </p>

        </div>


        <div class="info-grid">

          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-code"></i>
            </div>

            <h3>
              Header
            </h3>

            <p>
              يحدد نوع التوكن والخوارزمية المستخدمة
              لإنشاء التوقيع.
            </p>

          </article>


          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-database"></i>
            </div>

            <h3>
              Payload
            </h3>

            <p>
              يحتوي على البيانات وClaims التي تريد
              تضمينها داخل JWT.
            </p>

          </article>


          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-fingerprint"></i>
            </div>

            <h3>
              Signature
            </h3>

            <p>
              يتم إنشاء التوقيع باستخدام Secret Key
              والخوارزمية المحددة.
            </p>

          </article>

        </div>

      </div>
    </section>


    <!-- HOW TO -->
    <section class="how-section">
      <div class="container">

        <div class="section-heading">

          <span>HOW IT WORKS</span>

          <h2>
            كيفية إنشاء JWT
          </h2>

        </div>


        <div class="steps">

          <div class="step">

            <div class="step-number">
              1
            </div>

            <div>
              <h3>
                اختر الخوارزمية
              </h3>

              <p>
                اختر HS256 أو HS384 أو HS512.
              </p>
            </div>

          </div>


          <div class="step">

            <div class="step-number">
              2
            </div>

            <div>
              <h3>
                أدخل البيانات والمفتاح
              </h3>

              <p>
                أضف Header وPayload وSecret Key.
              </p>
            </div>

          </div>


          <div class="step">

            <div class="step-number">
              3
            </div>

            <div>
              <h3>
                أنشئ JWT
              </h3>

              <p>
                اضغط على إنشاء JWT ثم انسخ النتيجة.
              </p>
            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- FAQ -->
    <section class="faq-section">
      <div class="container">

        <div class="section-heading">

          <span>FAQ</span>

          <h2>
            الأسئلة الشائعة
          </h2>

        </div>


        <div class="faq-list">

          {faqs.map((faq) => (
            <details>

              <summary>

                <span>
                  {faq.q}
                </span>

                <i class="fa-solid fa-chevron-down"></i>

              </summary>

              <p>
                {faq.a}
              </p>

            </details>
          ))}

        </div>

      </div>
    </section>

  </main>


  <Footer />


  <!-- JAVASCRIPT -->
  <script is:inline>
    (() => {

      const algorithm =
        document.getElementById("algorithm");

      const secret =
        document.getElementById("secret");

      const toggleSecret =
        document.getElementById("toggleSecret");

      const headerInput =
        document.getElementById("headerInput");

      const payloadInput =
        document.getElementById("payloadInput");

      const jwtOutput =
        document.getElementById("jwtOutput");

      const generateBtn =
        document.getElementById("generateBtn");

      const exampleBtn =
        document.getElementById("exampleBtn");

      const clearBtn =
        document.getElementById("clearBtn");

      const copyBtn =
        document.getElementById("copyBtn");

      const resultCount =
        document.getElementById("resultCount");

      const resultBox =
        document.getElementById("resultBox");

      const resultIcon =
        document.getElementById("resultIcon");

      const resultTitle =
        document.getElementById("resultTitle");

      const resultMessage =
        document.getElementById("resultMessage");

      const statLength =
        document.getElementById("statLength");

      const statAlgorithm =
        document.getElementById("statAlgorithm");

      const statPayload =
        document.getElementById("statPayload");

      const statStatus =
        document.getElementById("statStatus");


      let generatedToken = "";


      function updateStats() {

        const payloadLength =
          payloadInput.value.length;

        statPayload.textContent =
          payloadLength.toLocaleString();

        statAlgorithm.textContent =
          algorithm.value;

        if (!generatedToken) {

          statLength.textContent =
            "0";

          resultCount.textContent =
            "0 حرف";
        }
      }


      function setReady() {

        resultBox.classList.remove(
          "success",
          "error"
        );

        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-question"></i>';

        resultTitle.textContent =
          "جاهز للإنشاء";

        resultMessage.textContent =
          "أدخل البيانات والمفتاح ثم اضغط على إنشاء JWT.";

        statStatus.textContent =
          "جاهز";
      }


      function setSuccess(message) {

        resultBox.classList.remove(
          "error"
        );

        resultBox.classList.add(
          "success"
        );

        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-check"></i>';

        resultTitle.textContent =
          "تم إنشاء JWT بنجاح";

        resultMessage.textContent =
          message;

        statStatus.textContent =
          "تم الإنشاء";
      }


      function setError(message) {

        resultBox.classList.remove(
          "success"
        );

        resultBox.classList.add(
          "error"
        );

        resultIcon.innerHTML =
          '<i class="fa-solid fa-circle-xmark"></i>';

        resultTitle.textContent =
          "تعذر إنشاء JWT";

        resultMessage.textContent =
          message;

        statStatus.textContent =
          "خطأ";
      }


      function base64UrlEncode(value) {

        const bytes =
          new TextEncoder().encode(
            value
          );


        let binary = "";


        for (
          let i = 0;
          i < bytes.length;
          i++
        ) {

          binary += String.fromCharCode(
            bytes[i]
          );

        }


        return btoa(binary)
          .replace(/\+/g, "-")
          .replace(/\//g, "_")
          .replace(/=+$/g, "");
      }


      function formatJSON(text) {

        try {

          const parsed =
            JSON.parse(text);

          return JSON.stringify(
            parsed
          );

        } catch {

          return null;
        }
      }


      async function createSignature(
        signingInput,
        keyValue,
        algorithmName
      ) {

        const algorithmMap = {

          HS256: {
            name: "HMAC",
            hash: "SHA-256"
          },

          HS384: {
            name: "HMAC",
            hash: "SHA-384"
          },

          HS512: {
            name: "HMAC",
            hash: "SHA-512"
          }

        };


        const config =
          algorithmMap[
            algorithmName
          ];


        const key =
          await crypto.subtle.importKey(
            "raw",
            new TextEncoder().encode(
              keyValue
            ),
            config,
            false,
            ["sign"]
          );


        const signature =
          await crypto.subtle.sign(
            config,
            key,
            new TextEncoder().encode(
              signingInput
            )
          );


        let binary = "";


        const bytes =
          new Uint8Array(
            signature
          );


        for (
          let i = 0;
          i < bytes.length;
          i++
        ) {

          binary += String.fromCharCode(
            bytes[i]
          );

        }


        return btoa(binary)
          .replace(/\+/g, "-")
          .replace(/\//g, "_")
          .replace(/=+$/g, "");
      }


      async function generateJWT() {

        const keyValue =
          secret.value.trim();


        if (!keyValue) {

          setError(
            "أدخل Secret Key أولاً."
          );

          secret.focus();

          return;
        }


        let header;
        let payload;


        try {

          header =
            JSON.parse(
              headerInput.value
            );

        } catch {

          setError(
            "Header غير صالح. تأكد من كتابة JSON صحيح."
          );

          return;
        }


        try {

          payload =
            JSON.parse(
              payloadInput.value
            );

        } catch {

          setError(
            "Payload غير صالح. تأكد من كتابة JSON صحيح."
          );

          return;
        }


        const selectedAlgorithm =
          algorithm.value;


        header.alg =
          selectedAlgorithm;


        if (!header.typ) {

          header.typ =
            "JWT";
        }


        const headerJSON =
          JSON.stringify(
            header
          );


        const payloadJSON =
          JSON.stringify(
            payload
          );


        const encodedHeader =
          base64UrlEncode(
            headerJSON
          );


        const encodedPayload =
          base64UrlEncode(
            payloadJSON
          );


        const signingInput =
          `${encodedHeader}.${encodedPayload}`;


        try {

          const signature =
            await createSignature(
              signingInput,
              keyValue,
              selectedAlgorithm
            );


          generatedToken =
            `${signingInput}.${signature}`;


          jwtOutput.textContent =
            generatedToken;


          resultCount.textContent =
            `${generatedToken.length.toLocaleString()} حرف`;


          statLength.textContent =
            generatedToken.length.toLocaleString();


          statPayload.textContent =
            payloadInput.value.length.toLocaleString();


          statAlgorithm.textContent =
            selectedAlgorithm;


          setSuccess(
            `تم إنشاء JWT باستخدام ${selectedAlgorithm} داخل المتصفح.`
          );

        } catch {

          setError(
            "حدث خطأ أثناء إنشاء التوقيع. تأكد من أن المتصفح يدعم Web Crypto API."
          );
        }
      }


      function loadExample() {

        algorithm.value =
          "HS256";


        secret.value =
          "thtech-demo-secret-2026";


        headerInput.value =
`{
  "alg": "HS256",
  "typ": "JWT"
}`;


        payloadInput.value =
`{
  "sub": "thtech",
  "name": "Th.Tech",
  "role": "developer",
  "iat": 1720000000
}`;


        generatedToken = "";

        jwtOutput.textContent =
          "لم يتم إنشاء JWT بعد.";


        updateStats();

        setReady();

        generateJWT();
      }


      function clearAll() {

        secret.value = "";

        headerInput.value =
`{
  "alg": "HS256",
  "typ": "JWT"
}`;


        payloadInput.value =
`{
  "sub": "thtech",
  "name": "Th.Tech",
  "role": "developer"
}`;


        algorithm.value =
          "HS256";


        generatedToken = "";

        jwtOutput.textContent =
          "لم يتم إنشاء JWT بعد.";


        resultCount.textContent =
          "0 حرف";


        statLength.textContent =
          "0";


        updateStats();

        setReady();

        secret.focus();
      }


      async function copyJWT() {

        if (!generatedToken) {

          setError(
            "أنشئ JWT أولاً قبل النسخ."
          );

          return;
        }


        try {

          await navigator.clipboard.writeText(
            generatedToken
          );


          const original =
            copyBtn.innerHTML;


          copyBtn.innerHTML =
            '<i class="fa-solid fa-check"></i> تم النسخ';


          setTimeout(() => {

            copyBtn.innerHTML =
              original;

          }, 1500);

        } catch {

          const temp =
            document.createElement(
              "textarea"
            );


          temp.value =
            generatedToken;


          document.body.appendChild(
            temp
          );


          temp.select();


          document.execCommand(
            "copy"
          );


          temp.remove();


          copyBtn.innerHTML =
            '<i class="fa-solid fa-check"></i> تم النسخ';


          setTimeout(() => {

            copyBtn.innerHTML =
              '<i class="fa-regular fa-copy"></i> نسخ JWT';

          }, 1500);
        }
      }


      toggleSecret.addEventListener(
        "click",
        () => {

          const visible =
            secret.type === "text";


          secret.type =
            visible
              ? "password"
              : "text";


          toggleSecret.innerHTML =
            visible
              ? '<i class="fa-solid fa-eye"></i>'
              : '<i class="fa-solid fa-eye-slash"></i>';

        }
      );


      algorithm.addEventListener(
        "change",
        () => {

          updateStats();

        }
      );


      payloadInput.addEventListener(
        "input",
        updateStats
      );


      headerInput.addEventListener(
        "keydown",
        (event) => {

          if (
            event.key === "Tab"
          ) {

            event.preventDefault();

            const start =
              headerInput.selectionStart;

            const end =
              headerInput.selectionEnd;


            headerInput.value =
              headerInput.value.substring(
                0,
                start
              ) +
              "  " +
              headerInput.value.substring(
                end
              );


            headerInput.selectionStart =
              headerInput.selectionEnd =
                start + 2;
          }

        }
      );


      payloadInput.addEventListener(
        "keydown",
        (event) => {

          if (
            event.key === "Tab"
          ) {

            event.preventDefault();

            const start =
              payloadInput.selectionStart;

            const end =
              payloadInput.selectionEnd;


            payloadInput.value =
              payloadInput.value.substring(
                0,
                start
              ) +
              "  " +
              payloadInput.value.substring(
                end
              );


            payloadInput.selectionStart =
              payloadInput.selectionEnd =
                start + 2;
          }

        }
      );


      document.addEventListener(
        "keydown",
        (event) => {

          if (
            event.ctrlKey &&
            event.key === "Enter"
          ) {

            event.preventDefault();

            generateJWT();
          }

        }
      );


      generateBtn.addEventListener(
        "click",
        generateJWT
      );


      exampleBtn.addEventListener(
        "click",
        loadExample
      );


      clearBtn.addEventListener(
        "click",
        clearAll
      );


      copyBtn.addEventListener(
        "click",
        copyJWT
      );


      updateStats();

      setReady();

    })();
  </script>


  <style>

    :root {

      --bg: #f7fafc;
      --surface: #ffffff;
      --surface-2: #f8fafc;

      --text: #172033;
      --muted: #718096;

      --border:
        rgba(15, 23, 42, 0.09);

      --primary: #16a34a;
      --primary-dark: #15803d;
      --secondary: #22c55e;

      --success: #16a34a;
      --danger: #dc2626;

      --shadow:
        0 25px 70px
        rgba(15, 23, 42, 0.10);
    }


    html.dark-mode {

      --bg: #070d09;
      --surface: #0d1510;
      --surface-2: #121c15;

      --text: #f8fafc;
      --muted: #94a3b8;

      --border:
        rgba(148, 163, 184, 0.13);

      --primary: #4ade80;
      --primary-dark: #22c55e;
      --secondary: #86efac;

      --shadow:
        0 30px 80px
        rgba(0, 0, 0, 0.45);
    }


    * {
      box-sizing: border-box;
    }


    body {

      margin: 0;

      background:
        var(--bg);

      color:
        var(--text);

      font-family:
        "Cairo",
        sans-serif;
    }


    .container {

      width:
        min(
          1180px,
          calc(100% - 32px)
        );

      margin:
        auto;
    }


    /* HERO */

    .hero {

      padding:
        38px 0 55px;

      background:
        radial-gradient(
          circle at 10% 20%,
          rgba(22, 163, 74, 0.13),
          transparent 35%
        ),
        var(--bg);
    }


    .breadcrumb {

      display:
        flex;

      align-items:
        center;

      gap:
        10px;

      flex-wrap:
        wrap;

      color:
        var(--muted);

      font-size:
        13px;

      margin-bottom:
        38px;
    }


    .breadcrumb a {

      color:
        var(--muted);

      text-decoration:
        none;
    }


    .breadcrumb i {

      font-size:
        9px;
    }


    .hero-content {

      display:
        flex;

      align-items:
        center;

      gap:
        28px;
    }


    .hero-icon {

      width:
        112px;

      height:
        112px;

      flex:
        0 0 112px;

      border-radius:
        30px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      flex-direction:
        column;

      gap:
        4px;

      background:
        rgba(22, 163, 74, 0.12);

      color:
        var(--primary);

      box-shadow:
        inset 0 0 0 1px
        rgba(22, 163, 74, 0.10);
    }


    .hero-icon i {

      font-size:
        40px;
    }


    .hero-icon span {

      font:
        700 13px
        "JetBrains Mono",
        monospace;
    }


    .badge {

      display:
        inline-flex;

      align-items:
        center;

      gap:
        8px;

      padding:
        7px 13px;

      border-radius:
        999px;

      background:
        rgba(22, 163, 74, 0.10);

      color:
        var(--primary);

      font-size:
        12px;

      font-weight:
        700;
    }


    h1 {

      margin:
        12px 0 8px;

      font-size:
        clamp(
          32px,
          5vw,
          52px
        );

      line-height:
        1.1;
    }


    .hero-text p {

      margin:
        0;

      max-width:
        700px;

      color:
        var(--muted);

      font-size:
        16px;

      line-height:
        1.9;
    }


    .tags {

      display:
        flex;

      flex-wrap:
        wrap;

      gap:
        8px;

      margin-top:
        17px;
    }


    .tags span {

      padding:
        5px 10px;

      border:
        1px solid
        var(--border);

      border-radius:
        8px;

      color:
        var(--muted);

      background:
        var(--surface);

      font:
        500 11px
        "JetBrains Mono",
        monospace;
    }


    /* TOOL */

    .tool-section {

      padding-bottom:
        70px;
    }


    .generator-card {

      overflow:
        hidden;

      background:
        var(--surface);

      border:
        1px solid
        var(--border);

      border-radius:
        22px;

      box-shadow:
        var(--shadow);
    }


    .card-topbar {

      min-height:
        55px;

      padding:
        0 20px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      border-bottom:
        1px solid
        var(--border);

      background:
        var(--surface-2);
    }


    .window-dots {

      display:
        flex;

      gap:
        6px;
    }


    .window-dots span {

      width:
        9px;

      height:
        9px;

      border-radius:
        50%;

      background:
        var(--border);
    }


    .tool-name {

      display:
        flex;

      align-items:
        center;

      gap:
        8px;

      color:
        var(--text);

      font:
        600 13px
        "JetBrains Mono",
        monospace;
    }


    .tool-name i {

      color:
        var(--primary);
    }


    .secure {

      display:
        flex;

      align-items:
        center;

      gap:
        6px;

      color:
        var(--success);

      font-size:
        11px;

      font-weight:
        700;
    }


    /* ACTIONBAR */

    .actionbar {

      display:
        flex;

      flex-wrap:
        wrap;

      gap:
        9px;

      padding:
        15px 18px;

      border-bottom:
        1px solid
        var(--border);
    }


    .btn {

      border:
        1px solid
        var(--border);

      border-radius:
        10px;

      padding:
        10px 15px;

      font-family:
        "Cairo",
        sans-serif;

      font-size:
        12px;

      font-weight:
        700;

      cursor:
        pointer;

      transition:
        0.2s;
    }


    .btn:hover {

      transform:
        translateY(-1px);
    }


    .btn i {

      margin-left:
        6px;
    }


    .btn-secondary {

      color:
        var(--text);

      background:
        var(--surface-2);
    }


    .btn-primary {

      color:
        white;

      background:
        var(--primary);

      border-color:
        var(--primary);
    }


    .btn-primary:hover {

      background:
        var(--primary-dark);
    }


    /* SETTINGS */

    .settings-grid {

      display:
        grid;

      grid-template-columns:
        0.7fr 1.3fr;

      gap:
        14px;

      margin:
        20px 20px 15px;
    }


    .field {

      min-width:
        0;
    }


    .field label {

      display:
        flex;

      align-items:
        center;

      gap:
        7px;

      margin-bottom:
        8px;

      color:
        var(--text);

      font-size:
        12px;

      font-weight:
        700;
    }


    .field label i {

      color:
        var(--primary);
    }


    select,
    .secret-input {

      width:
        100%;

      min-height:
        47px;

      border:
        1px solid
        var(--border);

      border-radius:
        11px;

      background:
        var(--surface-2);

      color:
        var(--text);

      font:
        12px
        "Cairo",
        sans-serif;
    }


    select {

      padding:
        0 13px;

      outline:
        none;

      cursor:
        pointer;
    }


    .secret-input {

      display:
        flex;

      align-items:
        center;

      overflow:
        hidden;
    }


    .secret-input input {

      width:
        100%;

      height:
        47px;

      padding:
        0 13px;

      border:
        0;

      outline:
        0;

      background:
        transparent;

      color:
        var(--text);

      font:
        12px
        "JetBrains Mono",
        monospace;
    }


    .secret-input button {

      width:
        45px;

      height:
        45px;

      flex:
        0 0 45px;

      border:
        0;

      border-right:
        1px solid
        var(--border);

      background:
        transparent;

      color:
        var(--muted);

      cursor:
        pointer;
    }


    .secret-input button:hover {

      color:
        var(--primary);
    }


    /* EDITORS */

    .editors-grid {

      display:
        grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap:
        15px;

      margin:
        0 20px 15px;
    }


    .editor-panel {

      min-width:
        0;

      overflow:
        hidden;

      border:
        1px solid
        var(--border);

      border-radius:
        15px;

      background:
        #0d1117;
    }


    .editor-header {

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      padding:
        12px 14px;

      border-bottom:
        1px solid
        rgba(255,255,255,.08);

      color:
        #f8fafc;

      font-size:
        12px;

      font-weight:
        700;
    }


    .editor-header div {

      display:
        flex;

      align-items:
        center;

      gap:
        8px;
    }


    .editor-header i {

      color:
        var(--secondary);
    }


    .editor-header span {

      color:
        #64748b;

      font:
        9px
        "JetBrains Mono",
        monospace;
    }


    .editor-panel textarea {

      width:
        100%;

      min-height:
        260px;

      display:
        block;

      resize:
        vertical;

      padding:
        18px;

      border:
        0;

      outline:
        0;

      background:
        transparent;

      color:
        #e2e8f0;

      font:
        12px/1.8
        "JetBrains Mono",
        monospace;

      text-align:
        left;
    }


    /* RESULT */

    .result-section {

      margin:
        0 20px 15px;

      overflow:
        hidden;

      border:
        1px solid
        var(--border);

      border-radius:
        15px;

      background:
        #0d1117;
    }


    .result-header {

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      padding:
        12px 14px;

      border-bottom:
        1px solid
        rgba(255,255,255,.08);

      color:
        #f8fafc;

      font-size:
        12px;

      font-weight:
        700;
    }


    .result-header div {

      display:
        flex;

      align-items:
        center;

      gap:
        8px;
    }


    .result-header i {

      color:
        var(--secondary);
    }


    .result-header span {

      color:
        #64748b;

      font:
        9px
        "JetBrains Mono",
        monospace;
    }


    .jwt-output {

      min-height:
        115px;

      padding:
        18px;

      overflow:
        auto;

      color:
        #86efac;

      direction:
        ltr;

      text-align:
        left;

      word-break:
        break-all;

      font:
        12px/1.9
        "JetBrains Mono",
        monospace;
    }


    /* RESULT BOX */

    .result-box {

      margin:
        0 20px 15px;

      display:
        flex;

      align-items:
        center;

      gap:
        14px;

      padding:
        15px 17px;

      border:
        1px solid
        var(--border);

      border-radius:
        14px;

      background:
        var(--surface-2);
    }


    .result-icon {

      width:
        42px;

      height:
        42px;

      flex:
        0 0 42px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      border-radius:
        11px;

      background:
        rgba(22, 163, 74, 0.10);

      color:
        var(--primary);

      font-size:
        17px;
    }


    .result-box strong {

      display:
        block;

      font-size:
        13px;
    }


    .result-box p {

      margin:
        3px 0 0;

      color:
        var(--muted);

      font-size:
        11px;

      line-height:
        1.7;
    }


    .result-box.success {

      border-color:
        rgba(22, 163, 74, 0.25);
    }


    .result-box.success .result-icon {

      color:
        var(--success);

      background:
        rgba(22, 163, 74, 0.10);
    }


    .result-box.error {

      border-color:
        rgba(220, 38, 38, 0.25);
    }


    .result-box.error .result-icon {

      color:
        var(--danger);

      background:
        rgba(220, 38, 38, 0.10);
    }


    /* STATS */

    .stats-grid {

      display:
        grid;

      grid-template-columns:
        repeat(4, 1fr);

      gap:
        12px;

      padding:
        0 20px 20px;
    }


    .stat {

      display:
        flex;

      align-items:
        center;

      gap:
        11px;

      min-width:
        0;

      padding:
        14px;

      border:
        1px solid
        var(--border);

      border-radius:
        13px;

      background:
        var(--surface-2);
    }


    .stat-icon {

      width:
        36px;

      height:
        36px;

      flex:
        0 0 36px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      border-radius:
        9px;

      color:
        var(--primary);

      background:
        rgba(22, 163, 74, 0.10);
    }


    .stat span {

      display:
        block;

      color:
        var(--muted);

      font-size:
        9px;
    }


    .stat strong {

      display:
        block;

      max-width:
        150px;

      overflow:
        hidden;

      margin-top:
        2px;

      color:
        var(--text);

      text-overflow:
        ellipsis;

      white-space:
        nowrap;

      font:
        600 11px
        "JetBrains Mono",
        monospace;
    }


    /* SECTIONS */

    .info-section,
    .how-section,
    .faq-section {

      padding:
        70px 0;
    }


    .info-section {

      background:
        var(--surface-2);

      border-top:
        1px solid
        var(--border);

      border-bottom:
        1px solid
        var(--border);
    }


    .section-heading {

      max-width:
        700px;

      margin:
        0 auto 35px;

      text-align:
        center;
    }


    .section-heading > span {

      color:
        var(--primary);

      font:
        700 11px
        "JetBrains Mono",
        monospace;

      letter-spacing:
        1px;
    }


    .section-heading h2 {

      margin:
        8px 0;

      font-size:
        clamp(
          25px,
          4vw,
          34px
        );
    }


    .section-heading p {

      margin:
        0;

      color:
        var(--muted);

      line-height:
        1.9;

      font-size:
        14px;
    }


    .info-grid {

      display:
        grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap:
        18px;
    }


    .info-card {

      padding:
        25px;

      border:
        1px solid
        var(--border);

      border-radius:
        17px;

      background:
        var(--surface);
    }


    .info-icon {

      width:
        48px;

      height:
        48px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      margin-bottom:
        17px;

      border-radius:
        13px;

      color:
        var(--primary);

      background:
        rgba(22, 163, 74, 0.10);
    }


    .info-card h3 {

      margin:
        0 0 7px;

      font-size:
        16px;
    }


    .info-card p {

      margin:
        0;

      color:
        var(--muted);

      font-size:
        13px;

      line-height:
        1.9;
    }


    /* STEPS */

    .steps {

      display:
        grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap:
        18px;
    }


    .step {

      display:
        flex;

      gap:
        15px;

      padding:
        22px;

      border:
        1px solid
        var(--border);

      border-radius:
        16px;

      background:
        var(--surface);
    }


    .step-number {

      width:
        38px;

      height:
        38px;

      flex:
        0 0 38px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      border-radius:
        10px;

      color:
        white;

      background:
        var(--primary);

      font-weight:
        800;
    }


    .step h3 {

      margin:
        0 0 5px;

      font-size:
        14px;
    }


    .step p {

      margin:
        0;

      color:
        var(--muted);

      font-size:
        12px;

      line-height:
        1.8;
    }


    /* FAQ */

    .faq-list {

      max-width:
        850px;

      margin:
        auto;
    }


    details {

      margin-bottom:
        10px;

      border:
        1px solid
        var(--border);

      border-radius:
        13px;

      background:
        var(--surface);

      overflow:
        hidden;
    }


    summary {

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      padding:
        17px 19px;

      cursor:
        pointer;

      font-size:
        13px;

      font-weight:
        700;

      list-style:
        none;
    }


    summary::-webkit-details-marker {
      display: none;
    }


    summary i {

      color:
        var(--primary);

      transition:
        transform 0.2s;
    }


    details[open] summary i {

      transform:
        rotate(180deg);
    }


    details p {

      margin:
        0;

      padding:
        0 19px 18px;

      color:
        var(--muted);

      font-size:
        12px;

      line-height:
        1.9;
    }


    /* RESPONSIVE */

    @media (max-width: 850px) {

      .settings-grid {

        grid-template-columns:
          1fr;
      }


      .editors-grid {

        grid-template-columns:
          1fr;
      }


      .stats-grid {

        grid-template-columns:
          repeat(2, 1fr);
      }


      .info-grid,
      .steps {

        grid-template-columns:
          1fr;
      }
    }


    @media (max-width: 600px) {

      .container {

        width:
          min(
            100% - 22px,
            1180px
          );
      }


      .hero {

        padding-top:
          25px;
      }


      .hero-content {

        align-items:
          flex-start;

        flex-direction:
          column;
      }


      .hero-icon {

        width:
          88px;

        height:
          88px;

        flex-basis:
          88px;

        border-radius:
          23px;
      }


      .hero-icon i {

        font-size:
          31px;
      }


      .card-topbar {

        padding:
          0 13px;
      }


      .actionbar {

        padding:
          12px;
      }


      .btn {

        flex:
          1 1
          calc(50% - 8px);

        padding:
          9px 8px;
      }


      .settings-grid {

        margin:
          12px 12px 10px;
      }


      .editors-grid {

        margin:
          0 12px 12px;
      }


      .editor-panel textarea {

        min-height:
          220px;

        padding:
          14px;

        font-size:
          10px;
      }


      .result-section {

        margin:
          0 12px 12px;
      }


      .jwt-output {

        min-height:
          130px;

        padding:
          14px;

        font-size:
          10px;
      }


      .result-box {

        margin:
          0 12px 12px;
      }


      .stats-grid {

        padding:
          0 12px 12px;

        gap:
          8px;
      }


      .stat {

        padding:
          11px 9px;
      }


      .stat-icon {

        width:
          31px;

        height:
          31px;

        flex-basis:
          31px;
      }


      .stat span {

        font-size:
          8px;
      }


      .stat strong {

        max-width:
          100px;

        font-size:
          9px;
      }


      .info-section,
      .how-section,
      .faq-section {

        padding:
          50px 0;
      }

    }

  </style>

</body>
</html>
