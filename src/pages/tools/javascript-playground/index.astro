---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "JavaScript Playground - تشغيل JavaScript أونلاين مجاناً | Th.Tech";

const description =
  "JavaScript Playground مجانية لتجربة وتشغيل أكواد JavaScript مباشرة من المتصفح مع عرض النتائج والأخطاء.";

const faqs = [
  {
    q: "ما هو JavaScript Playground؟",
    a: "أداة تفاعلية تسمح لك بكتابة وتشغيل JavaScript مباشرة من المتصفح ومشاهدة النتائج فوراً."
  },
  {
    q: "هل أحتاج إلى تثبيت JavaScript؟",
    a: "لا. يتم تشغيل JavaScript بواسطة المتصفح مباشرة، ولا تحتاج إلى تثبيت أي برنامج إضافي."
  },
  {
    q: "هل يمكن استخدام console.log؟",
    a: "نعم. يمكنك استخدام console.log وconsole.warn وconsole.error وستظهر المخرجات داخل قسم النتائج."
  },
  {
    q: "هل الكود الخاص بي يُرسل إلى الخادم؟",
    a: "لا. يتم تنفيذ الكود داخل المتصفح، ولا تحتاج الأداة إلى إرسال الكود إلى خادم خارجي."
  }
];
---

<!doctype html>
<html lang="ar" dir="rtl">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="icon" href={`${base}/logo1.png`} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  />

  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem('theme');

        if (saved === 'dark') {
          document.documentElement.classList.add('dark-mode');
        } else {
          document.documentElement.classList.remove('dark-mode');
        }
      } catch {}
    })();
  </script>
</head>

<body>

  <Header />

  <main>

    <!-- HERO -->
    <section class="hero">
      <div class="container">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fa-solid fa-chevron-left"></i>
          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fa-solid fa-chevron-left"></i>
          <span>JavaScript Playground</span>
        </div>

        <div class="hero-content">

          <div class="hero-icon">
            <i class="fa-brands fa-js"></i>
          </div>

          <div class="hero-label">
            <i class="fa-solid fa-code"></i>
            JavaScript
          </div>

          <h1>
            JavaScript
            <span>Playground</span>
          </h1>

          <p>
            جرّب وشغّل أكواد JavaScript مباشرة من المتصفح
            مع عرض النتائج والأخطاء بسهولة.
          </p>

        </div>

      </div>
    </section>


    <!-- TOOL -->
    <section class="tool-section">
      <div class="container">

        <div class="tool-card">

          <!-- TOOL HEADER -->
          <div class="tool-header">

            <div class="tool-title">

              <div class="tool-title-icon">
                <i class="fa-brands fa-js"></i>
              </div>

              <div>
                <h2>JavaScript Playground</h2>
                <p>اكتب الكود وشغّله مباشرة</p>
              </div>

            </div>

            <div class="tool-actions">

              <button id="exampleBtn" class="btn btn-secondary">
                <i class="fa-solid fa-lightbulb"></i>
                مثال
              </button>

              <button id="clearBtn" class="btn btn-secondary">
                <i class="fa-solid fa-trash"></i>
                مسح
              </button>

              <button id="runBtn" class="btn btn-primary">
                <i class="fa-solid fa-play"></i>
                تشغيل
              </button>

            </div>

          </div>


          <!-- EDITOR -->
          <div class="workspace">

            <div class="editor-box">

              <div class="box-header">

                <div class="box-title">
                  <span class="dot js"></span>
                  JavaScript
                </div>

                <div id="lineCount">
                  1 سطر
                </div>

              </div>


              <div class="editor">

                <div id="lineNumbers" class="line-numbers">1</div>

                <textarea
                  id="codeInput"
                  spellcheck="false"
                  autocomplete="off"
                  autocorrect="off"
                  autocapitalize="off"
                  aria-label="JavaScript code editor"
                >const name = "Th.Tech";

console.log("مرحباً بك في " + name);

const numbers = [10, 20, 30, 40, 50];

const total = numbers.reduce(
  (sum, number) => sum + number,
  0
);

console.log("المجموع:", total);</textarea>

              </div>


              <div class="editor-footer">

                <span>
                  <i class="fa-brands fa-js"></i>
                  JavaScript
                </span>

                <span id="charCount">
                  0 حرف
                </span>

              </div>

            </div>


            <!-- OUTPUT -->
            <div class="output-box">

              <div class="box-header">

                <div class="box-title">
                  <span class="dot output"></span>
                  النتائج
                </div>

                <button id="clearOutput" class="clear-output">
                  <i class="fa-solid fa-eraser"></i>
                  مسح
                </button>

              </div>


              <div id="output" class="output">

                <div class="output-empty">

                  <div class="empty-icon">
                    <i class="fa-solid fa-terminal"></i>
                  </div>

                  <strong>لا توجد نتائج بعد</strong>

                  <span>
                    اضغط على "تشغيل" لتنفيذ الكود
                  </span>

                </div>

              </div>


              <div class="output-footer">

                <span id="status">
                  <i class="fa-solid fa-circle"></i>
                  جاهز
                </span>

                <span id="executionTime">
                  0 ms
                </span>

              </div>

            </div>

          </div>


          <!-- STATS -->
          <div class="stats">

            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-bolt"></i>
              </div>

              <div>
                <strong>تشغيل فوري</strong>
                <span>داخل المتصفح</span>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-terminal"></i>
              </div>

              <div>
                <strong>Console</strong>
                <span>عرض المخرجات</span>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-triangle-exclamation"></i>
              </div>

              <div>
                <strong>كشف الأخطاء</strong>
                <span>رسائل واضحة</span>
              </div>

            </div>


            <div class="stat">

              <div class="stat-icon">
                <i class="fa-solid fa-shield-halved"></i>
              </div>

              <div>
                <strong>محلي</strong>
                <span>بدون خادم</span>
              </div>

            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- INFORMATION -->
    <section class="information">
      <div class="container">

        <div class="section-heading">

          <div class="section-label">
            <i class="fa-solid fa-circle-info"></i>
            حول الأداة
          </div>

          <h2>
            جرّب JavaScript
            <span>بسهولة</span>
          </h2>

          <p>
            بيئة تفاعلية بسيطة وسريعة لتجربة أكواد JavaScript
            واختبار الأفكار البرمجية مباشرة من المتصفح.
          </p>

        </div>


        <div class="info-grid">

          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-code"></i>
            </div>

            <h3>محرر JavaScript</h3>

            <p>
              اكتب وعدّل كود JavaScript بسهولة داخل محرر
              يدعم ترقيم الأسطر والتنسيق المناسب للكود.
            </p>

          </article>


          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-play"></i>
            </div>

            <h3>تشغيل مباشر</h3>

            <p>
              نفّذ الكود مباشرة من المتصفح وشاهد النتائج
              بدون الحاجة إلى إعداد بيئة تطوير كاملة.
            </p>

          </article>


          <article class="info-card">

            <div class="info-icon">
              <i class="fa-solid fa-terminal"></i>
            </div>

            <h3>عرض النتائج</h3>

            <p>
              تظهر مخرجات console والرسائل التحذيرية
              والأخطاء داخل نافذة نتائج مخصصة.
            </p>

          </article>

        </div>

      </div>
    </section>


    <!-- HOW TO -->
    <section class="how-to">
      <div class="container">

        <div class="section-heading">

          <div class="section-label">
            <i class="fa-solid fa-list-check"></i>
            طريقة الاستخدام
          </div>

          <h2>
            كيف تستخدم
            <span>الأداة؟</span>
          </h2>

        </div>


        <div class="steps">

          <div class="step">

            <div class="step-number">
              1
            </div>

            <div>
              <h3>اكتب الكود</h3>

              <p>
                اكتب كود JavaScript الذي تريد تجربته
                داخل محرر الكود.
              </p>
            </div>

          </div>


          <div class="step">

            <div class="step-number">
              2
            </div>

            <div>
              <h3>شغّل الكود</h3>

              <p>
                اضغط على زر "تشغيل" أو استخدم
                الاختصار Ctrl + Enter.
              </p>
            </div>

          </div>


          <div class="step">

            <div class="step-number">
              3
            </div>

            <div>
              <h3>شاهد النتيجة</h3>

              <p>
                ستظهر المخرجات والأخطاء في قسم النتائج
                مباشرة.
              </p>
            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- FAQ -->
    <section class="faq">
      <div class="container">

        <div class="section-heading">

          <div class="section-label">
            <i class="fa-solid fa-circle-question"></i>
            الأسئلة الشائعة
          </div>

          <h2>
            أسئلة حول
            <span>JavaScript Playground</span>
          </h2>

        </div>


        <div class="faq-list">

          {faqs.map((faq) => (
            <details class="faq-item">

              <summary>
                <span>{faq.q}</span>

                <i class="fa-solid fa-chevron-down"></i>
              </summary>

              <p>{faq.a}</p>

            </details>
          ))}

        </div>

      </div>
    </section>

  </main>

  <Footer />


  <style>

    :global(*) {
      box-sizing: border-box;
    }

    :global(html) {
      scroll-behavior: smooth;
    }

    :global(body) {
      margin: 0;
      font-family: "Cairo", sans-serif;
      background: var(--bg);
      color: var(--text);
      transition:
        background .25s ease,
        color .25s ease;
    }

    :global(button),
    :global(textarea) {
      font-family: inherit;
    }


    :root {
      --bg: #f8fafc;
      --bg2: #f1f5f9;
      --card: #ffffff;
      --card2: #f8fafc;

      --text: #0f172a;
      --muted: #64748b;

      --primary: #2563eb;
      --primary-hover: #1d4ed8;

      --cyan: #0891b2;
      --green: #16a34a;
      --red: #dc2626;

      --border: rgba(15, 23, 42, .09);

      --shadow:
        0 20px 60px rgba(15, 23, 42, .08);

      --code-bg: #0b1220;
      --code-text: #e2e8f0;
    }


    :global(.dark-mode) {

      --bg: #07101f;
      --bg2: #0b1426;
      --card: #111d32;
      --card2: #0d1729;

      --text: #f8fafc;
      --muted: #94a3b8;

      --primary: #3b82f6;
      --primary-hover: #2563eb;

      --cyan: #06b6d4;
      --green: #22c55e;
      --red: #ef4444;

      --border: rgba(148, 163, 184, .12);

      --shadow:
        0 20px 60px rgba(0, 0, 0, .28);

      --code-bg: #07101d;
      --code-text: #e2e8f0;
    }


    .container {
      width: min(1120px, calc(100% - 32px));
      margin-inline: auto;
    }


    /* HERO */

    .hero {
      padding: 32px 0 48px;

      background:
        radial-gradient(
          circle at 20% 20%,
          rgba(37, 99, 235, .08),
          transparent 32%
        ),
        radial-gradient(
          circle at 80% 20%,
          rgba(8, 145, 178, .07),
          transparent 32%
        );
    }


    .breadcrumb {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;

      color: var(--muted);

      font-size: 12px;

      margin-bottom: 28px;
    }


    .breadcrumb a {
      color: var(--muted);
      text-decoration: none;
      transition: color .2s ease;
    }


    .breadcrumb a:hover {
      color: var(--primary);
    }


    .breadcrumb i {
      font-size: 8px;
      opacity: .6;
    }


    .hero-content {
      max-width: 720px;
      margin-inline: auto;
      text-align: center;
    }


    .hero-icon {
      width: 70px;
      height: 70px;

      margin: 0 auto 16px;

      display: grid;
      place-items: center;

      border-radius: 20px;

      color: #facc15;

      background: rgba(37, 99, 235, .09);

      border: 1px solid rgba(37, 99, 235, .13);

      font-size: 34px;

      box-shadow: var(--shadow);
    }


    .hero-label,
    .section-label {
      display: inline-flex;
      align-items: center;
      gap: 7px;

      color: var(--primary);

      font-size: 12px;
      font-weight: 800;
    }


    .hero-label {
      margin-bottom: 8px;
    }


    .hero h1 {
      margin: 0;

      font-size: clamp(31px, 5vw, 50px);

      line-height: 1.2;

      font-weight: 800;

      letter-spacing: -.8px;
    }


    .hero h1 span,
    .section-heading h2 span {
      color: var(--primary);
    }


    .hero p {
      max-width: 620px;

      margin: 13px auto 0;

      color: var(--muted);

      font-size: 14px;

      line-height: 1.9;
    }


    /* TOOL */

    .tool-section {
      padding-bottom: 70px;
    }


    .tool-card {
      overflow: hidden;

      background: var(--card);

      border: 1px solid var(--border);

      border-radius: 22px;

      box-shadow: var(--shadow);
    }


    .tool-header {
      min-height: 76px;

      padding: 13px 16px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 15px;

      border-bottom: 1px solid var(--border);

      background: var(--card2);
    }


    .tool-title {
      display: flex;
      align-items: center;
      gap: 11px;
    }


    .tool-title-icon {
      width: 40px;
      height: 40px;

      display: grid;
      place-items: center;

      border-radius: 11px;

      color: #facc15;

      background: rgba(37, 99, 235, .1);
    }


    .tool-title h2 {
      margin: 0;

      font-size: 14px;
      font-weight: 800;
    }


    .tool-title p {
      margin: 2px 0 0;

      color: var(--muted);

      font-size: 10px;
    }


    .tool-actions {
      display: flex;
      gap: 7px;
    }


    .btn {
      min-height: 40px;

      padding: 0 14px;

      display: inline-flex;
      align-items: center;
      justify-content: center;

      gap: 7px;

      border-radius: 10px;

      font-size: 12px;
      font-weight: 700;

      cursor: pointer;

      transition:
        transform .2s ease,
        background .2s ease;
    }


    .btn:hover {
      transform: translateY(-1px);
    }


    .btn-primary {
      color: white;

      background: var(--primary);

      border: 1px solid var(--primary);
    }


    .btn-primary:hover {
      background: var(--primary-hover);
    }


    .btn-secondary {
      color: var(--text);

      background: var(--bg2);

      border: 1px solid var(--border);
    }


    .btn-secondary:hover {
      background: var(--card);
    }


    /* WORKSPACE */

    .workspace {
      padding: 15px;

      display: grid;

      grid-template-columns: 1fr 1fr;

      gap: 14px;

      background: var(--bg2);
    }


    .editor-box,
    .output-box {
      overflow: hidden;

      border-radius: 15px;

      background: var(--code-bg);

      border: 1px solid rgba(148, 163, 184, .14);
    }


    .box-header {
      height: 45px;

      padding: 0 13px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      color: #cbd5e1;

      border-bottom: 1px solid rgba(148, 163, 184, .1);

      background: rgba(255,255,255,.025);

      font-size: 11px;
    }


    .box-title {
      display: flex;
      align-items: center;
      gap: 8px;

      font-weight: 700;
    }


    .dot {
      width: 8px;
      height: 8px;

      border-radius: 50%;
    }


    .dot.js {
      background: #facc15;
    }


    .dot.output {
      background: #22c55e;
    }


    .editor {
      height: 365px;

      display: flex;

      direction: ltr;

      overflow: hidden;
    }


    .line-numbers {
      width: 45px;

      flex: 0 0 45px;

      padding: 15px 8px;

      color: #64748b;

      text-align: right;

      white-space: pre;

      overflow: hidden;

      border-right: 1px solid rgba(148,163,184,.09);

      background: rgba(255,255,255,.018);

      font:
        13px/1.75
        Consolas,
        monospace;
    }


    #codeInput {
      width: 100%;
      height: 100%;

      flex: 1;

      padding: 15px;

      resize: none;

      border: 0;
      outline: 0;

      background: transparent;

      color: var(--code-text);

      direction: ltr;

      text-align: left;

      white-space: pre;

      tab-size: 2;

      overflow: auto;

      font:
        13px/1.75
        Consolas,
        "Courier New",
        monospace;
    }


    #codeInput::selection {
      background: rgba(59,130,246,.25);
    }


    .editor-footer,
    .output-footer {
      height: 36px;

      padding: 0 12px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      color: #94a3b8;

      border-top: 1px solid rgba(148,163,184,.09);

      background: rgba(255,255,255,.018);

      font-size: 9px;
    }


    .editor-footer span,
    .output-footer span {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }


    .output {
      height: 365px;

      padding: 15px;

      overflow: auto;

      direction: ltr;

      text-align: left;

      color: var(--code-text);

      font:
        13px/1.7
        Consolas,
        monospace;
    }


    .output-empty {
      height: 100%;

      display: flex;

      flex-direction: column;

      align-items: center;
      justify-content: center;

      gap: 7px;

      color: #64748b;

      text-align: center;
    }


    .output-empty strong {
      color: #cbd5e1;

      font-size: 12px;
    }


    .output-empty span {
      font-size: 10px;
    }


    .empty-icon {
      width: 48px;
      height: 48px;

      margin-bottom: 4px;

      display: grid;
      place-items: center;

      border-radius: 13px;

      color: #60a5fa;

      background: rgba(37,99,235,.1);

      font-size: 18px;
    }


    .clear-output {
      padding: 5px 8px;

      border: 0;

      border-radius: 7px;

      color: #94a3b8;

      background: transparent;

      cursor: pointer;

      font-size: 10px;
    }


    .clear-output:hover {
      color: white;

      background: rgba(255,255,255,.07);
    }


    .console-line {
      margin-bottom: 7px;

      padding: 8px 10px;

      border-radius: 7px;

      white-space: pre-wrap;

      word-break: break-word;

      background: rgba(255,255,255,.035);
    }


    .console-line.log {
      color: #e2e8f0;
    }


    .console-line.warn {
      color: #fbbf24;

      background: rgba(251,191,36,.06);
    }


    .console-line.error {
      color: #f87171;

      background: rgba(239,68,68,.07);
    }


    .console-prefix {
      margin-right: 8px;

      color: #64748b;

      font-size: 9px;
    }


    /* STATS */

    .stats {
      display: grid;

      grid-template-columns: repeat(4, 1fr);

      background: var(--border);
    }


    .stat {
      min-height: 72px;

      padding: 13px;

      display: flex;
      align-items: center;

      gap: 10px;

      background: var(--card);
    }


    .stat-icon {
      width: 35px;
      height: 35px;

      flex: 0 0 35px;

      display: grid;
      place-items: center;

      border-radius: 10px;

      color: var(--primary);

      background: rgba(37,99,235,.09);

      font-size: 13px;
    }


    .stat strong {
      display: block;

      font-size: 11px;
    }


    .stat span {
      display: block;

      margin-top: 2px;

      color: var(--muted);

      font-size: 9px;
    }


    /* SECTIONS */

    .information,
    .how-to,
    .faq {
      padding: 75px 0;
    }


    .information {
      background: var(--bg2);
    }


    .section-heading {
      max-width: 680px;

      margin: 0 auto 32px;

      text-align: center;
    }


    .section-label {
      margin-bottom: 7px;
    }


    .section-heading h2 {
      margin: 0;

      font-size: clamp(24px, 4vw, 34px);

      line-height: 1.35;
    }


    .section-heading p {
      max-width: 600px;

      margin: 10px auto 0;

      color: var(--muted);

      font-size: 13px;

      line-height: 1.9;
    }


    .info-grid {
      display: grid;

      grid-template-columns: repeat(3, 1fr);

      gap: 17px;
    }


    .info-card {
      padding: 23px;

      background: var(--card);

      border: 1px solid var(--border);

      border-radius: 17px;

      box-shadow: var(--shadow);
    }


    .info-icon {
      width: 45px;
      height: 45px;

      margin-bottom: 15px;

      display: grid;
      place-items: center;

      border-radius: 12px;

      color: var(--primary);

      background: rgba(37,99,235,.09);

      font-size: 17px;
    }


    .info-card h3 {
      margin: 0 0 7px;

      font-size: 15px;
    }


    .info-card p {
      margin: 0;

      color: var(--muted);

      font-size: 12px;

      line-height: 1.85;
    }


    /* STEPS */

    .steps {
      max-width: 850px;

      margin-inline: auto;

      display: grid;

      grid-template-columns: repeat(3, 1fr);

      gap: 17px;
    }


    .step {
      padding: 21px;

      display: flex;

      gap: 12px;

      background: var(--card);

      border: 1px solid var(--border);

      border-radius: 17px;
    }


    .step-number {
      width: 36px;
      height: 36px;

      flex: 0 0 36px;

      display: grid;
      place-items: center;

      border-radius: 10px;

      color: white;

      background: var(--primary);

      font-size: 12px;

      font-weight: 800;
    }


    .step h3 {
      margin: 0 0 5px;

      font-size: 13px;
    }


    .step p {
      margin: 0;

      color: var(--muted);

      font-size: 10px;

      line-height: 1.8;
    }


    /* FAQ */

    .faq-list {
      max-width: 850px;

      margin-inline: auto;

      display: grid;

      gap: 9px;
    }


    .faq-item {
      overflow: hidden;

      background: var(--card);

      border: 1px solid var(--border);

      border-radius: 14px;
    }


    .faq-item summary {
      padding: 16px 18px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 15px;

      cursor: pointer;

      list-style: none;

      font-size: 12px;

      font-weight: 700;
    }


    .faq-item summary::-webkit-details-marker {
      display: none;
    }


    .faq-item summary i {
      color: var(--muted);

      font-size: 10px;

      transition: transform .2s ease;
    }


    .faq-item[open] summary i {
      transform: rotate(180deg);
    }


    .faq-item p {
      margin: 0;

      padding: 0 18px 17px;

      color: var(--muted);

      font-size: 11px;

      line-height: 1.9;
    }


    /* RESPONSIVE */

    @media (max-width: 850px) {

      .workspace {
        grid-template-columns: 1fr;
      }

      .info-grid {
        grid-template-columns: 1fr;
      }

      .steps {
        grid-template-columns: 1fr;
      }

    }


    @media (max-width: 650px) {

      .container {
        width: min(100% - 20px, 1120px);
      }


      .hero {
        padding-top: 22px;
        padding-bottom: 38px;
      }


      .breadcrumb {
        font-size: 10px;

        margin-bottom: 22px;
      }


      .hero-icon {
        width: 62px;
        height: 62px;

        border-radius: 17px;

        font-size: 29px;
      }


      .hero p {
        font-size: 12px;
      }


      .tool-header {
        flex-direction: column;

        align-items: stretch;
      }


      .tool-actions {
        display: grid;

        grid-template-columns: 1fr 1fr;
      }


      .btn-primary {
        grid-column: 1 / -1;
      }


      .workspace {
        padding: 10px;

        gap: 10px;
      }


      .editor,
      .output {
        height: 315px;
      }


      .stats {
        grid-template-columns: 1fr 1fr;
      }


      .stat {
        min-height: 65px;
      }


      .information,
      .how-to,
      .faq {
        padding: 58px 0;
      }


      .section-heading {
        margin-bottom: 25px;
      }

    }

  </style>


  <script is:inline>
    (() => {

      const codeInput = document.getElementById("codeInput");
      const output = document.getElementById("output");

      const runBtn = document.getElementById("runBtn");
      const clearBtn = document.getElementById("clearBtn");

      const exampleBtn = document.getElementById("exampleBtn");
      const clearOutput = document.getElementById("clearOutput");

      const lineNumbers = document.getElementById("lineNumbers");
      const lineCount = document.getElementById("lineCount");
      const charCount = document.getElementById("charCount");

      const status = document.getElementById("status");
      const executionTime = document.getElementById("executionTime");


      const exampleCode = `const name = "Th.Tech";

console.log("مرحباً بك في " + name);

const numbers = [10, 20, 30, 40, 50];

const total = numbers.reduce(
  (sum, number) => sum + number,
  0
);

console.log("المجموع:", total);`;


      function updateStats() {

        const code = codeInput.value;

        const lines = code.split("\\n").length;

        lineNumbers.textContent =
          Array.from(
            { length: Math.max(lines, 1) },
            (_, index) => index + 1
          ).join("\\n");


        lineCount.textContent =
          `${lines} ${lines === 1 ? "سطر" : "أسطر"}`;


        charCount.textContent =
          `${code.length.toLocaleString("ar-MA")} حرف`;

      }


      function setStatus(text, type = "ready") {

        const colors = {
          ready: "#94a3b8",
          running: "#60a5fa",
          success: "#4ade80",
          error: "#f87171"
        };


        status.style.color =
          colors[type] || colors.ready;


        status.innerHTML =
          `<i class="fa-solid fa-circle"></i> ${text}`;

      }


      function escapeHtml(value) {

        return String(value)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#039;");

      }


      function formatValue(value) {

        if (typeof value === "string") {
          return value;
        }


        if (typeof value === "undefined") {
          return "undefined";
        }


        if (value instanceof Error) {
          return value.stack || value.message;
        }


        if (typeof value === "function") {
          return value.toString();
        }


        try {

          const result =
            JSON.stringify(value, null, 2);

          return result === undefined
            ? String(value)
            : result;

        } catch {

          return String(value);

        }

      }


      function addOutput(type, values) {

        const line =
          document.createElement("div");

        line.className =
          `console-line ${type}`;


        const prefix =
          type === "error"
            ? "ERROR"
            : type === "warn"
              ? "WARN"
              : "LOG";


        const content =
          values
            .map(formatValue)
            .join(" ");


        line.innerHTML =
          `<span class="console-prefix">[${prefix}]</span>${escapeHtml(content)}`;


        output.appendChild(line);

        output.scrollTop =
          output.scrollHeight;

      }


      function resetOutput() {

        output.innerHTML = `
          <div class="output-empty">

            <div class="empty-icon">
              <i class="fa-solid fa-terminal"></i>
            </div>

            <strong>لا توجد نتائج بعد</strong>

            <span>
              اضغط على "تشغيل" لتنفيذ الكود
            </span>

          </div>
        `;


        executionTime.textContent = "0 ms";

        setStatus("جاهز", "ready");

      }


      function runCode() {

        const code =
          codeInput.value.trim();


        if (!code) {

          output.innerHTML = `
            <div class="console-line warn">
              <span class="console-prefix">[WARN]</span>
              اكتب كود JavaScript أولاً.
            </div>
          `;

          setStatus("لا يوجد كود", "error");

          return;
        }


        output.innerHTML = "";

        setStatus("جاري التشغيل...", "running");


        const start =
          performance.now();


        const originalLog =
          console.log;

        const originalWarn =
          console.warn;

        const originalError =
          console.error;


        let hasError = false;


        const restoreConsole = () => {

          console.log = originalLog;
          console.warn = originalWarn;
          console.error = originalError;

        };


        console.log = (...args) => {

          addOutput("log", args);

          originalLog(...args);

        };


        console.warn = (...args) => {

          addOutput("warn", args);

          originalWarn(...args);

        };


        console.error = (...args) => {

          addOutput("error", args);

          originalError(...args);

        };


        try {

          const result =
            Function(
              `"use strict";\\n${code}`
            )();


          if (typeof result !== "undefined") {
            addOutput("log", [result]);
          }

        } catch (error) {

          hasError = true;

          addOutput(
            "error",
            [
              error && error.stack
                ? error.stack
                : String(error)
            ]
          );

        } finally {

          restoreConsole();

        }


        const elapsed =
          performance.now() - start;


        executionTime.textContent =
          `${elapsed.toFixed(2)} ms`;


        if (hasError) {

          setStatus("حدث خطأ", "error");

        } else {

          setStatus(
            "تم التنفيذ بنجاح",
            "success"
          );

        }


        if (!output.children.length) {

          addOutput(
            "log",
            ["تم تنفيذ الكود بنجاح بدون مخرجات."]
          );

        }

      }


      codeInput.addEventListener(
        "input",
        updateStats
      );


      codeInput.addEventListener(
        "scroll",
        () => {

          lineNumbers.scrollTop =
            codeInput.scrollTop;

        }
      );


      codeInput.addEventListener(
        "keydown",
        (event) => {

          if (event.key === "Tab") {

            event.preventDefault();

            const start =
              codeInput.selectionStart;

            const end =
              codeInput.selectionEnd;


            codeInput.value =
              codeInput.value.substring(0, start) +
              "  " +
              codeInput.value.substring(end);


            codeInput.selectionStart =
              start + 2;

            codeInput.selectionEnd =
              start + 2;


            updateStats();

          }


          if (
            (event.ctrlKey || event.metaKey) &&
            event.key === "Enter"
          ) {

            event.preventDefault();

            runCode();

          }

        }
      );


      runBtn.addEventListener(
        "click",
        runCode
      );


      clearBtn.addEventListener(
        "click",
        () => {

          codeInput.value = "";

          updateStats();

          resetOutput();

          codeInput.focus();

        }
      );


      exampleBtn.addEventListener(
        "click",
        () => {

          codeInput.value =
            exampleCode;

          updateStats();

          resetOutput();

          codeInput.focus();

        }
      );


      clearOutput.addEventListener(
        "click",
        resetOutput
      );


      updateStats();

    })();
  </script>

</body>
</html>
