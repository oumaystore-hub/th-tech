---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "JavaScript Playground - محرر JavaScript أونلاين مجاناً | Th.Tech";
const description =
  "JavaScript Playground مجاني لتجربة وتشغيل أكواد JavaScript مباشرة من المتصفح مع عرض النتائج والأخطاء بسهولة.";

const faqs = [
  {
    q: "ما هو JavaScript Playground؟",
    a: "هو محرر تفاعلي يسمح لك بكتابة وتشغيل كود JavaScript مباشرة من المتصفح دون الحاجة إلى تثبيت برامج إضافية."
  },
  {
    q: "هل يتم إرسال الكود إلى الخادم؟",
    a: "لا. يتم تشغيل JavaScript مباشرة داخل المتصفح، لذلك لا تحتاج إلى رفع الكود إلى خادم خارجي."
  },
  {
    q: "هل يمكن استخدام console.log؟",
    a: "نعم. يمكنك استخدام console.log وconsole.error وconsole.warn، وستظهر النتائج في نافذة الإخراج."
  },
  {
    q: "هل الأداة مجانية؟",
    a: "نعم، JavaScript Playground متاح مجاناً للاستخدام من المتصفح."
  }
];
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" href={`${base}/logo1.png`} />

    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme');

          if (saved === 'dark') {
            document.documentElement.classList.add('dark-mode');
          } else {
            document.documentElement.classList.remove('dark-mode');
          }
        } catch {}
      })();
    </script>
  </head>

  <body>
    <Header />

    <main class="playground-page">

      <!-- HERO -->
      <section class="hero">
        <div class="container">

          <div class="breadcrumb">
            <a href={`${base}/`}>الرئيسية</a>
            <i class="fa-solid fa-chevron-left"></i>
            <a href={`${base}/tools/`}>الأدوات</a>
            <i class="fa-solid fa-chevron-left"></i>
            <span>JavaScript Playground</span>
          </div>

          <div class="hero-content">

            <div class="hero-icon">
              <i class="fa-brands fa-js"></i>
            </div>

            <div class="hero-kicker">
              <i class="fa-solid fa-code"></i>
              JavaScript Tool
            </div>

            <h1>
              JavaScript
              <span>Playground</span>
            </h1>

            <p>
              اكتب وجرب وشغّل أكواد JavaScript مباشرة من المتصفح
              مع عرض النتائج والأخطاء في الوقت الحقيقي.
            </p>

          </div>
        </div>
      </section>

      <!-- TOOL -->
      <section class="tool-section">
        <div class="container">

          <div class="tool-card">

            <!-- TOOLBAR -->
            <div class="toolbar">

              <div class="toolbar-title">
                <div class="toolbar-icon">
                  <i class="fa-brands fa-js"></i>
                </div>

                <div>
                  <strong>JavaScript Playground</strong>
                  <small>تشغيل JavaScript مباشرة</small>
                </div>
              </div>

              <div class="toolbar-actions">

                <button id="exampleBtn" class="tool-btn secondary">
                  <i class="fa-solid fa-wand-magic-sparkles"></i>
                  مثال
                </button>

                <button id="clearBtn" class="tool-btn secondary">
                  <i class="fa-solid fa-trash-can"></i>
                  مسح
                </button>

                <button id="runBtn" class="tool-btn primary">
                  <i class="fa-solid fa-play"></i>
                  تشغيل الكود
                </button>

              </div>
            </div>

            <!-- WORKSPACE -->
            <div class="workspace">

              <!-- EDITOR -->
              <div class="panel editor-panel">

                <div class="panel-header">

                  <div class="panel-title">
                    <span class="panel-dot js-dot"></span>
                    <span>JavaScript</span>
                  </div>

                  <div class="panel-tools">
                    <span id="lineCount">1 سطر</span>
                  </div>

                </div>

                <div class="editor-wrap">

                  <div id="lineNumbers" class="line-numbers">1</div>

                  <textarea
                    id="codeInput"
                    spellcheck="false"
                    autocomplete="off"
                    autocapitalize="off"
                    placeholder="// اكتب كود JavaScript هنا..."
                  >const name = "Th.Tech";

console.log("مرحباً بك في " + name);

const numbers = [10, 20, 30, 40, 50];
const total = numbers.reduce((sum, n) => sum + n, 0);

console.log("المجموع:", total);</textarea>

                </div>

                <div class="editor-footer">
                  <span>
                    <i class="fa-solid fa-keyboard"></i>
                    JavaScript
                  </span>

                  <span id="charCount">0 حرف</span>
                </div>

              </div>

              <!-- OUTPUT -->
              <div class="panel output-panel">

                <div class="panel-header">

                  <div class="panel-title">
                    <span class="panel-dot output-dot"></span>
                    <span>Output</span>
                  </div>

                  <button id="clearOutput" class="mini-btn">
                    <i class="fa-solid fa-eraser"></i>
                    مسح
                  </button>

                </div>

                <div id="output" class="output">
                  <div class="empty-output">
                    <div class="empty-icon">
                      <i class="fa-solid fa-terminal"></i>
                    </div>

                    <strong>لا توجد نتائج بعد</strong>

                    <span>
                      اضغط على "تشغيل الكود" لعرض النتيجة هنا
                    </span>
                  </div>
                </div>

                <div class="output-footer">
                  <span id="status">
                    <i class="fa-solid fa-circle"></i>
                    جاهز
                  </span>

                  <span id="executionTime">0 ms</span>
                </div>

              </div>

            </div>

            <!-- QUICK INFO -->
            <div class="quick-info">

              <div class="info-item">
                <i class="fa-solid fa-bolt"></i>
                <div>
                  <strong>تشغيل مباشر</strong>
                  <span>داخل المتصفح</span>
                </div>
              </div>

              <div class="info-item">
                <i class="fa-solid fa-shield-halved"></i>
                <div>
                  <strong>محلي</strong>
                  <span>لا حاجة لخادم</span>
                </div>
              </div>

              <div class="info-item">
                <i class="fa-solid fa-terminal"></i>
                <div>
                  <strong>Console</strong>
                  <span>عرض النتائج والأخطاء</span>
                </div>
              </div>

              <div class="info-item">
                <i class="fa-solid fa-mobile-screen-button"></i>
                <div>
                  <strong>Responsive</strong>
                  <span>هاتف وكمبيوتر</span>
                </div>
              </div>

            </div>

          </div>

        </div>
      </section>

      <!-- INFO -->
      <section class="info-section">
        <div class="container">

          <div class="section-heading">
            <span class="section-kicker">
              <i class="fa-solid fa-circle-info"></i>
              حول الأداة
            </span>

            <h2>
              جرّب JavaScript
              <span>بسهولة</span>
            </h2>

            <p>
              بيئة بسيطة وسريعة لتجربة أكواد JavaScript واختبار الأفكار
              البرمجية مباشرة من المتصفح.
            </p>
          </div>

          <div class="info-grid">

            <article class="info-card">
              <div class="info-card-icon">
                <i class="fa-solid fa-code"></i>
              </div>

              <h3>محرر JavaScript</h3>

              <p>
                اكتب الكود البرمجي داخل المحرر مع ترقيم الأسطر
                وحساب عدد الأحرف والأسطر.
              </p>
            </article>

            <article class="info-card">
              <div class="info-card-icon">
                <i class="fa-solid fa-play"></i>
              </div>

              <h3>تشغيل فوري</h3>

              <p>
                شغّل الكود مباشرة باستخدام زر واحد وشاهد النتيجة
                بدون الحاجة إلى إعداد بيئة تطوير.
              </p>
            </article>

            <article class="info-card">
              <div class="info-card-icon">
                <i class="fa-solid fa-triangle-exclamation"></i>
              </div>

              <h3>كشف الأخطاء</h3>

              <p>
                عند وجود خطأ في الكود، يتم عرض رسالة الخطأ داخل
                نافذة النتائج لتسهيل اكتشاف المشكلة.
              </p>
            </article>

          </div>

        </div>
      </section>

      <!-- HOW TO -->
      <section class="how-section">
        <div class="container">

          <div class="section-heading">
            <span class="section-kicker">
              <i class="fa-solid fa-list-check"></i>
              طريقة الاستخدام
            </span>

            <h2>
              كيف تستخدم
              <span>الأداة؟</span>
            </h2>
          </div>

          <div class="steps">

            <div class="step">
              <div class="step-number">1</div>

              <div>
                <h3>اكتب الكود</h3>
                <p>
                  أدخل كود JavaScript الذي تريد اختباره داخل المحرر.
                </p>
              </div>
            </div>

            <div class="step">
              <div class="step-number">2</div>

              <div>
                <h3>اضغط تشغيل</h3>
                <p>
                  اضغط على زر "تشغيل الكود" لتنفيذ الكود مباشرة.
                </p>
              </div>
            </div>

            <div class="step">
              <div class="step-number">3</div>

              <div>
                <h3>راجع النتيجة</h3>
                <p>
                  ستظهر نتائج console والرسائل والأخطاء في نافذة Output.
                </p>
              </div>
            </div>

          </div>

        </div>
      </section>

      <!-- FAQ -->
      <section class="faq-section">
        <div class="container">

          <div class="section-heading">
            <span class="section-kicker">
              <i class="fa-solid fa-circle-question"></i>
              الأسئلة الشائعة
            </span>

            <h2>
              أسئلة حول
              <span>JavaScript Playground</span>
            </h2>
          </div>

          <div class="faq-list">

            {faqs.map((faq) => (
              <details class="faq-item">
                <summary>
                  <span>{faq.q}</span>
                  <i class="fa-solid fa-chevron-down"></i>
                </summary>

                <p>{faq.a}</p>
              </details>
            ))}

          </div>

        </div>
      </section>

    </main>

    <Footer />

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        scroll-behavior: smooth;
      }

      :global(body) {
        margin: 0;
        font-family: "Cairo", sans-serif;
        background: var(--bg);
        color: var(--text);
        transition:
          background 0.25s ease,
          color 0.25s ease;
      }

      :global(button),
      :global(textarea) {
        font-family: inherit;
      }

      :root {
        --bg: #f8fafc;
        --bg2: #f1f5f9;
        --card: #ffffff;
        --card2: #f8fafc;
        --text: #0f172a;
        --muted: #64748b;
        --primary: #2563eb;
        --primary-hover: #1d4ed8;
        --cyan: #0891b2;
        --green: #16a34a;
        --red: #dc2626;
        --orange: #ea580c;
        --border: rgba(15, 23, 42, 0.09);
        --shadow: 0 20px 60px rgba(15, 23, 42, 0.08);
        --code-bg: #0b1220;
        --code-text: #e2e8f0;
      }

      :global(.dark-mode) {
        --bg: #07101f;
        --bg2: #0b1426;
        --card: #111d32;
        --card2: #0d1729;
        --text: #f8fafc;
        --muted: #94a3b8;
        --primary: #3b82f6;
        --primary-hover: #2563eb;
        --cyan: #06b6d4;
        --green: #22c55e;
        --red: #ef4444;
        --orange: #f97316;
        --border: rgba(148, 163, 184, 0.12);
        --shadow: 0 20px 60px rgba(0, 0, 0, 0.28);
        --code-bg: #07101d;
        --code-text: #e2e8f0;
      }

      .container {
        width: min(1120px, calc(100% - 32px));
        margin-inline: auto;
      }

      /* HERO */

      .hero {
        padding: 34px 0 48px;
        background:
          radial-gradient(
            circle at 20% 20%,
            rgba(37, 99, 235, 0.12),
            transparent 32%
          ),
          radial-gradient(
            circle at 80% 20%,
            rgba(8, 145, 178, 0.1),
            transparent 30%
          );
      }

      .breadcrumb {
        display: flex;
        align-items: center;
        gap: 9px;
        flex-wrap: wrap;
        font-size: 13px;
        color: var(--muted);
        margin-bottom: 30px;
      }

      .breadcrumb a {
        color: var(--muted);
        text-decoration: none;
        transition: color 0.2s ease;
      }

      .breadcrumb a:hover {
        color: var(--primary);
      }

      .breadcrumb i {
        font-size: 9px;
        opacity: 0.65;
      }

      .hero-content {
        text-align: center;
        max-width: 760px;
        margin: auto;
      }

      .hero-icon {
        width: 76px;
        height: 76px;
        margin: 0 auto 18px;
        border-radius: 22px;
        display: grid;
        place-items: center;
        font-size: 38px;
        color: #facc15;
        background: rgba(37, 99, 235, 0.1);
        border: 1px solid rgba(37, 99, 235, 0.15);
        box-shadow: var(--shadow);
      }

      .hero-kicker,
      .section-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--primary);
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 10px;
      }

      .hero h1 {
        margin: 0;
        font-size: clamp(32px, 5vw, 54px);
        line-height: 1.15;
        letter-spacing: -1px;
        font-weight: 800;
      }

      .hero h1 span,
      .section-heading h2 span {
        color: var(--primary);
      }

      .hero p {
        margin: 16px auto 0;
        max-width: 650px;
        color: var(--muted);
        font-size: 16px;
        line-height: 1.9;
      }

      /* TOOL */

      .tool-section {
        padding: 0 0 75px;
      }

      .tool-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 24px;
        overflow: hidden;
        box-shadow: var(--shadow);
      }

      .toolbar {
        min-height: 78px;
        padding: 14px 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        border-bottom: 1px solid var(--border);
        background: var(--card2);
      }

      .toolbar-title {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .toolbar-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        color: #facc15;
        background: rgba(37, 99, 235, 0.1);
      }

      .toolbar-title strong {
        display: block;
        font-size: 14px;
      }

      .toolbar-title small {
        display: block;
        color: var(--muted);
        font-size: 11px;
        margin-top: 2px;
      }

      .toolbar-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
      }

      .tool-btn,
      .mini-btn {
        border: 0;
        cursor: pointer;
        transition:
          transform 0.2s ease,
          background 0.2s ease;
      }

      .tool-btn {
        min-height: 42px;
        padding: 0 16px;
        border-radius: 11px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 13px;
        font-weight: 700;
      }

      .tool-btn:hover {
        transform: translateY(-1px);
      }

      .tool-btn.primary {
        color: white;
        background: var(--primary);
      }

      .tool-btn.primary:hover {
        background: var(--primary-hover);
      }

      .tool-btn.secondary {
        color: var(--text);
        background: var(--bg2);
        border: 1px solid var(--border);
      }

      .tool-btn.secondary:hover {
        background: var(--card);
      }

      /* WORKSPACE */

      .workspace {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
        padding: 16px;
        background: var(--bg2);
      }

      .panel {
        min-width: 0;
        overflow: hidden;
        border-radius: 17px;
        border: 1px solid rgba(148, 163, 184, 0.18);
        background: var(--code-bg);
      }

      .panel-header {
        height: 48px;
        padding: 0 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: rgba(255, 255, 255, 0.035);
        border-bottom: 1px solid rgba(148, 163, 184, 0.12);
        color: var(--code-text);
      }

      .panel-title {
        display: flex;
        align-items: center;
        gap: 9px;
        font-size: 12px;
        font-weight: 700;
      }

      .panel-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
      }

      .js-dot {
        background: #facc15;
      }

      .output-dot {
        background: #22c55e;
      }

      .panel-tools {
        font-size: 11px;
        color: #94a3b8;
      }

      .editor-wrap {
        height: 390px;
        display: flex;
        direction: ltr;
        overflow: hidden;
      }

      .line-numbers {
        width: 48px;
        flex: 0 0 48px;
        padding: 17px 9px;
        overflow: hidden;
        text-align: right;
        user-select: none;
        color: #64748b;
        background: rgba(255, 255, 255, 0.025);
        border-right: 1px solid rgba(148, 163, 184, 0.1);
        font: 13px/1.75 monospace;
        white-space: pre;
      }

      #codeInput {
        flex: 1;
        width: 100%;
        height: 100%;
        resize: none;
        border: 0;
        outline: 0;
        padding: 17px;
        color: var(--code-text);
        background: transparent;
        font: 13px/1.75 "Fira Code", "Cascadia Code", Consolas, monospace;
        tab-size: 2;
        direction: ltr;
        text-align: left;
        white-space: pre;
        overflow: auto;
      }

      #codeInput::placeholder {
        color: #64748b;
      }

      .editor-footer,
      .output-footer {
        height: 38px;
        padding: 0 13px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: #94a3b8;
        font-size: 10px;
        border-top: 1px solid rgba(148, 163, 184, 0.1);
        background: rgba(255, 255, 255, 0.025);
      }

      .editor-footer span,
      .output-footer span {
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }

      .output {
        height: 390px;
        padding: 17px;
        overflow: auto;
        color: var(--code-text);
        direction: ltr;
        text-align: left;
        font: 13px/1.7 monospace;
      }

      .empty-output {
        min-height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: #94a3b8;
        text-align: center;
      }

      .empty-output strong {
        color: #cbd5e1;
        font-size: 13px;
      }

      .empty-output span {
        font-size: 11px;
      }

      .empty-icon {
        width: 54px;
        height: 54px;
        margin-bottom: 4px;
        border-radius: 15px;
        display: grid;
        place-items: center;
        color: #60a5fa;
        background: rgba(37, 99, 235, 0.12);
        font-size: 20px;
      }

      .mini-btn {
        padding: 6px 9px;
        border-radius: 8px;
        color: #94a3b8;
        background: transparent;
        font-size: 11px;
      }

      .mini-btn:hover {
        color: white;
        background: rgba(255, 255, 255, 0.08);
      }

      .console-line {
        margin-bottom: 8px;
        padding: 8px 10px;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.035);
        white-space: pre-wrap;
        word-break: break-word;
      }

      .console-line.log {
        color: #e2e8f0;
      }

      .console-line.warn {
        color: #fbbf24;
      }

      .console-line.error {
        color: #f87171;
        background: rgba(220, 38, 38, 0.08);
      }

      .console-prefix {
        display: inline-block;
        margin-right: 8px;
        opacity: 0.7;
        font-size: 10px;
      }

      .quick-info {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1px;
        background: var(--border);
        border-top: 1px solid var(--border);
      }

      .info-item {
        min-height: 78px;
        padding: 15px;
        display: flex;
        align-items: center;
        gap: 11px;
        background: var(--card);
      }

      .info-item > i {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        border-radius: 11px;
        display: grid;
        place-items: center;
        color: var(--primary);
        background: rgba(37, 99, 235, 0.1);
      }

      .info-item strong {
        display: block;
        font-size: 12px;
      }

      .info-item span {
        display: block;
        margin-top: 2px;
        color: var(--muted);
        font-size: 10px;
      }

      /* SECTIONS */

      .info-section,
      .how-section,
      .faq-section {
        padding: 80px 0;
      }

      .info-section {
        background: var(--bg2);
      }

      .section-heading {
        max-width: 700px;
        margin: 0 auto 35px;
        text-align: center;
      }

      .section-heading h2 {
        margin: 0;
        font-size: clamp(25px, 4vw, 36px);
        line-height: 1.3;
      }

      .section-heading p {
        margin: 12px auto 0;
        color: var(--muted);
        line-height: 1.9;
        font-size: 14px;
      }

      .info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
      }

      .info-card {
        padding: 25px;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 18px;
        box-shadow: var(--shadow);
      }

      .info-card-icon {
        width: 48px;
        height: 48px;
        margin-bottom: 17px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        color: var(--primary);
        background: rgba(37, 99, 235, 0.1);
        font-size: 19px;
      }

      .info-card h3 {
        margin: 0 0 8px;
        font-size: 16px;
      }

      .info-card p {
        margin: 0;
        color: var(--muted);
        line-height: 1.85;
        font-size: 13px;
      }

      /* STEPS */

      .steps {
        max-width: 850px;
        margin: auto;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
      }

      .step {
        padding: 23px;
        display: flex;
        gap: 13px;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: var(--card);
      }

      .step-number {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        display: grid;
        place-items: center;
        border-radius: 11px;
        color: white;
        background: var(--primary);
        font-weight: 800;
        font-size: 13px;
      }

      .step h3 {
        margin: 0 0 5px;
        font-size: 14px;
      }

      .step p {
        margin: 0;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.8;
      }

      /* FAQ */

      .faq-list {
        max-width: 850px;
        margin: auto;
        display: grid;
        gap: 10px;
      }

      .faq-item {
        border: 1px solid var(--border);
        border-radius: 15px;
        background: var(--card);
        overflow: hidden;
      }

      .faq-item summary {
        padding: 17px 19px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        list-style: none;
        font-size: 13px;
        font-weight: 700;
      }

      .faq-item summary::-webkit-details-marker {
        display: none;
      }

      .faq-item summary i {
        color: var(--muted);
        font-size: 11px;
        transition: transform 0.2s ease;
      }

      .faq-item[open] summary i {
        transform: rotate(180deg);
      }

      .faq-item p {
        margin: 0;
        padding: 0 19px 18px;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.9;
      }

      /* RESPONSIVE */

      @media (max-width: 850px) {
        .workspace {
          grid-template-columns: 1fr;
        }

        .quick-info {
          grid-template-columns: repeat(2, 1fr);
        }

        .info-grid {
          grid-template-columns: 1fr;
        }

        .steps {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 600px) {
        .container {
          width: min(100% - 20px, 1120px);
        }

        .hero {
          padding-top: 22px;
          padding-bottom: 38px;
        }

        .breadcrumb {
          font-size: 11px;
          margin-bottom: 22px;
        }

        .hero-icon {
          width: 64px;
          height: 64px;
          font-size: 31px;
          border-radius: 18px;
        }

        .hero p {
          font-size: 13px;
        }

        .tool-section {
          padding-bottom: 50px;
        }

        .toolbar {
          align-items: stretch;
          flex-direction: column;
        }

        .toolbar-actions {
          display: grid;
          grid-template-columns: 1fr 1fr;
        }

        .tool-btn.primary {
          grid-column: 1 / -1;
        }

        .workspace {
          padding: 10px;
          gap: 10px;
        }

        .editor-wrap,
        .output {
          height: 320px;
        }

        .quick-info {
          grid-template-columns: 1fr 1fr;
        }

        .info-item {
          min-height: 70px;
          padding: 11px;
        }

        .info-item > i {
          width: 32px;
          height: 32px;
          flex-basis: 32px;
          font-size: 12px;
        }

        .info-item strong {
          font-size: 10px;
        }

        .info-item span {
          font-size: 9px;
        }

        .info-section,
        .how-section,
        .faq-section {
          padding: 58px 0;
        }

        .section-heading {
          margin-bottom: 25px;
        }

        .info-card,
        .step {
          padding: 19px;
        }
      }
    </style>

    <script is:inline>
      (() => {
        const codeInput = document.getElementById("codeInput");
        const output = document.getElementById("output");
        const runBtn = document.getElementById("runBtn");
        const clearBtn = document.getElementById("clearBtn");
        const exampleBtn = document.getElementById("exampleBtn");
        const clearOutput = document.getElementById("clearOutput");
        const lineNumbers = document.getElementById("lineNumbers");
        const lineCount = document.getElementById("lineCount");
        const charCount = document.getElementById("charCount");
        const status = document.getElementById("status");
        const executionTime = document.getElementById("executionTime");

        const exampleCode = `const name = "Th.Tech";

console.log("مرحباً بك في " + name);

const numbers = [10, 20, 30, 40, 50];
const total = numbers.reduce((sum, n) => sum + n, 0);

console.log("المجموع:", total);`;

        function updateEditorStats() {
          const code = codeInput.value;
          const lines = code.split("\\n").length;

          lineNumbers.textContent = Array.from(
            { length: Math.max(lines, 1) },
            (_, i) => i + 1
          ).join("\\n");

          lineCount.textContent =
            `${lines} ${lines === 1 ? "سطر" : "أسطر"}`;

          charCount.textContent =
            `${code.length.toLocaleString("ar-MA")} حرف`;
        }

        function setStatus(text, type = "ready") {
          const colors = {
            ready: "#94a3b8",
            success: "#4ade80",
            error: "#f87171",
            running: "#60a5fa"
          };

          status.style.color = colors[type] || colors.ready;

          status.innerHTML = `
            <i class="fa-solid fa-circle"></i>
            ${text}
          `;
        }

        function clearOutputArea() {
          output.innerHTML = `
            <div class="empty-output">
              <div class="empty-icon">
                <i class="fa-solid fa-terminal"></i>
              </div>

              <strong>لا توجد نتائج بعد</strong>

              <span>
                اضغط على "تشغيل الكود" لعرض النتيجة هنا
              </span>
            </div>
          `;

          executionTime.textContent = "0 ms";
          setStatus("جاهز", "ready");
        }

        function formatValue(value) {
          if (typeof value === "string") {
            return value;
          }

          if (typeof value === "undefined") {
            return "undefined";
          }

          if (typeof value === "function") {
            return value.toString();
          }

          if (value instanceof Error) {
            return value.stack || value.message;
          }

          try {
            return JSON.stringify(value, null, 2);
          } catch {
            return String(value);
          }
        }

        function addOutput(type, args) {
          const line = document.createElement("div");
          line.className = `console-line ${type}`;

          const prefix =
            type === "error"
              ? "ERROR"
              : type === "warn"
                ? "WARN"
                : "LOG";

          const content = args
            .map((item) => formatValue(item))
            .join(" ");

          line.innerHTML = `
            <span class="console-prefix">[${prefix}]</span>${escapeHtml(content)}
          `;

          output.appendChild(line);
        }

        function escapeHtml(value) {
          return String(value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
        }

        function runCode() {
          const code = codeInput.value.trim();

          if (!code) {
            output.innerHTML = `
              <div class="console-line warn">
                <span class="console-prefix">[WARN]</span>
                اكتب كود JavaScript أولاً.
              </div>
            `;

            setStatus("لا يوجد كود", "error");
            return;
          }

          output.innerHTML = "";
          setStatus("جاري التشغيل...", "running");

          const start = performance.now();

          const originalLog = console.log;
          const originalWarn = console.warn;
          const originalError = console.error;

          let hasError = false;

          const restoreConsole = () => {
            console.log = originalLog;
            console.warn = originalWarn;
            console.error = originalError;
          };

          console.log = (...args) => {
            addOutput("log", args);
            originalLog(...args);
          };

          console.warn = (...args) => {
            addOutput("warn", args);
            originalWarn(...args);
          };

          console.error = (...args) => {
            addOutput("error", args);
            originalError(...args);
          };

          try {
            const result = Function(`"use strict";\\n${code}`)();

            if (typeof result !== "undefined") {
              addOutput("log", [result]);
            }
          } catch (error) {
            hasError = true;

            addOutput("error", [
              error && error.stack
                ? error.stack
                : String(error)
            ]);
          } finally {
            restoreConsole();
          }

          const elapsed = performance.now() - start;

          executionTime.textContent =
            `${elapsed.toFixed(2)} ms`;

          if (hasError) {
            setStatus("حدث خطأ", "error");
          } else {
            setStatus("تم التنفيذ بنجاح", "success");
          }

          if (!output.children.length) {
            addOutput("log", ["تم تنفيذ الكود بنجاح بدون مخرجات."]);
          }
        }

        codeInput.addEventListener("input", updateEditorStats);

        codeInput.addEventListener("scroll", () => {
          lineNumbers.scrollTop = codeInput.scrollTop;
        });

        codeInput.addEventListener("keydown", (event) => {
          if (event.key === "Tab") {
            event.preventDefault();

            const start = codeInput.selectionStart;
            const end = codeInput.selectionEnd;

            codeInput.value =
              codeInput.value.substring(0, start) +
              "  " +
              codeInput.value.substring(end);

            codeInput.selectionStart = start + 2;
            codeInput.selectionEnd = start + 2;

            updateEditorStats();
          }

          if (
            (event.ctrlKey || event.metaKey) &&
            event.key === "Enter"
          ) {
            event.preventDefault();
            runCode();
          }
        });

        runBtn.addEventListener("click", runCode);

        clearBtn.addEventListener("click", () => {
          codeInput.value = "";
          updateEditorStats();
          clearOutputArea();
          codeInput.focus();
        });

        clearOutput.addEventListener("click", () => {
          clearOutputArea();
        });

        exampleBtn.addEventListener("click", () => {
          codeInput.value = exampleCode;
          updateEditorStats();
          clearOutputArea();
          codeInput.focus();
        });

        updateEditorStats();
      })();
    </script>
  </body>
</html>
