---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "SQL Minifier - تصغير SQL أونلاين مجاناً | Th.Tech";

const description =
  "أداة SQL Minifier مجانية لتصغير وضغط استعلامات SQL وإزالة المسافات والتعليقات غير الضرورية مباشرة من المتصفح.";

const faqs = [
  {
    q: "ما هي أداة SQL Minifier؟",
    a: "SQL Minifier هي أداة تساعدك على تصغير استعلامات SQL بإزالة المسافات والأسطر والتعليقات غير الضرورية مع الحفاظ على بنية الاستعلام."
  },
  {
    q: "هل يتم إرسال SQL إلى الخادم؟",
    a: "لا. تتم عملية التصغير بالكامل داخل متصفحك، لذلك لا يتم إرسال الكود إلى خادم خارجي."
  },
  {
    q: "هل يمكن تصغير استعلامات SQL كبيرة؟",
    a: "نعم، يمكن للأداة التعامل مع استعلامات SQL كبيرة، لكن الأداء يعتمد على حجم النص وإمكانيات الجهاز والمتصفح."
  },
  {
    q: "هل تقوم الأداة بتغيير منطق الاستعلام؟",
    a: "الأداة مصممة لتقليل المسافات والتعليقات غير الضرورية فقط، ولا تعيد كتابة منطق SQL أو تغيّر أسماء الجداول والأعمدة."
  }
];
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
