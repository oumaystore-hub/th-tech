        }

        .mini-icon {
          border-color: var(--card);
        }

        .hero-features span,
        .info-card,
        .step {
          background: var(--soft);
        }

        .editors-grid {
          background: #060b12;
        }

        .progress-bar {
          background: #1e293b;
        }

        .number-box {
          background: var(--soft);
        }

        .info-section,
        .faq-section {
          background: var(--card);
        }
