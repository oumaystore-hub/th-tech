        }

        .section-heading p {
          font-size: 11px;
        }

        .info-card,
        .step {
          padding: 20px;
        }
      }

      /* ================= DARK MODE ================= */

      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #070d16;
          --card: #0c1421;
          --soft: #111c2b;

          --text: #f1f5f9;
          --muted: #94a3b8;
          --border: #1e293b;

          --primary: #22d3ee;
          --primary-dark: #67e8f9;
          --secondary: #06b6d4;
          --cyan: #67e8f9;

          --blue: #60a5fa;
          --purple: #a78bfa;
          --green: #4ade80;
          --orange: #fb923c;
          --red: #f87171;

          --shadow:
            0 20px 60px rgba(0, 0, 0, 0.28);
        }

        .hero {
          background:
            radial-gradient(
              circle at 15% 15%,
              rgba(6, 182, 212, 0.08),
