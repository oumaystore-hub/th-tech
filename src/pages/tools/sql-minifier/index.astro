---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "SQL Minifier - تصغير SQL أونلاين مجاناً | Th.Tech";
const description =
  "أداة SQL Minifier مجانية لتصغير وضغط استعلامات SQL وإزالة المسافات والتعليقات غير الضرورية مباشرة من المتصفح.";

const faqs = [
  {
    q: "ما هي أداة SQL Minifier؟",
    a: "SQL Minifier هي أداة تساعدك على تصغير استعلامات SQL بإزالة المسافات والأسطر والتعليقات غير الضرورية مع الحفاظ على بنية الاستعلام."
  },
  {
    q: "هل يتم إرسال SQL إلى الخادم؟",
    a: "لا. تتم عملية التصغير بالكامل داخل متصفحك، لذلك لا يتم إرسال الكود إلى خادم خارجي."
  },
  {
    q: "هل يمكن تصغير استعلامات SQL كبيرة؟",
    a: "نعم، يمكن للأداة التعامل مع استعلامات SQL كبيرة، لكن الأداء يعتمد على حجم النص وإمكانيات الجهاز والمتصفح."
  },
  {
    q: "هل تقوم الأداة بتغيير منطق الاستعلام؟",
    a: "الأداة مصممة لتقليل المسافات والتعليقات غير الضرورية فقط، ولا تعيد كتابة منطق SQL أو تغيّر أسماء الجداول والأعمدة."
  }
];
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  />
</head>

<body>
  <Header />

  <main>

    <!-- ================= HERO ================= -->
    <section class="hero">
      <div class="hero-bg"></div>

      <div class="container hero-container">

        <div class="breadcrumb">
          <a href={`${base}/`}>الرئيسية</a>
          <i class="fa-solid fa-chevron-left"></i>
          <a href={`${base}/tools/`}>الأدوات</a>
          <i class="fa-solid fa-chevron-left"></i>
          <span>SQL Minifier</span>
        </div>

        <div class="hero-content">

          <div class="hero-icon">
            <div class="icon-glow"></div>
            <i class="fa-solid fa-database"></i>
            <span class="mini-icon">
              <i class="fa-solid fa-compress"></i>
            </span>
          </div>

          <div class="hero-text">

            <div class="badge">
              <i class="fa-solid fa-code"></i>
              Developer Tools
            </div>

            <h1>
              SQL Minifier
              <span>تصغير وضغط SQL</span>
            </h1>

            <p>{description}</p>

            <div class="hero-features">
              <span>
                <i class="fa-solid fa-bolt"></i>
                سريع
              </span>

              <span>
                <i class="fa-solid fa-shield-halved"></i>
                آمن
              </span>

              <span>
                <i class="fa-solid fa-lock"></i>
                يعمل محلياً
              </span>
            </div>

          </div>

        </div>
      </div>
    </section>


    <!-- ================= TOOL ================= -->
    <section class="tool-section">
      <div class="container">

        <div class="minifier-card">

          <!-- TOP BAR -->
          <div class="tool-topbar">

            <div class="tool-title">
              <div class="tool-title-icon">
                <i class="fa-solid fa-database"></i>
              </div>

              <div>
                <strong>SQL Minifier</strong>
                <small>تصغير استعلامات SQL</small>
              </div>
            </div>

            <div class="tool-status">
              <span class="status-dot"></span>
              <span id="statusText">جاهز</span>
            </div>

          </div>


          <!-- ACTION BAR -->
          <div class="actionbar">

            <button class="action-btn secondary" id="exampleBtn">
              <i class="fa-solid fa-wand-magic-sparkles"></i>
              مثال
            </button>

            <button class="action-btn secondary" id="clearBtn">
              <i class="fa-solid fa-eraser"></i>
              مسح
            </button>

            <button class="action-btn secondary" id="copyBtn">
              <i class="fa-regular fa-copy"></i>
              نسخ
            </button>

            <button class="action-btn primary" id="minifyBtn">
              <i class="fa-solid fa-compress"></i>
              تصغير SQL
            </button>

          </div>


          <!-- EDITORS -->
          <div class="editors-grid">

            <!-- INPUT -->
            <div class="editor-card">

              <div class="editor-header">

                <div class="editor-heading">
                  <span class="editor-icon input-icon">
                    <i class="fa-solid fa-code"></i>
                  </span>

                  <div>
                    <strong>SQL Input</strong>
                    <small>SQL الأصلي</small>
                  </div>
                </div>

                <span class="editor-badge" id="inputLines">
                  0 سطر
                </span>

              </div>

              <div class="editor-body">

                <div class="line-numbers" id="inputNumbers">
                  <span>1</span>
                </div>

                <textarea
                  id="sqlInput"
                  spellcheck="false"
                  placeholder="اكتب أو الصق كود SQL هنا..."
                ></textarea>

              </div>

            </div>


            <!-- OUTPUT -->
            <div class="editor-card">

              <div class="editor-header">

                <div class="editor-heading">
                  <span class="editor-icon output-icon">
                    <i class="fa-solid fa-compress"></i>
                  </span>

                  <div>
                    <strong>Minified SQL</strong>
                    <small>SQL بعد التصغير</small>
                  </div>
                </div>

                <span class="editor-badge success">
                  مضغوط
                </span>

              </div>

              <div class="editor-body">

                <div class="line-numbers" id="outputNumbers">
                  <span>1</span>
                </div>

                <textarea
                  id="sqlOutput"
                  spellcheck="false"
                  readonly
                  placeholder="ستظهر نتيجة التصغير هنا..."
                ></textarea>

              </div>

            </div>

          </div>


          <!-- RESULT -->
          <div class="result-panel">

            <div class="result-header">

              <div class="result-title">
                <span class="result-icon">
                  <i class="fa-solid fa-chart-simple"></i>
                </span>

                <div>
                  <strong>Compression Result</strong>
                  <small>نتيجة التصغير</small>
                </div>
              </div>

              <div class="compression-badge" id="compressionBadge">
                0%
              </div>

            </div>


            <div class="progress-wrapper">

              <div class="progress-bar">
                <span id="progressBar"></span>
              </div>

            </div>


            <div class="result-stats">

              <div class="number-box">
                <span>
                  <i class="fa-regular fa-file-code"></i>
                  الحجم الأصلي
                </span>
                <strong id="originalSize">0 B</strong>
              </div>

              <div class="number-box">
                <span>
                  <i class="fa-solid fa-compress"></i>
                  الحجم بعد التصغير
                </span>
                <strong id="minifiedSize">0 B</strong>
              </div>

              <div class="number-box">
                <span>
                  <i class="fa-solid fa-arrow-down"></i>
                  الحجم الموفر
                </span>
                <strong id="savedSize">0 B</strong>
              </div>

            </div>

          </div>


          <!-- TOOL STATS -->
          <div class="tool-stats">

            <div class="stat-card">
              <div class="stat-icon blue">
                <i class="fa-solid fa-database"></i>
              </div>

              <div>
                <strong>SQL</strong>
                <span>متوافق</span>
              </div>
            </div>


            <div class="stat-card">
              <div class="stat-icon green">
                <i class="fa-solid fa-bolt"></i>
              </div>

              <div>
                <strong>Fast</strong>
                <span>معالجة سريعة</span>
              </div>
            </div>


            <div class="stat-card">
              <div class="stat-icon purple">
                <i class="fa-solid fa-shield-halved"></i>
              </div>

              <div>
                <strong>Private</strong>
                <span>100% محلي</span>
              </div>
            </div>


            <div class="stat-card">
              <div class="stat-icon orange">
                <i class="fa-solid fa-chart-line"></i>
              </div>

              <div>
                <strong id="savedPercent">0%</strong>
                <span>تم توفيره</span>
              </div>
            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- ================= INFO ================= -->
    <section class="info-section">
      <div class="container">

        <div class="section-heading">
          <span class="section-label">
            <i class="fa-solid fa-circle-info"></i>
            SQL Minifier
          </span>

          <h2>لماذا تستخدم SQL Minifier؟</h2>

          <p>
            قم بتصغير استعلامات SQL بسهولة وتحسين حجمها قبل استخدامها
            في المشاريع والتطبيقات.
          </p>
        </div>


        <div class="info-grid">

          <div class="info-card">
            <div class="info-icon blue">
              <i class="fa-solid fa-compress"></i>
            </div>

            <h3>تقليل الحجم</h3>

            <p>
              إزالة المسافات والأسطر والتعليقات غير الضرورية لتقليل حجم
              استعلام SQL.
            </p>
          </div>


          <div class="info-card">
            <div class="info-icon green">
              <i class="fa-solid fa-bolt"></i>
            </div>

            <h3>معالجة سريعة</h3>

            <p>
              تتم معالجة SQL مباشرة داخل المتصفح بدون الحاجة إلى رفع
              الملفات أو إرسال البيانات.
            </p>
          </div>


          <div class="info-card">
            <div class="info-icon purple">
              <i class="fa-solid fa-user-shield"></i>
            </div>

            <h3>خصوصية أفضل</h3>

            <p>
              كود SQL الخاص بك يبقى داخل جهازك ولا يتم إرساله إلى خادم
              خارجي.
            </p>
          </div>

        </div>

      </div>
    </section>


    <!-- ================= HOW TO ================= -->
    <section class="how-section">
      <div class="container">

        <div class="section-heading">
          <span class="section-label">
            <i class="fa-solid fa-list-check"></i>
            طريقة الاستخدام
          </span>

          <h2>كيف تستخدم الأداة؟</h2>

          <p>
            ثلاث خطوات بسيطة لتصغير استعلام SQL.
          </p>
        </div>


        <div class="steps-grid">

          <div class="step">

            <span class="step-number">01</span>

            <div class="step-icon">
              <i class="fa-solid fa-paste"></i>
            </div>

            <h3>أدخل SQL</h3>

            <p>
              الصق أو اكتب استعلام SQL في محرر الإدخال.
            </p>

          </div>


          <div class="step">

            <span class="step-number">02</span>

            <div class="step-icon">
              <i class="fa-solid fa-compress"></i>
            </div>

            <h3>اضغط تصغير</h3>

            <p>
              اضغط على زر تصغير SQL لمعالجة الاستعلام.
            </p>

          </div>


          <div class="step">

            <span class="step-number">03</span>

            <div class="step-icon">
              <i class="fa-regular fa-copy"></i>
            </div>

            <h3>انسخ النتيجة</h3>

            <p>
              انسخ SQL المصغر واستخدمه مباشرة في مشروعك.
            </p>

          </div>

        </div>

      </div>
    </section>


    <!-- ================= FAQ ================= -->
    <section class="faq-section">
      <div class="container">

        <div class="section-heading">
          <span class="section-label">
            <i class="fa-regular fa-circle-question"></i>
            FAQ
          </span>

          <h2>الأسئلة الشائعة</h2>

          <p>
            إجابات عن أهم الأسئلة المتعلقة بأداة SQL Minifier.
          </p>
        </div>


        <div class="faq-list">

          {faqs.map((faq) => (
            <details class="faq-item">
              <summary>
                <span>{faq.q}</span>
                <i class="fa-solid fa-chevron-down"></i>
              </summary>

              <div class="faq-answer">
                <p>{faq.a}</p>
              </div>
            </details>
          ))}

        </div>

      </div>
    </section>

  </main>

  <Footer />


  <!-- ================= JAVASCRIPT ================= -->
  <script is:inline>
    const sqlInput = document.getElementById("sqlInput");
    const sqlOutput = document.getElementById("sqlOutput");

    const minifyBtn = document.getElementById("minifyBtn");
    const clearBtn = document.getElementById("clearBtn");
    const copyBtn = document.getElementById("copyBtn");
    const exampleBtn = document.getElementById("exampleBtn");

    const inputNumbers = document.getElementById("inputNumbers");
    const outputNumbers = document.getElementById("outputNumbers");

    const inputLines = document.getElementById("inputLines");

    const statusText = document.getElementById("statusText");

    const originalSize = document.getElementById("originalSize");
    const minifiedSize = document.getElementById("minifiedSize");
    const savedSize = document.getElementById("savedSize");

    const compressionBadge = document.getElementById("compressionBadge");
    const progressBar = document.getElementById("progressBar");
    const savedPercent = document.getElementById("savedPercent");


    function formatBytes(bytes) {
      if (!bytes || bytes <= 0) return "0 B";

      if (bytes < 1024) {
        return bytes + " B";
      }

      if (bytes < 1024 * 1024) {
        return (bytes / 1024).toFixed(2) + " KB";
      }

      return (bytes / (1024 * 1024)).toFixed(2) + " MB";
    }


    function getBytes(text) {
      return new Blob([text]).size;
    }


    function countLines(text) {
      if (!text) return 0;
      return text.split("\n").length;
    }


    function updateLineNumbers(text, container) {
      const count = Math.max(countLines(text), 1);

      let html = "";

      for (let i = 1; i <= count; i++) {
        html += "<span>" + i + "</span>";
      }

      container.innerHTML = html;
    }


    function updateInputStats() {
      const text = sqlInput.value;
      const lines = countLines(text);

      inputLines.textContent = lines + (lines === 1 ? " سطر" : " أسطر");

      updateLineNumbers(text, inputNumbers);
    }


    function setStatus(text) {
      statusText.textContent = text;
    }


    /*
      SQL Minifier
      يحافظ على النصوص داخل:
      '
      "
      `
      ويزيل التعليقات والمسافات غير الضرورية.
    */
    function minifySQL(sql) {
      let result = "";

      let quote = null;
      let i = 0;

      while (i < sql.length) {
        const char = sql[i];
        const next = sql[i + 1];

        // داخل النص
        if (quote) {
          result += char;

          // SQL escaping مثل ''
          if (char === quote && next === quote) {
            result += next;
            i += 2;
            continue;
          }

          // نهاية النص
          if (char === quote) {
            quote = null;
          }

          i++;
          continue;
        }


        // بداية string
        if (char === "'" || char === '"' || char === "`") {
          quote = char;
          result += char;
          i++;
          continue;
        }


        // تعليق --
        if (char === "-" && next === "-") {
          i += 2;

          while (i < sql.length && sql[i] !== "\n") {
            i++;
          }

          continue;
        }


        // تعليق #
        if (char === "#") {
          i++;

          while (i < sql.length && sql[i] !== "\n") {
            i++;
          }

          continue;
        }


        // تعليق /* */
        if (char === "/" && next === "*") {
          i += 2;

          while (
            i < sql.length &&
            !(sql[i] === "*" && sql[i + 1] === "/")
          ) {
            i++;
          }

          if (i < sql.length) {
            i += 2;
          }

          continue;
        }


        result += char;
        i++;
      }


      // إزالة المسافات المتكررة
      result = result.replace(/\s+/g, " ");

      // إزالة المسافات حول بعض الرموز
      result = result.replace(/\s*([(),;])\s*/g, "$1");

      result = result.replace(
        /\s*(=|<>|!=|<=|>=|<|>|\+|-|\*|\/)\s*/g,
        "$1"
      );

      // إعادة مسافة بعد الفواصل
      result = result.replace(/,([A-Za-z_])/g, ", $1");

      return result.trim();
    }


    function updateResult() {
      const original = sqlInput.value;
      const minified = sqlOutput.value;

      const originalBytes = getBytes(original);
      const minifiedBytes = getBytes(minified);

      const saved = Math.max(originalBytes - minifiedBytes, 0);

      let percent = 0;

      if (originalBytes > 0) {
        percent = Math.round((saved / originalBytes) * 100);
      }

      originalSize.textContent = formatBytes(originalBytes);
      minifiedSize.textContent = formatBytes(minifiedBytes);
      savedSize.textContent = formatBytes(saved);

      compressionBadge.textContent = percent + "%";
      savedPercent.textContent = percent + "%";

      progressBar.style.width = Math.min(percent, 100) + "%";
    }


    function minify() {
      const sql = sqlInput.value.trim();

      if (!sql) {
        setStatus("أدخل SQL أولاً");
        sqlInput.focus();
        return;
      }

      setStatus("جاري التصغير...");

      requestAnimationFrame(() => {
        const result = minifySQL(sql);

        sqlOutput.value = result;

        updateLineNumbers(result, outputNumbers);
        updateResult();

        setStatus("تم التصغير بنجاح");
      });
    }


    function clearAll() {
      sqlInput.value = "";
      sqlOutput.value = "";

      updateInputStats();
      updateLineNumbers("", outputNumbers);
      updateResult();

      setStatus("جاهز");

      sqlInput.focus();
    }


    async function copyOutput() {
      const value = sqlOutput.value;

      if (!value) {
        setStatus("لا توجد نتيجة للنسخ");
        return;
      }

      try {
        await navigator.clipboard.writeText(value);
        setStatus("تم نسخ SQL");
      } catch (error) {
        sqlOutput.select();
        document.execCommand("copy");
        setStatus("تم نسخ SQL");
      }
    }


    function loadExample() {
      sqlInput.value = `-- Example SQL Query

SELECT
    users.id,
    users.name,
    users.email,
    COUNT(orders.id) AS total_orders
FROM users
LEFT JOIN orders
    ON users.id = orders.user_id
WHERE users.active = 1
    AND users.email IS NOT NULL
GROUP BY
    users.id,
    users.name,
    users.email
ORDER BY users.id DESC;`;

      sqlOutput.value = "";

      updateInputStats();
      updateLineNumbers("", outputNumbers);
      updateResult();

      setStatus("تم تحميل المثال");

      sqlInput.focus();
    }


    // الأحداث
    minifyBtn.addEventListener("click", minify);

    clearBtn.addEventListener("click", clearAll);

    copyBtn.addEventListener("click", copyOutput);

    exampleBtn.addEventListener("click", loadExample);


    sqlInput.addEventListener("input", () => {
      updateInputStats();
      updateResult();
      setStatus("تم تعديل SQL");
    });


    sqlInput.addEventListener("scroll", () => {
      inputNumbers.scrollTop = sqlInput.scrollTop;
    });


    sqlOutput.addEventListener("scroll", () => {
      outputNumbers.scrollTop = sqlOutput.scrollTop;
    });


    // Ctrl + Enter
    sqlInput.addEventListener("keydown", (event) => {
      if (event.ctrlKey && event.key === "Enter") {
        event.preventDefault();
        minify();
      }
    });


    // Tab داخل المحرر
    sqlInput.addEventListener("keydown", (event) => {
      if (event.key === "Tab") {
        event.preventDefault();

        const start = sqlInput.selectionStart;
        const end = sqlInput.selectionEnd;

        sqlInput.value =
          sqlInput.value.substring(0, start) +
          "  " +
          sqlInput.value.substring(end);

        sqlInput.selectionStart = start + 2;
        sqlInput.selectionEnd = start + 2;

        updateInputStats();
      }
    });


    // الحالة الأولية
    updateInputStats();
    updateLineNumbers("", outputNumbers);
    updateResult();
  </script>


  <!-- ================= CSS ================= -->
  <style>

    :global(*) {
      box-sizing: border-box;
    }


    :global(html) {
      scroll-behavior: smooth;
    }


    :global(body) {
      margin: 0;
      font-family: "Cairo", sans-serif;
      background: var(--bg);
      color: var(--text);
      transition:
        background .3s ease,
        color .3s ease;
    }


    :global(button),
    :global(textarea) {
      font-family: inherit;
    }


    :root {
      --primary: #0891b2;
      --primary-dark: #0e7490;
      --secondary: #06b6d4;
      --cyan: #22d3ee;

      --blue: #2563eb;
      --purple: #7c3aed;
      --green: #16a34a;
      --orange: #ea580c;
      --red: #dc2626;

      --bg: #f5f8fb;
      --card: #ffffff;
      --soft: #f1f7f9;

      --text: #111827;
      --muted: #6b7280;

      --border: #e2e8f0;

      --editor: #0f172a;
      --editor-2: #111827;
      --editor-text: #dbeafe;
      --line-number: #64748b;

      --shadow:
        0 20px 60px rgba(15, 23, 42, .08);
    }


    /* ================= DARK MODE ================= */

    :global(html.dark) {
      --bg: #070d16;
      --card: #0c1421;
      --soft: #111c2b;

      --text: #f1f5f9;
      --muted: #94a3b8;

      --border: #1e293b;

      --primary: #22d3ee;
      --primary-dark: #67e8f9;
      --secondary: #06b6d4;
      --cyan: #67e8f9;

      --blue: #60a5fa;
      --purple: #a78bfa;
      --green: #4ade80;
      --orange: #fb923c;
      --red: #f87171;

      --shadow:
        0 20px 60px rgba(0, 0, 0, .28);
    }


    /* ================= COMMON ================= */

    .container {
      width: min(1180px, calc(100% - 32px));
      margin: 0 auto;
    }


    /* ================= HERO ================= */

    .hero {
      position: relative;
      overflow: hidden;
      padding: 28px 0 60px;
      background:
        radial-gradient(
          circle at 80% 20%,
          rgba(34, 211, 238, .14),
          transparent 35%
        ),
        linear-gradient(
          135deg,
          #effcff,
          #f5f8fb
        );
      border-bottom: 1px solid var(--border);
      transition: background .3s ease;
    }


    :global(html.dark) .hero {
      background:
        radial-gradient(
          circle at 80% 20%,
          rgba(34, 211, 238, .12),
          transparent 35%
        ),
        linear-gradient(
          135deg,
          #08131d,
          #070d16
        );
    }


    .hero-bg {
      position: absolute;
      inset: 0;
      pointer-events: none;
      opacity: .35;
      background-image:
        linear-gradient(
          rgba(8, 145, 178, .05) 1px,
          transparent 1px
        ),
        linear-gradient(
          90deg,
          rgba(8, 145, 178, .05) 1px,
          transparent 1px
        );
      background-size: 32px 32px;
    }


    .breadcrumb {
      position: relative;
      z-index: 2;

      display: flex;
      align-items: center;
      gap: 9px;

      color: var(--muted);
      font-size: 13px;

      margin-bottom: 34px;
    }


    .breadcrumb a {
      color: var(--muted);
      text-decoration: none;
      transition: color .2s ease;
    }


    .breadcrumb a:hover {
      color: var(--primary);
    }


    .breadcrumb i {
      font-size: 9px;
    }


    .breadcrumb span {
      color: var(--primary);
      font-weight: 700;
    }


    .hero-content {
      position: relative;
      z-index: 2;

      display: flex;
      align-items: center;
      gap: 28px;
    }


    .hero-icon {
      position: relative;

      width: 112px;
      height: 112px;

      flex: 0 0 112px;

      display: grid;
      place-items: center;

      border-radius: 30px;

      color: #fff;
      font-size: 45px;

      background:
        linear-gradient(
          135deg,
          var(--primary),
          #155e75
        );

      box-shadow:
        0 20px 45px rgba(8, 145, 178, .25);
    }


    .icon-glow {
      position: absolute;
      inset: -15px;

      border-radius: 38px;

      background: rgba(34, 211, 238, .12);

      filter: blur(18px);

      z-index: -1;
    }


    .mini-icon {
      position: absolute;

      left: -8px;
      bottom: -8px;

      width: 38px;
      height: 38px;

      display: grid;
      place-items: center;

      border-radius: 12px;

      background: var(--card);
      color: var(--primary);

      font-size: 16px;

      border: 1px solid var(--border);

      box-shadow: 0 8px 20px rgba(0, 0, 0, .1);
    }


    .hero-text {
      flex: 1;
    }


    .badge,
    .section-label {
      display: inline-flex;
      align-items: center;
      gap: 8px;

      padding: 7px 13px;

      border-radius: 999px;

      font-size: 12px;
      font-weight: 700;

      color: var(--primary);

      background: rgba(8, 145, 178, .09);

      border: 1px solid rgba(8, 145, 178, .15);
    }


    .hero h1 {
      margin: 13px 0 10px;

      font-size: clamp(30px, 5vw, 48px);

      line-height: 1.2;

      font-weight: 800;

      letter-spacing: -1px;

      color: var(--text);
    }


    .hero h1 span {
      display: block;

      font-size: .46em;

      margin-top: 6px;

      color: var(--primary);

      letter-spacing: 0;
    }


    .hero p {
      max-width: 750px;

      margin: 0;

      color: var(--muted);

      line-height: 1.9;

      font-size: 15px;
    }


    .hero-features {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;

      margin-top: 20px;
    }


    .hero-features span {
      display: inline-flex;
      align-items: center;
      gap: 7px;

      padding: 8px 12px;

      border-radius: 10px;

      background: rgba(255, 255, 255, .75);

      border: 1px solid var(--border);

      color: var(--muted);

      font-size: 12px;

      transition: all .25s ease;
    }


    :global(html.dark) .hero-features span {
      background: var(--soft);
    }


    .hero-features i {
      color: var(--primary);
    }


    /* ================= TOOL SECTION ================= */

    .tool-section {
      padding: 55px 0;
    }


    .minifier-card {
      overflow: hidden;

      border-radius: 24px;

      background: var(--card);

      border: 1px solid var(--border);

      box-shadow: var(--shadow);

      transition:
        background .3s ease,
        border-color .3s ease;
    }


    .tool-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 20px;

      padding: 17px 20px;

      border-bottom: 1px solid var(--border);
    }


    .tool-title {
      display: flex;
      align-items: center;
      gap: 12px;
    }


    .tool-title-icon {
      width: 42px;
      height: 42px;

      display: grid;
      place-items: center;

      border-radius: 12px;

      background: rgba(8, 145, 178, .1);

      color: var(--primary);
    }


    .tool-title strong,
    .tool-title small {
      display: block;
    }


    .tool-title strong {
      font-size: 14px;
    }


    .tool-title small {
      margin-top: 2px;

      color: var(--muted);

      font-size: 11px;
    }


    .tool-status {
      display: flex;
      align-items: center;
      gap: 7px;

      color: var(--muted);

      font-size: 12px;
    }


    .status-dot {
      width: 8px;
      height: 8px;

      border-radius: 50%;

      background: var(--green);

      box-shadow: 0 0 0 4px rgba(22, 163, 74, .1);
    }


    /* ================= ACTIONBAR ================= */

    .actionbar {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;

      padding: 14px 16px;

      background: var(--soft);

      border-bottom: 1px solid var(--border);

      transition: background .3s ease;
    }


    .action-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;

      min-height: 40px;

      padding: 0 15px;

      border-radius: 10px;

      border: 1px solid transparent;

      cursor: pointer;

      font-size: 12px;
      font-weight: 700;

      transition:
        transform .2s ease,
        background .2s ease,
        border-color .2s ease;
    }


    .action-btn:hover {
      transform: translateY(-1px);
    }


    .action-btn.primary {
      margin-right: auto;

      color: #fff;

      background:
        linear-gradient(
          135deg,
          var(--primary),
          var(--primary-dark)
        );

      box-shadow:
        0 8px 18px rgba(8, 145, 178, .2);
    }


    .action-btn.secondary {
      color: var(--text);

      background: var(--card);

      border-color: var(--border);
    }


    :global(html.dark) .actionbar {
      background: #0b1522;
    }


    :global(html.dark) .action-btn.secondary {
      background: #101c2a;
      color: #e2e8f0;
      border-color: #243244;
    }


    /* ================= EDITORS ================= */

    .editors-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;

      gap: 1px;

      background: #dce4ec;
    }


    :global(html.dark) .editors-grid {
      background: #060b12;
    }


    .editor-card {
      min-width: 0;

      background: var(--card);
    }


    .editor-header {
      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 10px;

      padding: 13px 15px;

      border-bottom: 1px solid var(--border);
    }


    .editor-heading {
      display: flex;
      align-items: center;
      gap: 10px;
    }


    .editor-icon {
      width: 34px;
      height: 34px;

      display: grid;
      place-items: center;

      border-radius: 9px;

      font-size: 13px;
    }


    .input-icon {
      color: var(--blue);
      background: rgba(37, 99, 235, .1);
    }


    .output-icon {
      color: var(--green);
      background: rgba(22, 163, 74, .1);
    }


    .editor-heading strong,
    .editor-heading small {
      display: block;
    }


    .editor-heading strong {
      font-family: "JetBrains Mono", monospace;

      font-size: 12px;
    }


    .editor-heading small {
      margin-top: 2px;

      color: var(--muted);

      font-size: 10px;
    }


    .editor-badge {
      padding: 5px 8px;

      border-radius: 7px;

      color: var(--muted);

      background: var(--soft);

      font-size: 10px;

      white-space: nowrap;
    }


    .editor-badge.success {
      color: var(--green);
      background: rgba(22, 163, 74, .1);
    }


    .editor-body {
      position: relative;

      display: flex;

      min-height: 370px;

      background: var(--editor);
    }


    .line-numbers {
      width: 52px;

      flex: 0 0 52px;

      padding: 18px 12px;

      overflow: hidden;

      text-align: right;

      background: var(--editor-2);

      color: var(--line-number);

      font-family: "JetBrains Mono", monospace;

      font-size: 12px;

      line-height: 1.8;

      user-select: none;
    }


    .line-numbers span {
      display: block;
      height: 21.6px;
    }


    textarea {
      flex: 1;

      width: 100%;

      min-width: 0;

      min-height: 370px;

      resize: vertical;

      padding: 18px;

      border: 0;
      outline: 0;

      background: var(--editor);

      color: var(--editor-text);

      font-family: "JetBrains Mono", monospace;

      font-size: 13px;

      line-height: 1.8;

      direction: ltr;

      text-align: left;

      tab-size: 2;
    }


    textarea::placeholder {
      color: #64748b;
    }


    /* ================= RESULT ================= */

    .result-panel {
      margin: 16px;

      padding: 18px;

      border-radius: 17px;

      background: var(--soft);

      border: 1px solid var(--border);

      transition: background .3s ease;
    }


    .result-header {
      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 15px;

      margin-bottom: 16px;
    }


    .result-title {
      display: flex;
      align-items: center;
      gap: 10px;
    }


    .result-icon {
      width: 38px;
      height: 38px;

      display: grid;
      place-items: center;

      border-radius: 10px;

      background: rgba(8, 145, 178, .1);

      color: var(--primary);
    }


    .result-title strong,
    .result-title small {
      display: block;
    }


    .result-title strong {
      font-size: 13px;
    }


    .result-title small {
      color: var(--muted);
      font-size: 10px;
    }


    .compression-badge {
      min-width: 55px;

      padding: 7px 10px;

      text-align: center;

      border-radius: 9px;

      color: var(--green);

      background: rgba(22, 163, 74, .1);

      font-family: "JetBrains Mono", monospace;

      font-size: 12px;
      font-weight: 700;
    }


    .progress-wrapper {
      margin-bottom: 16px;
    }


    .progress-bar {
      height: 8px;

      overflow: hidden;

      border-radius: 999px;

      background: #dbe4ec;
    }


    :global(html.dark) .progress-bar {
      background: #1e293b;
    }


    .progress-bar span {
      display: block;

      width: 0;
      height: 100%;

      border-radius: inherit;

      background:
        linear-gradient(
          90deg,
          var(--primary),
          var(--cyan)
        );

      transition: width .45s ease;
    }


    .result-stats {
      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 10px;
    }


    .number-box {
      padding: 12px;

      border-radius: 11px;

      background: var(--card);

      border: 1px solid var(--border);

      transition: background .3s ease;
    }


    .number-box span {
      display: flex;
      align-items: center;
      gap: 6px;

      color: var(--muted);

      font-size: 10px;
    }


    .number-box strong {
      display: block;

      margin-top: 5px;

      color: var(--text);

      font-family: "JetBrains Mono", monospace;

      font-size: 13px;
    }


    /* ================= TOOL STATS ================= */

    .tool-stats {
      display: grid;

      grid-template-columns:
        repeat(4, 1fr);

      gap: 10px;

      padding: 0 16px 16px;
    }


    .stat-card {
      display: flex;
      align-items: center;
      gap: 10px;

      padding: 12px;

      border-radius: 13px;

      background: var(--soft);

      border: 1px solid var(--border);
    }


    .stat-icon {
      width: 37px;
      height: 37px;

      display: grid;
      place-items: center;

      flex: 0 0 37px;

      border-radius: 10px;
    }


    .stat-icon.blue {
      color: var(--blue);
      background: rgba(37, 99, 235, .1);
    }


    .stat-icon.green {
      color: var(--green);
      background: rgba(22, 163, 74, .1);
    }


    .stat-icon.purple {
      color: var(--purple);
      background: rgba(124, 58, 237, .1);
    }


    .stat-icon.orange {
      color: var(--orange);
      background: rgba(234, 88, 12, .1);
    }


    .stat-card strong,
    .stat-card span {
      display: block;
    }


    .stat-card strong {
      font-size: 12px;
    }


    .stat-card span {
      margin-top: 2px;

      color: var(--muted);

      font-size: 10px;
    }


    /* ================= SECTIONS ================= */

    .info-section,
    .faq-section {
      padding: 70px 0;

      background: var(--card);

      border-top: 1px solid var(--border);
    }


    .how-section {
      padding: 70px 0;

      background: var(--bg);

      border-top: 1px solid var(--border);
    }


    .section-heading {
      max-width: 700px;

      margin: 0 auto 38px;

      text-align: center;
    }


    .section-heading h2 {
      margin: 13px 0 8px;

      font-size: clamp(24px, 4vw, 34px);

      color: var(--text);
    }


    .section-heading p {
      margin: 0;

      color: var(--muted);

      line-height: 1.9;

      font-size: 14px;
    }


    /* ================= INFO CARDS ================= */

    .info-grid {
      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 16px;
    }


    .info-card {
      padding: 25px;

      border-radius: 18px;

      background: var(--bg);

      border: 1px solid var(--border);

      transition:
        transform .25s ease,
        background .3s ease,
        border-color .25s ease;
    }


    .info-card:hover {
      transform: translateY(-4px);

      border-color: rgba(8, 145, 178, .35);
    }


    .info-icon {
      width: 50px;
      height: 50px;

      display: grid;
      place-items: center;

      margin-bottom: 18px;

      border-radius: 14px;

      font-size: 19px;
    }


    .info-icon.blue {
      color: var(--blue);
      background: rgba(37, 99, 235, .1);
    }


    .info-icon.green {
      color: var(--green);
      background: rgba(22, 163, 74, .1);
    }


    .info-icon.purple {
      color: var(--purple);
      background: rgba(124, 58, 237, .1);
    }


    .info-card h3 {
      margin: 0 0 8px;

      font-size: 16px;
    }


    .info-card p {
      margin: 0;

      color: var(--muted);

      font-size: 13px;

      line-height: 1.9;
    }


    /* ================= STEPS ================= */

    .steps-grid {
      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 16px;
    }


    .step {
      position: relative;

      padding: 27px;

      border-radius: 18px;

      background: var(--card);

      border: 1px solid var(--border);

      overflow: hidden;
    }


    .step-number {
      position: absolute;

      top: 14px;
      left: 18px;

      color: rgba(8, 145, 178, .12);

      font-family: "JetBrains Mono", monospace;

      font-size: 34px;

      font-weight: 700;
    }


    .step-icon {
      width: 50px;
      height: 50px;

      display: grid;
      place-items: center;

      margin-bottom: 18px;

      border-radius: 14px;

      color: var(--primary);

      background: rgba(8, 145, 178, .1);
    }


    .step h3 {
      margin: 0 0 8px;

      font-size: 16px;
    }


    .step p {
      margin: 0;

      color: var(--muted);

      font-size: 13px;

      line-height: 1.9;
    }


    /* ================= FAQ ================= */

    .faq-list {
      max-width: 900px;

      margin: auto;

      display: grid;

      gap: 10px;
    }


    .faq-item {
      border: 1px solid var(--border);

      border-radius: 14px;

      background: var(--bg);

      overflow: hidden;

      transition:
        background .3s ease,
        border-color .25s ease;
    }


    .faq-item summary {
      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 15px;

      padding: 18px 20px;

      cursor: pointer;

      list-style: none;

      color: var(--text);

      font-size: 13px;
      font-weight: 700;
    }


    .faq-item summary::-webkit-details-marker {
      display: none;
    }


    .faq-item summary i {
      color: var(--primary);

      font-size: 11px;

      transition: transform .25s ease;
    }


    .faq-item[open] summary i {
      transform: rotate(180deg);
    }


    .faq-answer {
      padding: 0 20px 18px;

      border-top: 1px solid var(--border);
    }


    .faq-answer p {
      margin: 14px 0 0;

      color: var(--muted);

      font-size: 13px;

      line-height: 1.9;
    }


    /* ================= DARK TEXT OVERRIDES ================= */

    :global(html.dark) .hero p,
    :global(html.dark) .section-heading p,
    :global(html.dark) .info-card p,
    :global(html.dark) .step p,
    :global(html.dark) .faq-answer p {
      color: #94a3b8;
    }


    :global(html.dark) .breadcrumb a {
      color: #94a3b8;
    }


    :global(html.dark) .breadcrumb span {
      color: #67e8f9;
    }


    :global(html.dark) .info-card,
    :global(html.dark) .step {
      background: var(--soft);
    }


    :global(html.dark) .faq-item {
      background: var(--soft);
    }


    /* ================= RESPONSIVE ================= */

    @media (max-width: 900px) {

      .hero-content {
        align-items: flex-start;
      }


      .hero-icon {
        width: 92px;
        height: 92px;
        flex-basis: 92px;

        border-radius: 24px;

        font-size: 36px;
      }


      .editors-grid {
        grid-template-columns: 1fr;
      }


      .info-grid,
      .steps-grid {
        grid-template-columns: 1fr;
      }


      .tool-stats {
        grid-template-columns:
          repeat(2, 1fr);
      }

    }


    @media (max-width: 640px) {

      .container {
        width: min(100% - 22px, 1180px);
      }


      .hero {
        padding: 20px 0 42px;
      }


      .breadcrumb {
        margin-bottom: 24px;

        font-size: 11px;

        flex-wrap: wrap;
      }


      .hero-content {
        flex-direction: column;

        gap: 20px;
      }


      .hero-icon {
        width: 82px;
        height: 82px;

        flex-basis: 82px;

        font-size: 31px;

        border-radius: 22px;
      }


      .mini-icon {
        width: 32px;
        height: 32px;

        font-size: 13px;

        border-radius: 9px;
      }


      .hero h1 {
        font-size: 32px;
      }


      .hero h1 span {
        font-size: 15px;
      }


      .hero p {
        font-size: 13px;
      }


      .hero-features span {
        font-size: 10px;
      }


      .tool-section {
        padding: 30px 0;
      }


      .tool-topbar {
        padding: 13px;

        align-items: flex-start;
      }


      .tool-status {
        font-size: 10px;
      }


      .actionbar {
        display: grid;

        grid-template-columns:
          repeat(2, 1fr);

        padding: 10px;
      }


      .action-btn {
        width: 100%;

        padding: 0 8px;

        font-size: 11px;
      }


      .action-btn.primary {
        margin-right: 0;

        grid-column: span 2;
      }


      .editor-body,
      textarea {
        min-height: 300px;
      }


      .line-numbers {
        width: 43px;
        flex-basis: 43px;

        padding-left: 8px;
        padding-right: 8px;
      }


      textarea {
        padding: 15px;

        font-size: 11px;
      }


      .result-panel {
        margin: 10px;

        padding: 13px;
      }


      .result-stats {
        grid-template-columns: 1fr;

      }


      .tool-stats {
        grid-template-columns: 1fr 1fr;

        padding: 0 10px 10px;
      }


      .stat-card {
        padding: 10px;
      }


      .stat-card strong {
        font-size: 10px;
      }


      .stat-card span {
        font-size: 9px;
      }


      .info-section,
      .faq-section,
      .how-section {
        padding: 50px 0;
      }


      .section-heading {
        margin-bottom: 28px;
      }


      .section-heading h2 {
        font-size: 25px;
      }


      .section-heading p {
        font-size: 12px;
      }


      .info-card,
      .step {
        padding: 20px;
      }


      .faq-item summary {
        padding: 15px;

        font-size: 12px;
      }


      .faq-answer {
        padding: 0 15px 15px;
      }

    }


    @media (max-width: 390px) {

      .tool-stats {
        grid-template-columns: 1fr;
      }


      .hero-features {
        gap: 6px;
      }


      .hero-features span {
        padding: 7px 9px;
      }

    }

  </style>
</body>
</html>
