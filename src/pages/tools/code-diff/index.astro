    .info-card h3 {
      margin: 0 0 5px;
      font-size: 14px;
      font-weight: 800;
    }

    .info-card p {
      margin: 0;
      color: var(--muted);
      font-size: 11px;
      line-height: 1.9;
    }


    /* STEPS */

    .steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }

    .step {
      display: flex;
      gap: 12px;
      padding: 18px;
      border: 1px solid var(--border);
      border-radius: 16px;
      background: var(--surface);
    }

    .step-number {
      width: 34px;
      height: 34px;
      flex: 0 0 34px;
