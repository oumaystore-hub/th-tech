      font-size: 20px;
      font-weight: 800;
    }

    .section-heading p {
      margin: 2px 0 0;
      color: var(--muted);
      font-size: 11px;
    }


    /* INFO CARDS */

    .info-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }

    .info-card {
      padding: 20px;
      border: 1px solid var(--border);
      border-radius: 16px;
