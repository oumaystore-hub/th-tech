      gap: 6px;
      padding: 5px 9px;
      border-radius: 8px;
      color: var(--muted);
      background: #f1f5f9;
      font-size: 10px;
      font-weight: 700;
      white-space: nowrap;
    }

    .diff-output {
      max-height: 430px;
      overflow: auto;
      background: #0b1220;
      direction: ltr;
    }

    .empty-result {
      min-height: 210px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 30px 20px;
      text-align: center;
      direction: rtl;
    }

    .empty-icon {
      width: 55px;
      height: 55px;
      display: grid;
      place-items: center;
      margin-bottom: 12px;
      border-radius: 15px;
      color: #93c5fd;
      background: rgba(37, 99, 235, 0.14);
      font-size: 21px;
    }

    .empty-icon.warning {
      color: #fbbf24;
      background: rgba(245, 158, 11, 0.12);
    }

    .empty-result h4 {
      margin: 0;
      color: #e2e8f0;
      font-size: 14px;
    }

    .empty-result p {
      max-width: 480px;
      margin: 6px 0 0;
      color: #64748b;
      font-size: 11px;
      line-height: 1.8;
    }

    .diff-row {
      min-height: 31px;
      display: grid;
      grid-template-columns: 55px 55px 38px 1fr;
      align-items: stretch;
      border-bottom: 1px solid rgba(148, 163, 184, 0.08);
      font-family: "Courier New", Consolas, monospace;
      font-size: 12px;
      line-height: 1.7;
    }

    .diff-row:last-child {
      border-bottom: 0;
    }

    .diff-row .diff-line {
      display: flex;
      align-items: center;
      justify-content: center;
      color: #64748b;
      border-right: 1px solid rgba(148, 163, 184, 0.1);
      user-select: none;
    }

    .diff-row .diff-symbol {
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      border-right: 1px solid rgba(148, 163, 184, 0.1);
    }

    .diff-row code {
      display: block;
      padding: 5px 12px;
      color: #cbd5e1;
      white-space: pre;
      overflow-x: auto;
      text-align: left;
    }

    .diff-added {
      background: rgba(22, 163, 74, 0.13);
    }

    .diff-added .diff-symbol {
      color: #4ade80;
    }

    .diff-added code {
      color: #bbf7d0;
    }

    .diff-removed {
      background: rgba(220, 38, 38, 0.13);
    }

    .diff-removed .diff-symbol {
      color: #f87171;
    }

    .diff-removed code {
      color: #fecaca;
    }

    .diff-same .diff-symbol {
      color: #64748b;
    }


    /* STATS */

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      padding: 0 16px 16px;
    }

    .stat-card {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
      padding: 13px;
      border: 1px solid var(--border);
      border-radius: 13px;
      background: #fff;
    }

    .stat-icon {
      width: 38px;
      height: 38px;
      flex: 0 0 38px;
      display: grid;
      place-items: center;
      border-radius: 10px;
    }

    .original-stat {
      color: #64748b;
      background: #f1f5f9;
    }

    .modified-stat {
      color: var(--primary);
      background: #eff6ff;
    }

    .added-stat {
      color: var(--green);
      background: var(--green-bg);
    }

    .removed-stat {
      color: var(--red);
      background: var(--red-bg);
    }

    .stat-card span {
      display: block;
      color: var(--muted);
      font-size: 10px;
      white-space: nowrap;
    }

    .stat-card strong {
      display: block;
      margin-top: 1px;
      font-size: 19px;
      line-height: 1.2;
      direction: ltr;
      text-align: right;
    }


    /* SECTIONS */

    .info-section,
    .guide-section,
    .faq-section {
      margin-top: 52px;
    }

    .section-heading {
      display: flex;
