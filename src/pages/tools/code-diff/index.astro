---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "Code Diff - مقارنة الأكواد | Th.Tech";
const description =
  "أداة Code Diff مجانية لمقارنة الأكواد واكتشاف الأسطر المضافة والمحذوفة والمتطابقة.";
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  />
</head>

<body>

  <Header />

  <main class="tool-page">

    <!-- HERO -->
    <section class="hero">

      <div class="hero-content">

        <div class="tool-badge">
          <i class="fa-solid fa-code-compare"></i>
          Developer Tool #39
        </div>

        <h1>
          Code Diff
          <span>مقارنة الأكواد</span>
        </h1>

        <p>
          قارن بين نسختين من الكود واكتشف الأسطر المضافة والمحذوفة
          والمتطابقة بسهولة.
        </p>

      </div>

      <div class="hero-icon">
        <i class="fa-solid fa-code-compare"></i>
      </div>

    </section>


    <!-- TOOL -->
    <section class="tool-container">

      <!-- TOOL TOP -->
      <div class="tool-top">

        <div class="tool-heading">

          <div class="tool-heading-icon">
            <i class="fa-solid fa-code-compare"></i>
          </div>

          <div>
            <h2>Code Diff</h2>
            <p>Compare two versions of your code</p>
          </div>

        </div>

        <div class="ready-status" id="status">
          <span></span>
          جاهز
        </div>

      </div>


      <!-- ACTION BAR -->
      <div class="action-bar">

        <button id="compareBtn" class="btn btn-primary">
          <i class="fa-solid fa-code-compare"></i>
          مقارنة
        </button>

        <button id="swapBtn" class="btn btn-secondary">
          <i class="fa-solid fa-arrow-right-arrow-left"></i>
          تبديل
        </button>

        <button id="copyBtn" class="btn btn-secondary">
          <i class="fa-solid fa-copy"></i>
          نسخ
        </button>

        <button id="clearBtn" class="btn btn-danger">
          <i class="fa-solid fa-trash"></i>
          مسح
        </button>

        <div class="language-select">
          <i class="fa-solid fa-code"></i>

          <select id="language">
            <option value="auto">لغة الكود: تلقائي</option>
            <option value="javascript">JavaScript</option>
            <option value="typescript">TypeScript</option>
            <option value="html">HTML</option>
            <option value="css">CSS</option>
            <option value="json">JSON</option>
            <option value="python">Python</option>
            <option value="sql">SQL</option>
            <option value="php">PHP</option>
          </select>
        </div>

      </div>


      <!-- EDITORS -->
      <div class="editors-grid">

        <!-- ORIGINAL -->
        <div class="editor-card original">

          <div class="editor-card-header">

            <div class="editor-title">

              <div class="editor-title-icon">
                <i class="fa-solid fa-file-code"></i>
              </div>

              <div>
                <strong>Original</strong>
                <small>الكود الأصلي</small>
              </div>

            </div>

            <span class="editor-label removed">
              <i class="fa-solid fa-minus"></i>
              Removed
            </span>

          </div>


          <div class="code-editor">

            <div class="line-numbers" id="oldNumbers">0</div>

            <textarea
              id="oldCode"
              spellcheck="false"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              placeholder="// الصق الكود الأصلي هنا..."
            ></textarea>

          </div>


          <div class="editor-footer">
            <span>
              <i class="fa-solid fa-lines-leaning"></i>
              <b id="oldLineCount">0</b> أسطر
            </span>

            <span>Original</span>
          </div>

        </div>


        <!-- MODIFIED -->
        <div class="editor-card modified">

          <div class="editor-card-header">

            <div class="editor-title">

              <div class="editor-title-icon">
                <i class="fa-solid fa-file-circle-plus"></i>
              </div>

              <div>
                <strong>Modified</strong>
                <small>الكود المعدّل</small>
              </div>

            </div>

            <span class="editor-label added">
              <i class="fa-solid fa-plus"></i>
              Added
            </span>

          </div>


          <div class="code-editor">

            <div class="line-numbers" id="newNumbers">0</div>

            <textarea
              id="newCode"
              spellcheck="false"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              placeholder="// الصق الكود المعدّل هنا..."
            ></textarea>

          </div>


          <div class="editor-footer">
            <span>
              <i class="fa-solid fa-lines-leaning"></i>
              <b id="newLineCount">0</b> أسطر
            </span>

            <span>Modified</span>
          </div>

        </div>

      </div>


      <!-- RESULT -->
      <div class="result-card">

        <div class="result-top">

          <div class="result-heading">

            <div class="result-icon">
              <i class="fa-solid fa-code-compare"></i>
            </div>

            <div>
              <h3>نتيجة المقارنة</h3>
              <p id="resultDescription">
                ستظهر الفروقات بين الكودين هنا
              </p>
            </div>

          </div>

          <div class="result-status" id="resultState">
            <i class="fa-solid fa-circle-info"></i>
            لم تتم المقارنة
          </div>

        </div>


        <div class="diff-output" id="diffOutput">

          <div class="empty-state">

            <div class="empty-icon">
              <i class="fa-solid fa-code-compare"></i>
            </div>

            <h4>ابدأ مقارنة الأكواد</h4>

            <p>
              أدخل النسخة الأصلية والنسخة المعدّلة ثم اضغط على
              <strong>مقارنة</strong>.
            </p>

          </div>

        </div>

      </div>


      <!-- STATS -->
      <div class="stats-grid">

        <div class="stat-card">
          <div class="stat-icon blue">
            <i class="fa-solid fa-file-code"></i>
          </div>

          <div>
            <span>الأسطر الأصلية</span>
            <strong id="statOld">0</strong>
          </div>
        </div>


        <div class="stat-card">
          <div class="stat-icon indigo">
            <i class="fa-solid fa-file-circle-plus"></i>
          </div>

          <div>
            <span>الأسطر الجديدة</span>
            <strong id="statNew">0</strong>
          </div>
        </div>


        <div class="stat-card">
          <div class="stat-icon green">
            <i class="fa-solid fa-plus"></i>
          </div>

          <div>
            <span>الأسطر المضافة</span>
            <strong id="statAdded">0</strong>
          </div>
        </div>


        <div class="stat-card">
          <div class="stat-icon red">
            <i class="fa-solid fa-minus"></i>
          </div>

          <div>
            <span>الأسطر المحذوفة</span>
            <strong id="statRemoved">0</strong>
          </div>
        </div>

      </div>

    </section>


    <!-- FEATURES -->
    <section class="content-section">

      <div class="section-title">
        <div class="section-icon">
          <i class="fa-solid fa-circle-info"></i>
        </div>

        <div>
          <h2>مميزات Code Diff</h2>
          <p>أداة بسيطة وسريعة للمطورين</p>
        </div>
      </div>


      <div class="feature-grid">

        <div class="feature-card">
          <div class="feature-icon">
            <i class="fa-solid fa-bolt"></i>
          </div>

          <h3>مقارنة سريعة</h3>

          <p>
            اكتشف الفروقات بين نسختين من الكود في ثوانٍ.
          </p>
        </div>


        <div class="feature-card">
          <div class="feature-icon">
            <i class="fa-solid fa-shield-halved"></i>
          </div>

          <h3>معالجة محلية</h3>

          <p>
            تتم المقارنة داخل المتصفح دون الحاجة إلى رفع الكود.
          </p>
        </div>


        <div class="feature-card">
          <div class="feature-icon">
            <i class="fa-solid fa-code"></i>
          </div>

          <h3>لغات متعددة</h3>

          <p>
            مناسبة لـ JavaScript وTypeScript وHTML وCSS وJSON وغيرها.
          </p>
        </div>

      </div>

    </section>


    <!-- HOW TO -->
    <section class="content-section">

      <div class="section-title">
        <div class="section-icon">
          <i class="fa-solid fa-list-check"></i>
        </div>

        <div>
          <h2>كيفية استخدام الأداة</h2>
          <p>قارن الأكواد في ثلاث خطوات</p>
        </div>
      </div>


      <div class="steps-grid">

        <div class="step-card">

          <div class="step-number">1</div>

          <div>
            <h3>أدخل الكود الأصلي</h3>
            <p>
              الصق النسخة القديمة في Original.
            </p>
          </div>

        </div>


        <div class="step-card">

          <div class="step-number">2</div>

          <div>
            <h3>أدخل الكود المعدّل</h3>
            <p>
              الصق النسخة الجديدة في Modified.
            </p>
          </div>

        </div>


        <div class="step-card">

          <div class="step-number">3</div>

          <div>
            <h3>قارن النتائج</h3>
            <p>
              اضغط مقارنة وشاهد جميع الاختلافات.
            </p>
          </div>

        </div>

      </div>

    </section>


    <!-- FAQ -->
    <section class="content-section faq-section">

      <div class="section-title">
        <div class="section-icon">
          <i class="fa-solid fa-circle-question"></i>
        </div>

        <div>
          <h2>الأسئلة الشائعة</h2>
          <p>إجابات عن أهم الأسئلة</p>
        </div>
      </div>


      <div class="faq-list">

        <details>
          <summary>
            هل الكود الذي أدخله يتم رفعه إلى الخادم؟
            <i class="fa-solid fa-chevron-down"></i>
          </summary>

          <p>
            لا، عملية المقارنة تتم محليًا داخل المتصفح.
          </p>
        </details>


        <details>
          <summary>
            ماذا تعني الأسطر الخضراء والحمراء؟
            <i class="fa-solid fa-chevron-down"></i>
          </summary>

          <p>
            الأخضر يمثل الأسطر المضافة، والأحمر يمثل الأسطر المحذوفة
            من النسخة الأصلية.
          </p>
        </details>


        <details>
          <summary>
            هل تعمل الأداة مع جميع لغات البرمجة؟
            <i class="fa-solid fa-chevron-down"></i>
          </summary>

          <p>
            نعم، المقارنة تعتمد على محتوى النص، لذلك يمكن استخدامها
            مع معظم لغات البرمجة والملفات النصية.
          </p>
        </details>

      </div>

    </section>

  </main>

  <Footer />


  <script is:inline>

    const oldCode = document.getElementById("oldCode");
    const newCode = document.getElementById("newCode");

    const oldNumbers = document.getElementById("oldNumbers");
    const newNumbers = document.getElementById("newNumbers");

    const oldLineCount = document.getElementById("oldLineCount");
    const newLineCount = document.getElementById("newLineCount");

    const statOld = document.getElementById("statOld");
    const statNew = document.getElementById("statNew");
    const statAdded = document.getElementById("statAdded");
    const statRemoved = document.getElementById("statRemoved");

    const diffOutput = document.getElementById("diffOutput");

    const status = document.getElementById("status");
    const resultState = document.getElementById("resultState");
    const resultDescription = document.getElementById("resultDescription");

    const compareBtn = document.getElementById("compareBtn");
    const swapBtn = document.getElementById("swapBtn");
    const copyBtn = document.getElementById("copyBtn");
    const clearBtn = document.getElementById("clearBtn");


    function getLines(text) {

      if (!text) {
        return [];
      }

      return text
        .replace(/\r\n/g, "\n")
        .replace(/\r/g, "\n")
        .split("\n");
    }


    function updateLineNumbers() {

      const oldLines = getLines(oldCode.value);
      const newLines = getLines(newCode.value);

      if (oldLines.length === 0) {

        oldNumbers.textContent = "0";
        oldLineCount.textContent = "0";

      } else {

        oldNumbers.textContent = oldLines
          .map(function (_, i) {
            return String(i + 1);
          })
          .join("\n");

        oldLineCount.textContent = String(oldLines.length);
      }


      if (newLines.length === 0) {

        newNumbers.textContent = "0";
        newLineCount.textContent = "0";

      } else {

        newNumbers.textContent = newLines
          .map(function (_, i) {
            return String(i + 1);
          })
          .join("\n");

        newLineCount.textContent = String(newLines.length);
      }


      statOld.textContent = String(oldLines.length);
      statNew.textContent = String(newLines.length);
    }


    function escapeHtml(text) {

      return text
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }


    function buildDiff(oldLines, newLines) {

      const m = oldLines.length;
      const n = newLines.length;

      const matrix = [];

      for (let i = 0; i <= m; i++) {
        matrix[i] = new Array(n + 1).fill(0);
      }


      for (let i = m - 1; i >= 0; i--) {

        for (let j = n - 1; j >= 0; j--) {

          if (oldLines[i] === newLines[j]) {

            matrix[i][j] =
              matrix[i + 1][j + 1] + 1;

          } else {

            matrix[i][j] =
              Math.max(
                matrix[i + 1][j],
                matrix[i][j + 1]
              );
          }
        }
      }


      const result = [];

      let i = 0;
      let j = 0;


      while (i < m && j < n) {

        if (oldLines[i] === newLines[j]) {

          result.push({
            type: "same",
            oldLine: i + 1,
            newLine: j + 1,
            text: oldLines[i]
          });

          i++;
          j++;

        } else if (
          matrix[i + 1][j] >=
          matrix[i][j + 1]
        ) {

          result.push({
            type: "removed",
            oldLine: i + 1,
            newLine: "",
            text: oldLines[i]
          });

          i++;

        } else {

          result.push({
            type: "added",
            oldLine: "",
            newLine: j + 1,
            text: newLines[j]
          });

          j++;
        }
      }


      while (i < m) {

        result.push({
          type: "removed",
          oldLine: i + 1,
          newLine: "",
          text: oldLines[i]
        });

        i++;
      }


      while (j < n) {

        result.push({
          type: "added",
          oldLine: "",
          newLine: j + 1,
          text: newLines[j]
        });

        j++;
      }


      return result;
    }


    function renderDiff(rows) {

      if (!rows.length) {

        return `
          <div class="empty-state">
            <div class="empty-icon">
              <i class="fa-solid fa-code-compare"></i>
            </div>

            <h4>لا توجد بيانات للمقارنة</h4>

            <p>
              أدخل الكود في المربعين ثم حاول مرة أخرى.
            </p>
          </div>
        `;
      }


      let html = "";


      rows.forEach(function (row) {

        let typeClass = "same";
        let symbol = "=";


        if (row.type === "added") {

          typeClass = "added";
          symbol = "+";

        } else if (row.type === "removed") {

          typeClass = "removed";
          symbol = "-";
        }


        html += `
          <div class="diff-row ${typeClass}">

            <span class="diff-number">
              ${row.oldLine}
            </span>

            <span class="diff-number">
              ${row.newLine}
            </span>

            <span class="diff-symbol">
              ${symbol}
            </span>

            <code>${escapeHtml(row.text)}</code>

          </div>
        `;
      });


      return html;
    }


    function compareCodes() {

      const oldLines = getLines(oldCode.value);
      const newLines = getLines(newCode.value);


      if (
        oldLines.length === 0 &&
        newLines.length === 0
      ) {

        status.innerHTML =
          '<span></span> أدخل الكود أولاً';

        resultState.innerHTML =
          '<i class="fa-solid fa-circle-exclamation"></i> لا توجد بيانات';

        resultDescription.textContent =
          "أدخل الكود الأصلي والكود المعدّل للمقارنة.";

        diffOutput.innerHTML = `
          <div class="empty-state">
            <div class="empty-icon warning">
              <i class="fa-solid fa-file-code"></i>
            </div>

            <h4>لا توجد أكواد للمقارنة</h4>

            <p>
              أدخل الكود في أحد المربعين أو كليهما.
            </p>
          </div>
        `;

        statOld.textContent = "0";
        statNew.textContent = "0";
        statAdded.textContent = "0";
        statRemoved.textContent = "0";

        return;
      }


      const rows = buildDiff(
        oldLines,
        newLines
      );


      let added = 0;
      let removed = 0;


      rows.forEach(function (row) {

        if (row.type === "added") {
          added++;
        }

        if (row.type === "removed") {
          removed++;
        }
      });


      statOld.textContent =
        String(oldLines.length);

      statNew.textContent =
        String(newLines.length);

      statAdded.textContent =
        String(added);

      statRemoved.textContent =
        String(removed);


      diffOutput.innerHTML =
        renderDiff(rows);


      if (
        added === 0 &&
        removed === 0
      ) {

        status.innerHTML =
          '<span class="success"></span> الأكواد متطابقة';

        resultState.innerHTML =
          '<i class="fa-solid fa-check"></i> متطابق';

        resultDescription.textContent =
          "لم يتم العثور على اختلافات.";

      } else {

        status.innerHTML =
          '<span class="changed"></span> تم العثور على اختلافات';

        resultState.innerHTML =
          '<i class="fa-solid fa-code-branch"></i> مختلف';

        resultDescription.textContent =
          added +
          " أسطر مضافة و " +
          removed +
          " أسطر محذوفة.";
      }
    }


    function swapEditors() {

      const temp = oldCode.value;

      oldCode.value =
        newCode.value;

      newCode.value =
        temp;

      updateLineNumbers();
      compareCodes();
    }


    async function copyResult() {

      const rows =
        diffOutput.querySelectorAll(".diff-row");


      if (!rows.length) {

        status.innerHTML =
          '<span></span> لا توجد نتيجة لنسخها';

        return;
      }


      let text = "";


      rows.forEach(function (row) {

        const symbol =
          row.querySelector(".diff-symbol");

        const code =
          row.querySelector("code");


        if (symbol && code) {

          text +=
            symbol.textContent.trim() +
            " " +
            code.textContent +
            "\n";
        }
      });


      try {

        await navigator.clipboard.writeText(text);

        status.innerHTML =
          '<span class="success"></span> تم نسخ النتيجة';

        setTimeout(function () {

          status.innerHTML =
            '<span></span> جاهز';

        }, 1800);

      } catch (error) {

        status.innerHTML =
          '<span></span> تعذر النسخ';
      }
    }


    function clearAll() {

      oldCode.value = "";
      newCode.value = "";

      updateLineNumbers();


      diffOutput.innerHTML = `
        <div class="empty-state">

          <div class="empty-icon">
            <i class="fa-solid fa-code-compare"></i>
          </div>

          <h4>ابدأ مقارنة الأكواد</h4>

          <p>
            أدخل النسخة الأصلية والنسخة المعدّلة ثم اضغط على
            <strong>مقارنة</strong>.
          </p>

        </div>
      `;


      statOld.textContent = "0";
      statNew.textContent = "0";
      statAdded.textContent = "0";
      statRemoved.textContent = "0";


      resultState.innerHTML =
        '<i class="fa-solid fa-circle-info"></i> لم تتم المقارنة';

      resultDescription.textContent =
        "ستظهر الفروقات بين الكودين هنا";


      status.innerHTML =
        '<span></span> جاهز';
    }


    function enableTab(textarea) {

      textarea.addEventListener(
        "keydown",
        function (event) {

          if (event.key !== "Tab") {
            return;
          }

          event.preventDefault();


          const start =
            textarea.selectionStart;

          const end =
            textarea.selectionEnd;


          textarea.value =
            textarea.value.substring(0, start) +
            "  " +
            textarea.value.substring(end);


          textarea.selectionStart =
            start + 2;

          textarea.selectionEnd =
            start + 2;


          updateLineNumbers();
        }
      );
    }


    oldCode.addEventListener(
      "input",
      updateLineNumbers
    );

    newCode.addEventListener(
      "input",
      updateLineNumbers
    );


    compareBtn.addEventListener(
      "click",
      compareCodes
    );

    swapBtn.addEventListener(
      "click",
      swapEditors
    );

    copyBtn.addEventListener(
      "click",
      copyResult
    );

    clearBtn.addEventListener(
      "click",
      clearAll
    );


    enableTab(oldCode);
    enableTab(newCode);


    updateLineNumbers();

  </script>


  <style>

    :root {
      --primary: #4f46e5;
      --primary-dark: #4338ca;
      --secondary: #6366f1;
      --accent: #818cf8;

      --bg: #f6f7fb;
      --surface: #ffffff;
      --surface-soft: #f8f9fc;

      --text: #111827;
      --muted: #64748b;

      --border: #e5e7eb;

      --green: #16a34a;
      --red: #dc2626;

      --shadow:
        0 12px 35px rgba(15, 23, 42, 0.07);
    }


    * {
      box-sizing: border-box;
    }


    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: "Cairo", sans-serif;
    }


    button,
    select,
    textarea {
      font-family: inherit;
    }


    .tool-page {
      width: min(1160px, calc(100% - 30px));
      margin: auto;
      padding: 42px 0 70px;
    }


    /* HERO */

    .hero {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 25px;
      margin-bottom: 28px;
    }


    .hero-content {
      min-width: 0;
    }


    .tool-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;

      padding: 6px 11px;

      border: 1px solid #c7d2fe;
      border-radius: 999px;

      color: var(--primary);
      background: #eef2ff;

      font-size: 11px;
      font-weight: 700;
    }


    .hero h1 {
      margin: 10px 0 5px;

      font-size: clamp(28px, 4vw, 42px);
      line-height: 1.2;

      font-weight: 800;
      letter-spacing: -0.7px;
    }


    .hero h1 span {
      color: var(--primary);
    }


    .hero p {
      margin: 0;

      max-width: 650px;

      color: var(--muted);

      font-size: 13px;
      line-height: 1.9;
    }


    .hero-icon {
      width: 76px;
      height: 76px;

      flex: 0 0 76px;

      display: grid;
      place-items: center;

      border-radius: 22px;

      color: white;

      background:
        linear-gradient(
          135deg,
          var(--primary),
          var(--secondary)
        );

      font-size: 30px;

      box-shadow:
        0 14px 30px rgba(79, 70, 229, 0.23);
    }


    /* MAIN TOOL */

    .tool-container {
      overflow: hidden;

      border: 1px solid var(--border);
      border-radius: 20px;

      background: var(--surface);

      box-shadow: var(--shadow);
    }


    .tool-top {
      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 15px;

      padding: 18px 20px;

      border-bottom: 1px solid var(--border);
    }


    .tool-heading {
      display: flex;
      align-items: center;
      gap: 12px;
    }


    .tool-heading-icon {
      width: 43px;
      height: 43px;

      display: grid;
      place-items: center;

      border-radius: 12px;

      color: var(--primary);
      background: #eef2ff;

      font-size: 18px;
    }


    .tool-heading h2 {
      margin: 0;

      font-size: 16px;
      font-weight: 800;
    }


    .tool-heading p {
      margin: 2px 0 0;

      color: var(--muted);

      font-size: 10px;
      direction: ltr;
      text-align: right;
    }


    .ready-status {
      display: flex;
      align-items: center;
      gap: 7px;

      color: var(--muted);

      font-size: 11px;
      font-weight: 600;
    }


    .ready-status span,
    .ready-status .success,
    .ready-status .changed {
      width: 8px;
      height: 8px;

      display: inline-block;

      border-radius: 50%;

      background: #94a3b8;
    }


    .ready-status .success {
      background: var(--green);
    }


    .ready-status .changed {
      background: #f59e0b;
    }


    /* ACTION BAR */

    .action-bar {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;

      padding: 12px 16px;

      background: var(--surface-soft);

      border-bottom: 1px solid var(--border);
    }


    .btn {
      height: 37px;

      display: inline-flex;
      align-items: center;
      justify-content: center;

      gap: 7px;

      padding: 0 13px;

      border-radius: 9px;

      border: 1px solid var(--border);

      cursor: pointer;

      font-size: 11px;
      font-weight: 700;

      transition: 0.2s ease;
    }


    .btn:hover {
      transform: translateY(-1px);
    }


    .btn-primary {
      color: white;

      border-color: var(--primary);

      background: var(--primary);
    }


    .btn-primary:hover {
      background: var(--primary-dark);
    }


    .btn-secondary {
      color: #475569;

      background: white;
    }


    .btn-secondary:hover {
      color: var(--primary);
      border-color: #c7d2fe;
    }


    .btn-danger {
      color: var(--red);
      background: white;
    }


    .btn-danger:hover {
      border-color: #fecaca;
      background: #fff7f7;
    }


    .language-select {
      height: 37px;

      margin-right: auto;

      display: flex;
      align-items: center;
      gap: 7px;

      padding: 0 10px;

      border: 1px solid var(--border);
      border-radius: 9px;

      color: var(--muted);

      background: white;
    }


    .language-select select {
      border: 0;
      outline: 0;

      color: #475569;
      background: transparent;

      font-size: 11px;
      font-weight: 600;

      cursor: pointer;
    }


    /* EDITORS */

    .editors-grid {
      display: grid;

      grid-template-columns: 1fr 1fr;

      gap: 14px;

      padding: 16px;

      background: #f1f4f9;
    }


    .editor-card {
      overflow: hidden;

      border: 1px solid #dbe2eb;
      border-radius: 14px;

      background: #0d1420;
    }


    .editor-card-header {
      height: 56px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      padding: 0 12px;

      background: #121b2a;

      border-bottom: 1px solid #253246;
    }


    .editor-title {
      display: flex;
      align-items: center;
      gap: 9px;
    }


    .editor-title-icon {
      width: 33px;
      height: 33px;

      display: grid;
      place-items: center;

      border-radius: 9px;
    }


    .original .editor-title-icon {
      color: #f87171;
      background: rgba(220, 38, 38, 0.13);
    }


    .modified .editor-title-icon {
      color: #4ade80;
      background: rgba(22, 163, 74, 0.13);
    }


    .editor-title strong {
      display: block;

      color: #f8fafc;

      font-size: 12px;

      direction: ltr;
      text-align: right;
    }


    .editor-title small {
      display: block;

      margin-top: 1px;

      color: #64748b;

      font-size: 9px;
    }


    .editor-label {
      display: inline-flex;
      align-items: center;
      gap: 5px;

      padding: 4px 8px;

      border-radius: 7px;

      font-size: 9px;
      font-weight: 800;

      direction: ltr;
    }


    .editor-label.removed {
      color: #fca5a5;
      background: rgba(220, 38, 38, 0.12);
    }


    .editor-label.added {
      color: #86efac;
      background: rgba(22, 163, 74, 0.12);
    }


    .code-editor {
      height: 340px;

      display: grid;

      grid-template-columns: 48px 1fr;

      direction: ltr;

      overflow: hidden;
    }


    .line-numbers {
      padding: 13px 7px;

      overflow: hidden;

      color: #475569;

      background: #090f19;

      border-right: 1px solid #1e293b;

      font-family:
        "Courier New",
        Consolas,
        monospace;

      font-size: 11px;

      line-height: 1.65;

      text-align: right;

      white-space: pre;

      user-select: none;
    }


    .code-editor textarea {
      width: 100%;
      height: 100%;

      resize: none;

      outline: 0;
      border: 0;

      padding: 13px 14px;

      color: #dbeafe;

      background: #0d1420;

      font-family:
        "Courier New",
        Consolas,
        monospace;

      font-size: 12px;

      line-height: 1.65;

      direction: ltr;
      text-align: left;

      white-space: pre;

      tab-size: 2;
    }


    .code-editor textarea::placeholder {
      color: #475569;
    }


    .code-editor textarea:focus {
      box-shadow:
        inset 0 0 0 1px
        rgba(99, 102, 241, 0.35);
    }


    .editor-footer {
      height: 32px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      padding: 0 11px;

      color: #64748b;

      background: #090f19;

      border-top: 1px solid #1e293b;

      font-size: 9px;
    }


    .editor-footer span {
      display: flex;
      align-items: center;
      gap: 5px;
    }


    /* RESULT */

    .result-card {
      margin: 0 16px 14px;

      overflow: hidden;

      border: 1px solid var(--border);
      border-radius: 14px;

      background: white;
    }


    .result-top {
      min-height: 62px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 12px;

      padding: 10px 13px;

      background: var(--surface-soft);

      border-bottom: 1px solid var(--border);
    }


    .result-heading {
      display: flex;
      align-items: center;
      gap: 10px;
    }


    .result-icon {
      width: 36px;
      height: 36px;

      display: grid;
      place-items: center;

      border-radius: 10px;

      color: var(--primary);
      background: #eef2ff;
    }


    .result-heading h3 {
      margin: 0;

      font-size: 13px;
      font-weight: 800;
    }


    .result-heading p {
      margin: 2px 0 0;

      color: var(--muted);

      font-size: 9px;
    }


    .result-status {
      display: inline-flex;
      align-items: center;
      gap: 6px;

      padding: 5px 9px;

      border-radius: 8px;

      color: var(--muted);

      background: #f1f5f9;

      font-size: 9px;
      font-weight: 700;
    }


    .diff-output {
      max-height: 410px;

      overflow: auto;

      background: #0d1420;

      direction: ltr;
    }


    .empty-state {
      min-height: 200px;

      display: flex;
      flex-direction: column;

      align-items: center;
      justify-content: center;

      padding: 25px;

      text-align: center;

      direction: rtl;
    }


    .empty-icon {
      width: 52px;
      height: 52px;

      display: grid;
      place-items: center;

      margin-bottom: 11px;

      border-radius: 14px;

      color: #a5b4fc;

      background: rgba(79, 70, 229, 0.13);

      font-size: 20px;
    }


    .empty-icon.warning {
      color: #fbbf24;
      background: rgba(245, 158, 11, 0.12);
    }


    .empty-state h4 {
      margin: 0;

      color: #e2e8f0;

      font-size: 13px;
    }


    .empty-state p {
      margin: 6px 0 0;

      color: #64748b;

      font-size: 10px;

      line-height: 1.8;
    }


    .diff-row {
      min-height: 30px;

      display: grid;

      grid-template-columns:
        52px
        52px
        32px
        1fr;

      align-items: stretch;

      border-bottom: 1px solid
        rgba(148, 163, 184, 0.07);

      font-family:
        "Courier New",
        Consolas,
        monospace;

      font-size: 11px;
    }


    .diff-number {
      display: flex;
      align-items: center;
      justify-content: center;

      color: #64748b;

      border-right: 1px solid
        rgba(148, 163, 184, 0.09);

      user-select: none;
    }


    .diff-symbol {
      display: flex;
      align-items: center;
      justify-content: center;

      border-right: 1px solid
        rgba(148, 163, 184, 0.09);

      font-weight: 800;
    }


    .diff-row code {
      padding: 5px 10px;

      color: #cbd5e1;

      white-space: pre;

      overflow-x: auto;

      text-align: left;
    }


    .diff-row.added {
      background: rgba(22, 163, 74, 0.13);
    }


    .diff-row.added .diff-symbol {
      color: #4ade80;
    }


    .diff-row.added code {
      color: #bbf7d0;
    }


    .diff-row.removed {
      background: rgba(220, 38, 38, 0.13);
    }


    .diff-row.removed .diff-symbol {
      color: #f87171;
    }


    .diff-row.removed code {
      color: #fecaca;
    }


    .diff-row.same .diff-symbol {
      color: #64748b;
    }


    /* STATS */

    .stats-grid {
      display: grid;

      grid-template-columns:
        repeat(4, 1fr);

      gap: 10px;

      padding: 0 16px 16px;
    }


    .stat-card {
      display: flex;
      align-items: center;

      gap: 9px;

      padding: 11px;

      border: 1px solid var(--border);
      border-radius: 12px;

      background: white;
    }


    .stat-icon {
      width: 36px;
      height: 36px;

      flex: 0 0 36px;

      display: grid;
      place-items: center;

      border-radius: 10px;
    }


    .stat-icon.blue {
      color: #2563eb;
      background: #eff6ff;
    }


    .stat-icon.indigo {
      color: var(--primary);
      background: #eef2ff;
    }


    .stat-icon.green {
      color: var(--green);
      background: #ecfdf5;
    }


    .stat-icon.red {
      color: var(--red);
      background: #fef2f2;
    }


    .stat-card span {
      display: block;

      color: var(--muted);

      font-size: 9px;
    }


    .stat-card strong {
      display: block;

      margin-top: 1px;

      font-size: 17px;

      line-height: 1.2;
    }


    /* CONTENT */

    .content-section {
      margin-top: 50px;
    }


    .section-title {
      display: flex;
      align-items: center;
      gap: 10px;

      margin-bottom: 17px;
    }


    .section-icon {
      width: 40px;
      height: 40px;

      display: grid;
      place-items: center;

      border-radius: 11px;

      color: var(--primary);
      background: #eef2ff;
    }


    .section-title h2 {
      margin: 0;

      font-size: 19px;
      font-weight: 800;
    }


    .section-title p {
      margin: 2px 0 0;

      color: var(--muted);

      font-size: 10px;
    }


    .feature-grid,
    .steps-grid {
      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 13px;
    }


    .feature-card,
    .step-card {
      padding: 18px;

      border: 1px solid var(--border);
      border-radius: 14px;

      background: white;

      transition: 0.2s ease;
    }


    .feature-card:hover,
    .step-card:hover {
      transform: translateY(-2px);

      border-color: #c7d2fe;

      box-shadow:
        0 10px 25px
        rgba(15, 23, 42, 0.06);
    }


    .feature-icon {
      width: 40px;
      height: 40px;

      display: grid;
      place-items: center;

      margin-bottom: 12px;

      border-radius: 10px;

      color: var(--primary);
      background: #eef2ff;
    }


    .feature-card h3,
    .step-card h3 {
      margin: 0 0 5px;

      font-size: 13px;
      font-weight: 800;
    }


    .feature-card p,
    .step-card p {
      margin: 0;

      color: var(--muted);

      font-size: 10px;

      line-height: 1.9;
    }


    .step-card {
      display: flex;
      gap: 11px;
    }


    .step-number {
      width: 32px;
      height: 32px;

      flex: 0 0 32px;

      display: grid;
      place-items: center;

      border-radius: 9px;

      color: white;

      background:
        linear-gradient(
          135deg,
          var(--primary),
          var(--secondary)
        );

      font-size: 12px;
      font-weight: 800;
    }


    /* FAQ */

    .faq-list {
      display: grid;
      gap: 8px;
    }


    .faq-list details {
      overflow: hidden;

      border: 1px solid var(--border);
      border-radius: 12px;

      background: white;
    }


    .faq-list summary {
      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 10px;

      padding: 14px 16px;

      cursor: pointer;

      list-style: none;

      font-size: 11px;
      font-weight: 700;
    }


    .faq-list summary::-webkit-details-marker {
      display: none;
    }


    .faq-list summary i {
      color: var(--muted);

      transition: 0.2s ease;
    }


    .faq-list details[open] summary i {
      transform: rotate(180deg);
    }


    .faq-list details p {
      margin: 0;

      padding: 0 16px 15px;

      color: var(--muted);

      font-size: 10px;

      line-height: 1.9;
    }


    /* DARK */

    @media (prefers-color-scheme: dark) {

      :root {
        --bg: #070b14;
        --surface: #0e1522;
        --surface-soft: #111a2a;

        --text: #e5e7eb;
        --muted: #94a3b8;

        --border: #1e293b;
      }


      .tool-badge {
        color: #a5b4fc;
        background: rgba(79, 70, 229, 0.12);
        border-color: #312e81;
      }


      .tool-heading-icon,
      .section-icon,
      .result-icon {
        background: rgba(79, 70, 229, 0.12);
      }


      .action-bar {
        background: var(--surface-soft);
      }


      .btn-secondary,
      .btn-danger,
      .language-select {
        color: #cbd5e1;
        background: var(--surface);
        border-color: #263449;
      }


      .language-select select {
        color: #cbd5e1;
      }


      .editors-grid {
        background: #090f19;
      }


      .result-card,
      .stat-card,
      .feature-card,
      .step-card,
      .faq-list details {
        background: var(--surface);
      }


      .result-top {
        background: var(--surface-soft);
      }


      .result-status {
        background: #172033;
      }
    }


    /* TABLET */

    @media (max-width: 850px) {

      .editors-grid {
        grid-template-columns: 1fr;
      }


      .feature-grid,
      .steps-grid {
        grid-template-columns: 1fr;
      }


      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }


    /* MOBILE */

    @media (max-width: 600px) {

      .tool-page {
        width: calc(100% - 18px);

        padding-top: 25px;
      }


      .hero {
        align-items: flex-start;

        margin-bottom: 20px;
      }


      .hero-icon {
        width: 54px;
        height: 54px;

        flex: 0 0 54px;

        border-radius: 15px;

        font-size: 21px;
      }


      .tool-badge {
        font-size: 9px;
        padding: 5px 8px;
      }


      .hero h1 {
        margin-top: 7px;

        font-size: 25px;
      }


      .hero p {
        font-size: 10px;
      }


      .tool-top {
        align-items: flex-start;

        flex-direction: column;

        padding: 14px;
      }


      .ready-status {
        width: 100%;
      }


      .action-bar {
        padding: 9px;
      }


      .btn {
        flex: 1 1 calc(50% - 8px);

        min-width: 0;

        padding: 0 7px;

        font-size: 9px;
      }


      .language-select {
        width: 100%;

        margin-right: 0;

        justify-content: center;
      }


      .language-select select {
        flex: 1;
      }


      .editors-grid {
        padding: 9px;

        gap: 9px;
      }


      .code-editor {
        height: 275px;

        grid-template-columns: 40px 1fr;
      }


      .line-numbers {
        font-size: 9px;

        padding: 11px 5px;
      }


      .code-editor textarea {
        padding: 11px;

        font-size: 10px;
      }


      .editor-card-header {
        height: 51px;

        padding: 0 9px;
      }


      .editor-title-icon {
        width: 31px;
        height: 31px;
      }


      .editor-label {
        font-size: 8px;
      }


      .result-card {
        margin: 0 9px 9px;
      }


      .result-top {
        align-items: flex-start;

        flex-direction: column;
      }


      .result-status {
        width: 100%;

        justify-content: center;
      }


      .diff-row {
        grid-template-columns:
          35px
          35px
          27px
          1fr;

        font-size: 9px;
      }


      .diff-row code {
        padding: 5px 7px;
      }


      .stats-grid {
        grid-template-columns: repeat(2, 1fr);

        gap: 7px;

        padding: 0 9px 9px;
      }


      .stat-card {
        padding: 9px;

        gap: 7px;
      }


      .stat-icon {
        width: 31px;
        height: 31px;

        flex-basis: 31px;

        font-size: 10px;
      }


      .stat-card span {
        font-size: 8px;
      }


      .stat-card strong {
        font-size: 15px;
      }


      .content-section {
        margin-top: 38px;
      }


      .section-title h2 {
        font-size: 17px;
      }


      .section-title p {
        font-size: 9px;
      }


      .feature-card,
      .step-card {
        padding: 14px;
      }
    }

  </style>

</body>
</html>
