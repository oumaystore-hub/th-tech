        var(--primary),
        var(--secondary)
      );
      font-size: 13px;
      font-weight: 800;
    }

    .step h3 {
      margin: 0 0 4px;
      font-size: 13px;
      font-weight: 800;
    }

    .step p {
      margin: 0;
      color: var(--muted);
      font-size: 11px;
      line-height: 1.8;
    }


    /* FAQ */

    .faq-list {
      display: grid;
      gap: 9px;
    }

    .faq-list details {
      border: 1px solid var(--border);
      border-radius: 13px;
      background: var(--surface);
      overflow: hidden;
    }

    .faq-list summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 15px 17px;
      cursor: pointer;
      list-style: none;
      font-size: 12px;
      font-weight: 700;
    }

    .faq-list summary::-webkit-details-marker {
      display: none;
    }

    .faq-list summary i {
      color: var(--muted);
      transition: 0.2s ease;
    }

    .faq-list details[open] summary i {
      transform: rotate(180deg);
    }

    .faq-list details p {
      margin: 0;
      padding: 0 17px 16px;
      color: var(--muted);
      font-size: 11px;
      line-height: 1.9;
    }


    /* DARK MODE */

    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #060b14;
        --surface: #0d1522;
        --surface-2: #111b2b;
        --text: #e5e7eb;
        --muted: #94a3b8;
        --border: #1e293b;
      }

      .badge {
        border-color: #1e40af;
        color: #93c5fd;
        background: rgba(37, 99, 235, 0.12);
      }

      .tool-title-icon,
      .section-heading-icon {
        background: rgba(37, 99, 235, 0.12);
      }

      .action-btn,
      .danger-btn,
      .language-box {
        color: #cbd5e1;
        background: #0d1522;
        border-color: #253247;
      }

      .language-box select {
        color: #cbd5e1;
      }

      .editors {
        background: #080e19;
      }

      .result-box,
      .stat-card,
      .info-card,
      .step,
      .faq-list details {
        background: var(--surface);
      }

      .result-header,
      .actionbar {
        background: var(--surface-2);
      }

      .result-state {
        background: #172033;
      }

      .result-icon {
        background: rgba(37, 99, 235, 0.14);
      }

      .original-stat {
        background: #172033;
      }

      .modified-stat {
        background: rgba(37, 99, 235, 0.12);
      }

      .added-stat {
        background: rgba(22, 163, 74, 0.12);
      }

      .removed-stat {
        background: rgba(220, 38, 38, 0.12);
      }
    }


    /* TABLET */

    @media (max-width: 850px) {
      .editors {
        grid-template-columns: 1fr;
      }

      .info-grid,
      .steps {
        grid-template-columns: 1fr;
      }

      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }


    /* MOBILE */

    @media (max-width: 600px) {
      .page {
        width: min(100% - 18px, 1180px);
        padding-top: 24px;
      }

      .hero {
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 17px;
      }

      .hero-icon {
        width: 50px;
        height: 50px;
        flex-basis: 50px;
        border-radius: 14px;
        font-size: 20px;
      }

      .badge {
        font-size: 10px;
        padding: 4px 8px;
      }

      .hero h1 {
        font-size: 25px;
      }

      .hero p {
        font-size: 11px;
        line-height: 1.7;
      }

      .tool-card {
        border-radius: 17px;
      }

      .tool-header {
        align-items: flex-start;
        flex-direction: column;
        padding: 14px;
      }

      .status {
        width: 100%;
      }

      .actionbar {
        padding: 10px;
      }

      .actionbar button {
        flex: 1 1 calc(50% - 8px);
        min-width: 0;
        padding: 0 8px;
        font-size: 10px;
      }

      .language-box {
        width: 100%;
        margin-right: 0;
        justify-content: center;
      }

      .language-box select {
        width: 100%;
      }

      .editors {
        padding: 10px;
        gap: 10px;
      }

      .editor {
        height: 285px;
        grid-template-columns: 42px 1fr;
      }

      .line-numbers {
        padding: 12px 6px;
        font-size: 10px;
      }

      .editor textarea {
        padding: 12px;
        font-size: 11px;
      }

      .editor-header {
        height: 52px;
        padding: 0 10px;
      }

      .editor-name small {
        font-size: 9px;
      }

      .editor-tag {
        font-size: 9px;
      }

      .result-box {
        margin: 0 10px 10px;
      }

      .result-header {
        align-items: flex-start;
        flex-direction: column;
      }

      .result-state {
        width: 100%;
        justify-content: center;
      }

      .diff-row {
        grid-template-columns: 38px 38px 30px 1fr;
        font-size: 10px;
      }

      .diff-row code {
        padding: 5px 8px;
      }

      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 8px;
        padding: 0 10px 10px;
      }

      .stat-card {
        padding: 10px;
      }

      .stat-icon {
        width: 32px;
