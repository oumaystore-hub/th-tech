---
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = "Code Diff - مقارنة الأكواد أونلاين | Th.Tech";
const description =
  "أداة Code Diff مجانية لمقارنة نسختين من الأكواد واكتشاف الأسطر المضافة والمحذوفة والمتغيرة مباشرة من المتصفح.";
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#2563eb" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  />
</head>

<body>

  <Header />

  <main class="page">

    <!-- HERO -->
    <section class="hero">
      <div class="hero-icon">
        <i class="fa-solid fa-code-compare"></i>
      </div>

      <div class="hero-content">
        <div class="badge">
          <i class="fa-solid fa-code-branch"></i>
          Developer Tool #39
        </div>

        <h1>Code Diff</h1>

        <p>
          قارن بين نسختين من الكود واكتشف الأسطر المضافة والمحذوفة
          والمتطابقة بسهولة وسرعة.
        </p>
      </div>
    </section>


    <!-- TOOL -->
    <section class="tool-card">

      <!-- TOOL HEADER -->
      <div class="tool-header">

        <div class="tool-title">
          <div class="tool-title-icon">
            <i class="fa-solid fa-code-compare"></i>
          </div>

          <div>
            <h2>مقارنة الأكواد</h2>
            <span>Original vs Modified</span>
          </div>
        </div>

        <div class="status" id="status">
          <span class="status-dot"></span>
          جاهز للمقارنة
        </div>

      </div>


      <!-- ACTION BAR -->
      <div class="actionbar">

        <button class="primary-btn" id="compareBtn">
          <i class="fa-solid fa-code-compare"></i>
          مقارنة
        </button>

        <button class="action-btn" id="swapBtn">
          <i class="fa-solid fa-arrow-right-arrow-left"></i>
          تبديل
        </button>

        <button class="action-btn" id="copyBtn">
          <i class="fa-solid fa-copy"></i>
          نسخ النتيجة
        </button>

        <button class="danger-btn" id="clearBtn">
          <i class="fa-solid fa-trash"></i>
          مسح
        </button>

        <div class="language-box">
          <i class="fa-solid fa-code"></i>

          <select id="language">
            <option value="auto">تلقائي</option>
            <option value="javascript">JavaScript</option>
            <option value="typescript">TypeScript</option>
            <option value="html">HTML</option>
            <option value="css">CSS</option>
            <option value="json">JSON</option>
            <option value="python">Python</option>
            <option value="sql">SQL</option>
            <option value="php">PHP</option>
            <option value="java">Java</option>
            <option value="cpp">C++</option>
          </select>
        </div>

      </div>


      <!-- EDITORS -->
      <div class="editors">

        <!-- ORIGINAL -->
        <div class="editor-panel original-panel">

          <div class="editor-header">

            <div class="editor-name">
              <span class="editor-icon">
                <i class="fa-solid fa-file-code"></i>
              </span>

              <div>
                <strong>Original</strong>
                <small>الكود الأصلي</small>
              </div>
            </div>

            <span class="editor-tag removed-tag">
              <i class="fa-solid fa-minus"></i>
              Removed
            </span>

          </div>

          <div class="editor">
            <div class="line-numbers" id="oldNumbers">0</div>

            <textarea
              id="oldCode"
              spellcheck="false"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              placeholder="// ضع الكود الأصلي هنا..."
              aria-label="Original code"
            ></textarea>
          </div>

          <div class="editor-footer">
            <span>
              <i class="fa-solid fa-file"></i>
              <span id="oldLineCount">0</span> أسطر
            </span>

            <span>Original</span>
          </div>

        </div>


        <!-- MODIFIED -->
        <div class="editor-panel modified-panel">

          <div class="editor-header">

            <div class="editor-name">
              <span class="editor-icon">
                <i class="fa-solid fa-file-circle-plus"></i>
              </span>

              <div>
                <strong>Modified</strong>
                <small>الكود المعدّل</small>
              </div>
            </div>

            <span class="editor-tag added-tag">
              <i class="fa-solid fa-plus"></i>
              Added
            </span>

          </div>

          <div class="editor">
            <div class="line-numbers" id="newNumbers">0</div>

            <textarea
              id="newCode"
              spellcheck="false"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              placeholder="// ضع الكود المعدّل هنا..."
              aria-label="Modified code"
            ></textarea>
          </div>

          <div class="editor-footer">
            <span>
              <i class="fa-solid fa-file"></i>
              <span id="newLineCount">0</span> أسطر
            </span>

            <span>Modified</span>
          </div>

        </div>

      </div>


      <!-- RESULT -->
      <div class="result-box">

        <div class="result-header">

          <div class="result-title">
            <div class="result-icon">
              <i class="fa-solid fa-code-compare"></i>
            </div>

            <div>
              <h3>نتيجة المقارنة</h3>
              <span id="resultDescription">
                ستظهر الفروقات هنا بعد المقارنة
              </span>
            </div>
          </div>

          <div class="result-state" id="resultState">
            <i class="fa-solid fa-circle-info"></i>
            لم تتم المقارنة
          </div>

        </div>


        <!-- DIFF OUTPUT -->
        <div class="diff-output" id="diffOutput">

          <div class="empty-result">
            <div class="empty-icon">
              <i class="fa-solid fa-code-compare"></i>
            </div>

            <h4>جاهز لمقارنة الأكواد</h4>

            <p>
              أدخل الكود الأصلي والكود المعدّل ثم اضغط على
              <strong>مقارنة</strong>.
            </p>
          </div>

        </div>

      </div>


      <!-- STATS -->
      <div class="stats-grid">

        <div class="stat-card">
          <div class="stat-icon original-stat">
            <i class="fa-solid fa-file-code"></i>
          </div>

          <div>
            <span>الأسطر الأصلية</span>
            <strong id="statOld">0</strong>
          </div>
        </div>


        <div class="stat-card">
          <div class="stat-icon modified-stat">
            <i class="fa-solid fa-file-circle-plus"></i>
          </div>

          <div>
            <span>الأسطر الجديدة</span>
            <strong id="statNew">0</strong>
          </div>
        </div>


        <div class="stat-card">
          <div class="stat-icon added-stat">
            <i class="fa-solid fa-plus"></i>
          </div>

          <div>
            <span>الأسطر المضافة</span>
            <strong id="statAdded">0</strong>
          </div>
        </div>


        <div class="stat-card">
          <div class="stat-icon removed-stat">
            <i class="fa-solid fa-minus"></i>
          </div>

          <div>
            <span>الأسطر المحذوفة</span>
            <strong id="statRemoved">0</strong>
          </div>
        </div>

      </div>

    </section>


    <!-- INFO -->
    <section class="info-section">

      <div class="section-heading">
        <div class="section-heading-icon">
          <i class="fa-solid fa-circle-info"></i>
        </div>

        <div>
          <h2>حول Code Diff</h2>
          <p>قارن الأكواد مباشرة من متصفحك</p>
        </div>
      </div>


      <div class="info-grid">

        <div class="info-card">
          <div class="info-card-icon">
            <i class="fa-solid fa-bolt"></i>
          </div>

          <h3>سريع</h3>

          <p>
            تتم المقارنة محليًا داخل المتصفح دون الحاجة إلى رفع ملفاتك
            إلى خادم خارجي.
          </p>
        </div>


        <div class="info-card">
          <div class="info-card-icon">
            <i class="fa-solid fa-shield-halved"></i>
          </div>

          <h3>خصوصية أفضل</h3>

          <p>
            الكود الذي تضعه في الأداة تتم معالجته محليًا في متصفحك.
          </p>
        </div>


        <div class="info-card">
          <div class="info-card-icon">
            <i class="fa-solid fa-code"></i>
          </div>

          <h3>عدة لغات</h3>

          <p>
            يمكنك استخدامها مع JavaScript وTypeScript وHTML وCSS وJSON
            وغيرها.
          </p>
        </div>

      </div>

    </section>


    <!-- HOW TO -->
    <section class="guide-section">

      <div class="section-heading">
        <div class="section-heading-icon">
          <i class="fa-solid fa-list-check"></i>
        </div>

        <div>
          <h2>كيفية استخدام الأداة</h2>
          <p>ثلاث خطوات بسيطة</p>
        </div>
      </div>


      <div class="steps">

        <div class="step">
          <span class="step-number">1</span>

          <div>
            <h3>أدخل الكود الأصلي</h3>
            <p>
              ضع النسخة القديمة من الكود داخل مربع Original.
            </p>
          </div>
        </div>


        <div class="step">
          <span class="step-number">2</span>

          <div>
            <h3>أدخل الكود المعدّل</h3>
            <p>
              ضع النسخة الجديدة داخل مربع Modified.
            </p>
          </div>
        </div>


        <div class="step">
          <span class="step-number">3</span>

          <div>
            <h3>ابدأ المقارنة</h3>
            <p>
              اضغط على زر مقارنة لرؤية الأسطر المضافة والمحذوفة.
            </p>
          </div>
        </div>

      </div>

    </section>


    <!-- FAQ -->
    <section class="faq-section">

      <div class="section-heading">
        <div class="section-heading-icon">
          <i class="fa-solid fa-circle-question"></i>
        </div>

        <div>
          <h2>الأسئلة الشائعة</h2>
          <p>كل ما تحتاج معرفته</p>
        </div>
      </div>


      <div class="faq-list">

        <details>
          <summary>
            هل يتم إرسال الكود إلى الخادم؟
            <i class="fa-solid fa-chevron-down"></i>
          </summary>

          <p>
            لا. تتم عملية المقارنة داخل متصفحك مباشرة، لذلك لا تحتاج
            الأداة إلى إرسال الكود إلى خادم خارجي.
          </p>
        </details>


        <details>
          <summary>
            ماذا تعني الأسطر الخضراء والحمراء؟
            <i class="fa-solid fa-chevron-down"></i>
          </summary>

          <p>
            الأخضر يمثل الأسطر المضافة في النسخة المعدّلة، بينما الأحمر
            يمثل الأسطر الموجودة في النسخة الأصلية والتي تم حذفها.
          </p>
        </details>


        <details>
          <summary>
            هل يمكن مقارنة JavaScript وTypeScript؟
            <i class="fa-solid fa-chevron-down"></i>
          </summary>

          <p>
            نعم. الأداة تعتمد على مقارنة محتوى الأسطر، ويمكن استخدامها
            مع معظم لغات البرمجة والملفات النصية.
          </p>
        </details>


        <details>
          <summary>
            هل تعمل الأداة على الهاتف؟
            <i class="fa-solid fa-chevron-down"></i>
          </summary>

          <p>
            نعم. الواجهة مصممة للعمل على الهواتف والأجهزة اللوحية
            وأجهزة الكمبيوتر.
          </p>
        </details>

      </div>

    </section>

  </main>

  <Footer />


  <script is:inline>
    const oldCode = document.getElementById("oldCode");
    const newCode = document.getElementById("newCode");

    const oldNumbers = document.getElementById("oldNumbers");
    const newNumbers = document.getElementById("newNumbers");

    const oldLineCount = document.getElementById("oldLineCount");
    const newLineCount = document.getElementById("newLineCount");

    const statOld = document.getElementById("statOld");
    const statNew = document.getElementById("statNew");
    const statAdded = document.getElementById("statAdded");
    const statRemoved = document.getElementById("statRemoved");

    const diffOutput = document.getElementById("diffOutput");

    const status = document.getElementById("status");
    const resultState = document.getElementById("resultState");
    const resultDescription = document.getElementById("resultDescription");

    const compareBtn = document.getElementById("compareBtn");
    const swapBtn = document.getElementById("swapBtn");
    const copyBtn = document.getElementById("copyBtn");
    const clearBtn = document.getElementById("clearBtn");

    function getLines(text) {
      if (!text) return [];
      return text.replace(/\r\n/g, "\n").replace(/\r/g, "\n").split("\n");
    }

    function updateLineNumbers() {
      const oldLines = getLines(oldCode.value);
      const newLines = getLines(newCode.value);

      if (oldLines.length === 0) {
        oldNumbers.textContent = "0";
        oldLineCount.textContent = "0";
      } else {
        oldNumbers.textContent = oldLines
          .map(function (_, index) {
            return String(index + 1);
          })
          .join("\n");

        oldLineCount.textContent = String(oldLines.length);
      }

      if (newLines.length === 0) {
        newNumbers.textContent = "0";
        newLineCount.textContent = "0";
      } else {
        newNumbers.textContent = newLines
          .map(function (_, index) {
            return String(index + 1);
          })
          .join("\n");

        newLineCount.textContent = String(newLines.length);
      }

      statOld.textContent = String(oldLines.length);
      statNew.textContent = String(newLines.length);
    }

    function escapeHtml(value) {
      return value
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function buildDiff(oldLines, newLines) {
      const rows = [];
      const oldLength = oldLines.length;
      const newLength = newLines.length;

      const matrix = [];

      for (let i = 0; i <= oldLength; i++) {
        matrix[i] = new Array(newLength + 1).fill(0);
      }

      for (let i = oldLength - 1; i >= 0; i--) {
        for (let j = newLength - 1; j >= 0; j--) {
          if (oldLines[i] === newLines[j]) {
            matrix[i][j] = matrix[i + 1][j + 1] + 1;
          } else {
            matrix[i][j] = Math.max(
              matrix[i + 1][j],
              matrix[i][j + 1]
            );
          }
        }
      }

      let i = 0;
      let j = 0;

      while (i < oldLength && j < newLength) {
        if (oldLines[i] === newLines[j]) {
          rows.push({
            type: "same",
            oldLine: i + 1,
            newLine: j + 1,
            text: oldLines[i]
          });

          i++;
          j++;
        } else if (matrix[i + 1][j] >= matrix[i][j + 1]) {
          rows.push({
            type: "removed",
            oldLine: i + 1,
            newLine: "",
            text: oldLines[i]
          });

          i++;
        } else {
          rows.push({
            type: "added",
            oldLine: "",
            newLine: j + 1,
            text: newLines[j]
          });

          j++;
        }
      }

      while (i < oldLength) {
        rows.push({
          type: "removed",
          oldLine: i + 1,
          newLine: "",
          text: oldLines[i]
        });

        i++;
      }

      while (j < newLength) {
        rows.push({
          type: "added",
          oldLine: "",
          newLine: j + 1,
          text: newLines[j]
        });

        j++;
      }

      return rows;
    }

    function renderDiff(rows) {
      if (rows.length === 0) {
        return `
          <div class="empty-result">
            <div class="empty-icon">
              <i class="fa-solid fa-code-compare"></i>
            </div>
            <h4>لا توجد بيانات للمقارنة</h4>
            <p>أدخل الكود في المربعين ثم حاول مرة أخرى.</p>
          </div>
        `;
      }

      let html = "";

      rows.forEach(function (row) {
        let icon = "";
        let className = "";

        if (row.type === "added") {
          icon = "+";
          className = "diff-added";
        } else if (row.type === "removed") {
          icon = "-";
          className = "diff-removed";
        } else {
          icon = "=";
          className = "diff-same";
        }

        html += `
          <div class="diff-row ${className}">
            <span class="diff-line old-line">${row.oldLine}</span>
            <span class="diff-line new-line">${row.newLine}</span>
            <span class="diff-symbol">${icon}</span>
            <code>${escapeHtml(row.text)}</code>
          </div>
        `;
      });

      return html;
    }

    function compareCodes() {
      const oldLines = getLines(oldCode.value);
      const newLines = getLines(newCode.value);

      if (oldLines.length === 0 && newLines.length === 0) {
        status.innerHTML =
          '<span class="status-dot"></span> أدخل الكود أولاً';

        resultState.innerHTML =
          '<i class="fa-solid fa-circle-exclamation"></i> لا توجد بيانات';

        resultDescription.textContent =
          "أدخل الكود الأصلي والكود المعدّل للمقارنة.";

        diffOutput.innerHTML = `
          <div class="empty-result">
            <div class="empty-icon warning">
              <i class="fa-solid fa-file-code"></i>
            </div>
            <h4>لا توجد أكواد للمقارنة</h4>
            <p>أدخل الكود في أحد المربعين أو كليهما.</p>
          </div>
        `;

        statOld.textContent = "0";
        statNew.textContent = "0";
        statAdded.textContent = "0";
        statRemoved.textContent = "0";

        return;
      }

      const rows = buildDiff(oldLines, newLines);

      let added = 0;
      let removed = 0;
      let same = 0;

      rows.forEach(function (row) {
        if (row.type === "added") added++;
        if (row.type === "removed") removed++;
        if (row.type === "same") same++;
      });

      statOld.textContent = String(oldLines.length);
      statNew.textContent = String(newLines.length);
      statAdded.textContent = String(added);
      statRemoved.textContent = String(removed);

      diffOutput.innerHTML = renderDiff(rows);

      if (added === 0 && removed === 0) {
        status.innerHTML =
          '<span class="status-dot success"></span> الأكواد متطابقة';

        resultState.innerHTML =
          '<i class="fa-solid fa-check"></i> متطابق';

        resultDescription.textContent =
          "لم يتم العثور على اختلافات بين النسختين.";
      } else {
        status.innerHTML =
          '<span class="status-dot changed"></span> تم العثور على اختلافات';

        resultState.innerHTML =
          '<i class="fa-solid fa-code-branch"></i> مختلف';

        resultDescription.textContent =
          added + " أسطر مضافة و " + removed + " أسطر محذوفة.";
      }
    }

    function swapEditors() {
      const temp = oldCode.value;
      oldCode.value = newCode.value;
      newCode.value = temp;

      updateLineNumbers();
      compareCodes();
    }

    async function copyResult() {
      const rows = diffOutput.querySelectorAll(".diff-row");

      if (!rows.length) {
        status.innerHTML =
          '<span class="status-dot"></span> لا توجد نتيجة لنسخها';

        return;
      }

      let text = "";

      rows.forEach(function (row) {
        const symbol = row.querySelector(".diff-symbol");
        const code = row.querySelector("code");

        if (symbol && code) {
          text += symbol.textContent + " " + code.textContent + "\n";
        }
      });

      try {
        await navigator.clipboard.writeText(text);

        status.innerHTML =
          '<span class="status-dot success"></span> تم نسخ النتيجة';

        setTimeout(function () {
          status.innerHTML =
            '<span class="status-dot"></span> جاهز للمقارنة';
        }, 1800);
      } catch (error) {
        status.innerHTML =
          '<span class="status-dot"></span> تعذر نسخ النتيجة';
      }
    }

    function clearAll() {
      oldCode.value = "";
      newCode.value = "";

      updateLineNumbers();

      diffOutput.innerHTML = `
        <div class="empty-result">
          <div class="empty-icon">
            <i class="fa-solid fa-code-compare"></i>
          </div>
          <h4>جاهز لمقارنة الأكواد</h4>
          <p>
            أدخل الكود الأصلي والكود المعدّل ثم اضغط على
            <strong>مقارنة</strong>.
          </p>
        </div>
      `;

      statOld.textContent = "0";
      statNew.textContent = "0";
      statAdded.textContent = "0";
      statRemoved.textContent = "0";

      resultState.innerHTML =
        '<i class="fa-solid fa-circle-info"></i> لم تتم المقارنة';

      resultDescription.textContent =
        "ستظهر الفروقات هنا بعد المقارنة";

      status.innerHTML =
        '<span class="status-dot"></span> جاهز للمقارنة';
    }

    function enableTab(textarea) {
      textarea.addEventListener("keydown", function (event) {
        if (event.key !== "Tab") return;

        event.preventDefault();

        const start = textarea.selectionStart;
        const end = textarea.selectionEnd;

        textarea.value =
          textarea.value.substring(0, start) +
          "  " +
          textarea.value.substring(end);

        textarea.selectionStart = start + 2;
        textarea.selectionEnd = start + 2;

        updateLineNumbers();
      });
    }

    function syncScroll(source, target) {
      source.addEventListener("scroll", function () {
        target.scrollTop = source.scrollTop;
      });
    }

    oldCode.addEventListener("input", updateLineNumbers);
    newCode.addEventListener("input", updateLineNumbers);

    oldCode.addEventListener("input", function () {
      status.innerHTML =
        '<span class="status-dot"></span> تم تعديل الكود الأصلي';
    });

    newCode.addEventListener("input", function () {
      status.innerHTML =
        '<span class="status-dot"></span> تم تعديل الكود الجديد';
    });

    compareBtn.addEventListener("click", compareCodes);
    swapBtn.addEventListener("click", swapEditors);
    copyBtn.addEventListener("click", copyResult);
    clearBtn.addEventListener("click", clearAll);

    enableTab(oldCode);
    enableTab(newCode);

    syncScroll(oldCode, oldNumbers);
    syncScroll(newCode, newNumbers);

    updateLineNumbers();
  </script>


  <style>
    :root {
      --primary: #2563eb;
      --primary-dark: #1d4ed8;
      --secondary: #4f46e5;
      --accent: #60a5fa;

      --bg: #f6f8fc;
      --surface: #ffffff;
      --surface-2: #f8fafc;

      --text: #111827;
      --muted: #64748b;
      --border: #e2e8f0;

      --editor: #0b1220;
      --editor-2: #111827;
      --editor-text: #dbeafe;

      --green: #16a34a;
      --green-bg: #ecfdf3;

      --red: #dc2626;
      --red-bg: #fef2f2;

      --shadow:
        0 16px 45px rgba(15, 23, 42, 0.08);

      --radius: 18px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family: "Cairo", sans-serif;
      background: var(--bg);
      color: var(--text);
    }

    button,
    select,
    textarea {
      font-family: inherit;
    }

    .page {
      width: min(1180px, calc(100% - 30px));
      margin: 0 auto;
      padding: 38px 0 70px;
    }


    /* HERO */

    .hero {
      display: flex;
      align-items: center;
      gap: 18px;
      margin-bottom: 22px;
    }

    .hero-icon {
      width: 62px;
      height: 62px;
      flex: 0 0 62px;
      display: grid;
      place-items: center;
      border-radius: 18px;
      color: #fff;
      font-size: 26px;
      background:
        linear-gradient(135deg, var(--primary), var(--secondary));
      box-shadow:
        0 12px 25px rgba(37, 99, 235, 0.22);
    }

    .hero-content {
      min-width: 0;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 5px 11px;
      border: 1px solid #bfdbfe;
      border-radius: 999px;
      color: var(--primary-dark);
      background: #eff6ff;
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 6px;
    }

    .hero h1 {
      margin: 0;
      font-size: clamp(27px, 4vw, 38px);
      line-height: 1.2;
      font-weight: 800;
      letter-spacing: -0.5px;
    }

    .hero p {
      margin: 7px 0 0;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.8;
    }


    /* TOOL CARD */

    .tool-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 22px;
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .tool-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      padding: 18px 20px;
      border-bottom: 1px solid var(--border);
    }

    .tool-title {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .tool-title-icon {
      width: 43px;
      height: 43px;
      display: grid;
      place-items: center;
      border-radius: 13px;
      color: var(--primary);
      background: #eff6ff;
      font-size: 18px;
    }

    .tool-title h2 {
      margin: 0;
      font-size: 17px;
      font-weight: 800;
    }

    .tool-title span {
      display: block;
      color: var(--muted);
      font-size: 11px;
      margin-top: 1px;
      direction: ltr;
      text-align: right;
    }

    .status {
      display: flex;
      align-items: center;
      gap: 7px;
      color: var(--muted);
      font-size: 12px;
      font-weight: 600;
      white-space: nowrap;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #94a3b8;
    }

    .status-dot.success {
      background: var(--green);
    }

    .status-dot.changed {
      background: #f59e0b;
    }


    /* ACTION BAR */

    .actionbar {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      padding: 13px 16px;
      background: var(--surface-2);
      border-bottom: 1px solid var(--border);
    }

    .actionbar button {
      height: 38px;
      border-radius: 10px;
      padding: 0 13px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      border: 1px solid var(--border);
      cursor: pointer;
      font-size: 12px;
      font-weight: 700;
      transition: 0.2s ease;
    }

    .actionbar button:hover {
      transform: translateY(-1px);
    }

    .primary-btn {
      color: #fff;
      border-color: var(--primary) !important;
      background: var(--primary);
      box-shadow: 0 6px 14px rgba(37, 99, 235, 0.18);
    }

    .primary-btn:hover {
      background: var(--primary-dark);
    }

    .action-btn {
      color: #334155;
      background: #fff;
    }

    .action-btn:hover {
      color: var(--primary);
      border-color: #bfdbfe !important;
    }

    .danger-btn {
      color: var(--red);
      background: #fff;
    }

    .danger-btn:hover {
      border-color: #fecaca !important;
      background: #fff5f5;
    }

    .language-box {
      margin-right: auto;
      height: 38px;
      display: flex;
      align-items: center;
      gap: 7px;
      padding: 0 10px;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: #fff;
      color: var(--muted);
    }

    .language-box select {
      border: 0;
      outline: 0;
      background: transparent;
      color: #334155;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
    }


    /* EDITORS */

    .editors {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      padding: 16px;
      background: #eef2f7;
    }

    .editor-panel {
      overflow: hidden;
      border: 1px solid #dbe3ed;
      border-radius: 15px;
      background: var(--editor);
    }

    .editor-header {
      height: 58px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 0 13px;
      background: var(--editor-2);
      border-bottom: 1px solid #253247;
    }

    .editor-name {
      display: flex;
      align-items: center;
      gap: 9px;
      min-width: 0;
    }

    .editor-icon {
      width: 34px;
      height: 34px;
      display: grid;
      place-items: center;
      border-radius: 9px;
      font-size: 14px;
    }

    .original-panel .editor-icon {
      color: #fca5a5;
      background: rgba(220, 38, 38, 0.14);
    }

    .modified-panel .editor-icon {
      color: #86efac;
      background: rgba(22, 163, 74, 0.14);
    }

    .editor-name strong {
      display: block;
      color: #f8fafc;
      font-size: 13px;
      direction: ltr;
      text-align: right;
    }

    .editor-name small {
      display: block;
      color: #94a3b8;
      font-size: 10px;
      margin-top: 1px;
    }

    .editor-tag {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 8px;
      border-radius: 7px;
      font-size: 10px;
      font-weight: 800;
      direction: ltr;
    }

    .removed-tag {
      color: #fca5a5;
      background: rgba(220, 38, 38, 0.12);
    }

    .added-tag {
      color: #86efac;
      background: rgba(22, 163, 74, 0.12);
    }

    .editor {
      height: 350px;
      display: grid;
      grid-template-columns: 54px 1fr;
      direction: ltr;
      overflow: hidden;
    }

    .line-numbers {
      padding: 14px 9px;
      overflow: hidden;
      color: #475569;
      background: #080e19;
      border-right: 1px solid #1e293b;
      font-family: "Courier New", monospace;
      font-size: 12px;
      line-height: 1.65;
      text-align: right;
      white-space: pre;
      user-select: none;
    }

    .editor textarea {
      width: 100%;
      height: 100%;
      resize: none;
      outline: 0;
      border: 0;
      padding: 14px 16px;
      color: var(--editor-text);
      background: var(--editor);
      font-family: "Courier New", Consolas, monospace;
      font-size: 13px;
      line-height: 1.65;
      tab-size: 2;
      direction: ltr;
      text-align: left;
      white-space: pre;
      overflow: auto;
    }

    .editor textarea::placeholder {
      color: #475569;
    }

    .editor textarea:focus {
      box-shadow: inset 0 0 0 1px rgba(96, 165, 250, 0.35);
    }

    .editor-footer {
      height: 34px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 12px;
      color: #64748b;
      background: #080e19;
      border-top: 1px solid #1e293b;
      font-family: "Cairo", sans-serif;
      font-size: 10px;
    }

    .editor-footer span {
      display: flex;
      align-items: center;
      gap: 5px;
    }


    /* RESULT */

    .result-box {
      margin: 0 16px 16px;
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 15px;
      background: #fff;
    }

    .result-header {
      min-height: 66px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 11px 14px;
      border-bottom: 1px solid var(--border);
      background: var(--surface-2);
    }

    .result-title {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .result-icon {
      width: 37px;
      height: 37px;
      display: grid;
      place-items: center;
      border-radius: 10px;
      color: var(--primary);
      background: #dbeafe;
